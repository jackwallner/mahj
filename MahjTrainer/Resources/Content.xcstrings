            "state": "translated",
            "value": "Va con los tres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il circule entre les trois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpindah-pindah di antara ketiganya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó thuộc cả ba"
          }
        }
      }
    },
    "It has a second job": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er hat eine zweite Aufgabe"
          }
        },
        "es": {
