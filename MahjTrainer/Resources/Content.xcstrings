    "Never safe: a 6 fits too many hands": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie sicher: Eine 6 passt zu zu vielen Händen"
          }
        },
        "es": {
