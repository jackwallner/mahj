    "A Like Numbers line is printed with 1s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeile für gleiche Zahlen zeigt 1er."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea de Números iguales está impresa con 1."
          }
        },
        "fr": {
          "stringUnit": {
