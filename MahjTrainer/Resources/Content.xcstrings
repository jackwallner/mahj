    },
    "Only after the next discard lands": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst nach dem nächsten Abwurf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
