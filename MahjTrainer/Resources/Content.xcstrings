    "Keep It If a Line Uses It": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten, wenn eine Zeile ihn nutzt"
          }
        },
        "es": {
