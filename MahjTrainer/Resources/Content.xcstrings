          }
        }
      }
    },
    "Craks are the suit their exposures are built in, so a Crak is the riskiest suit to throw against them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Crak ist die Farbe, in der seine Auslagen gebaut sind, ein Crak ist also der riskanteste Abwurf gegen ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Crak son el palo en que están hechas sus exposiciones, así que un Crak es el palo más arriesgado para tirarle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Crak sont la famille dans laquelle ses expositions sont bâties : un Crak est donc la famille la plus risquée à jeter contre lui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Crak adalah jenis tempat ekspos mereka dibangun, jadi Crak adalah jenis paling berisiko untuk dibuang terhadap mereka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Crak là chất quân lộ của họ xây, nên Crak là chất rủi ro nhất để bỏ với họ."
          }
        }
      }
    },
    "Craks only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
