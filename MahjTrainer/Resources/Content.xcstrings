          "stringUnit": {
            "state": "translated",
            "value": "Nur beim Blindpass"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en el pase a ciegas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement à la passe à l'aveugle"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya di operan buta"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ở lượt chuyền mù"
          }
        }
      }
    },
    "Only on their own turn, and only by handing over a 7 Crak.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in seinem eigenen Zug, und nur indem er eine 7 Crak abgibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en su propio turno, y solo entregando un 7 Crak."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement à son propre tour, et seulement en donnant un 7 Crak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya di giliran mereka sendiri, dan hanya dengan menyerahkan 7 Crak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ vào lượt của họ, và chỉ bằng cách đưa ra quân 7 Crak."
          }
        }
      }
    },
    "Only on your own draw": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur bei eigenem Ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si lo robas tú"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement sur votre propre pioche"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dari ambilanmu sendiri"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khi tự bốc"
          }
        }
      }
    },
    "Only on your own turn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in deinem eigenen Zug"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo en tu propio turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement à votre propre tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya di giliranmu sendiri"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ vào lượt của bạn"
          }
        }
      }
    },
    "Only safe if you are East": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur sicher, wenn du Ost bist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo es seguro si eres Este"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sûre seulement si vous êtes Est"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya aman jika kamu duduk di posisi Timur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ an toàn nếu bạn là Đông"
          }
        }
      }
    },
    "Only sixteen winds and twelve dragons exist in the whole set, so honors dry up quickly. If nobody is discarding them, somebody else is collecting them too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im ganzen Set gibt es nur sechzehn Winde und zwölf Drachen, Ehrensteine werden also schnell knapp. Wirft sie niemand ab, sammelt sie jemand anderes auch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo existen dieciséis vientos y doce dragones en todo el juego, así que los honores se agotan rápido. Si nadie los descarta, alguien más los está juntando también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'existe que seize vents et douze dragons dans tout le jeu, les honneurs s'épuisent donc vite. Si personne ne les défausse, quelqu'un d'autre les collectionne aussi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya ada enam belas angin dan dua belas naga di seluruh set, jadi ubin kehormatan cepat habis. Kalau tidak ada yang membuangnya, berarti orang lain juga mengumpulkannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả bộ chỉ có mười sáu gió và mười hai rồng, nên quân danh dự cạn rất nhanh. Nếu không ai bỏ chúng, thì có người khác cũng đang gom."
          }
        }
      }
    },
    "Only the discarder pays": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Abwerfende zahlt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo paga quien descartó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le joueur qui a défaussé paie"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pembuang yang membayar"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người đánh bỏ phải trả tiền"
          }
        }
      }
    },
    "Only the last player to discard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der letzte Spieler, der abgeworfen hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el último jugador que descartó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement le dernier joueur à avoir défaussé"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pemain terakhir yang membuang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người bỏ bài cuối cùng"
          }
        }
      }
    },
    "Only the latest discard can ever be called, and these went by long ago.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der letzte Abwurf kann noch gerufen werden, und diese Abwürfe liegen schon lange zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede cantar el último descarte, y estos pasaron hace mucho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la défausse la plus récente peut être réclamée ; les précédentes sont passées depuis longtemps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya buangan terbaru yang bisa diambil, dan buangan-buangan ini sudah lama berlalu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quân bỏ mới nhất mới có thể được hô, còn những quân này đã bị bỏ từ lâu."
          }
        }
      }
    },
    "Only the most recent discard can be called. Once play moves on, an earlier tile stays in the pile for the rest of the hand. That is why old discards tell you a lot about what the table does not want.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der letzte Abwurf kann gerufen werden. Läuft das Spiel weiter, bleibt ein früherer Stein für den Rest der Hand im Abwurfstapel. Deshalb verraten alte Abwürfe viel darüber, was die Spieler nicht wollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede cantar el descarte más reciente. Cuando el juego avanza, una ficha anterior se queda en el montón el resto de la mano. Por eso los descartes antiguos te dicen mucho sobre lo que la mesa no quiere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la défausse la plus récente peut être réclamée. Dès que le jeu avance, une défausse précédente reste dans la pile jusqu'à la fin de la manche. C'est pourquoi les anciennes défausses vous renseignent sur ce que les joueurs ne veulent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya buangan terbaru yang bisa diambil. Begitu permainan berlanjut, ubin sebelumnya tetap di tumpukan sampai tangan selesai. Karena itu, buangan lama memberi banyak petunjuk tentang ubin yang tidak diminati para pemain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ quân bỏ gần nhất mới có thể được hô. Khi ván tiếp diễn, quân bỏ trước đó sẽ nằm trong đống bỏ đến hết ván. Vì vậy, các quân bỏ cũ cho bạn biết nhiều về những quân người chơi không cần."
          }
        }
      }
    },
    "Only the player on their left": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Spieler links von ihm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el jugador a su izquierda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement le joueur à sa gauche"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pemain di kirinya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người bên trái họ"
          }
        }
      }
    },
    "Only to complete an exposure you can show, or to declare mah jongg": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur um eine Auslage zu vollenden, die du zeigen kannst, oder um Mah Jongg zu erklären"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para completar una exposición que puedas mostrar, o para declarar mah jongg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement pour compléter un groupe que vous pouvez exposer ou annoncer mah jongg"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk melengkapi kelompok yang bisa kamu buka atau untuk menyatakan mah jongg"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ để hoàn thành một nhóm có thể bày ra, hoặc để báo mah jongg"
          }
        }
      }
    },
    "Only with a joker in it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit einem Joker darin"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si lleva un comodín"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement si le groupe contient un joker"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dengan joker di dalamnya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ khi có joker trong đó"
          }
        }
      }
    },
    "Only with a pung": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur mit einem Pung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo con un pung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement avec un pung"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya dengan pung"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ với pung"
          }
        }
      }
    },
    "Pair": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paire"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đôi"
          }
        }
      }
    },
    "Pair = 2 identical tiles. Pung = 3. Kong = 4. Quint = 5 (only possible with jokers, since only four of each tile exist). Card hands are built from these blocks plus singles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paar = 2 gleiche Steine. Pung = 3. Kong = 4. Quint = 5 (nur mit Jokern möglich, da es von jedem Stein nur vier gibt). Kartenhände bestehen aus diesen Bausteinen plus Einzelsteinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareja = 2 fichas idénticas. Pung = 3. Kong = 4. Quint = 5 (solo posible con comodines, porque solo hay cuatro de cada ficha). Las manos de la tarjeta se arman con estos bloques más fichas sueltas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paire = 2 tuiles identiques. Pung = 3. Kong = 4. Quint = 5 (possible seulement avec des jokers, puisqu'il n'existe que quatre exemplaires de chaque tuile). Les mains de la carte sont bâties avec ces briques plus des tuiles isolées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangan = 2 ubin identik. Pung = 3. Kong = 4. Quint = 5 (hanya mungkin dengan joker, karena setiap jenis ubin hanya ada empat). Tangan pada kartu tersusun dari kelompok-kelompok ini dan ubin tunggal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đôi = 2 quân giống nhau. Pung = 3. Kong = 4. Quint = 5 (chỉ có thể với joker, vì mỗi loại quân chỉ có bốn quân). Các bộ bài trên thẻ được ghép từ những nhóm cơ bản này và các quân đơn."
          }
        }
      }
    },
    "Pairs are never exposed during play. They go down only with mah jongg.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paare werden im Spiel nie ausgelegt. Sie kommen nur mit Mah Jongg auf den Tisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las parejas nunca se exponen durante el juego. Solo se muestran al declarar mah jongg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paires ne sont jamais exposées pendant le jeu. Elles ne sont posées que pour mah jongg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangan tidak pernah dibuka selama permainan. Pasangan baru diletakkan saat mah jongg."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đôi không được bày ra trong lúc chơi, chỉ được hạ xuống khi báo mah jongg."
          }
        }
      }
    },
    "Pairs cannot be called for during play. Only mah jongg unlocks that.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paare können im Spiel nicht gerufen werden. Nur Mah Jongg macht das möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las parejas no se pueden cantar durante el juego. Solo el mah jongg lo permite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paires ne peuvent pas être réclamées pendant le jeu. Seule l'annonce de mah jongg le permet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangan tidak bisa dipanggil selama permainan. Hanya mah jongg yang membukanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong lúc chơi, không thể hô quân bỏ để hoàn thành đôi; chỉ có thể hô quân đó khi nó giúp bạn thắng mah jongg."
          }
        }
      }
    },
    "Pairs of 2s, 6s and 8s with a pung of 4 Bams: this rack is 2468. The 3 Crak and 9 Bam are odd and the North is a lone wind, so none of them fits the evens plan. Keep the flower, which many hands use.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paare aus 2ern, 6ern und 8ern sowie ein Pung aus 4 Bam: Dieses Rack ist 2468. Die 3 Crak und die 9 Bam sind ungerade, und der Nord ist ein einzelner Wind, keiner der drei passt also zum geraden Plan. Behalte die Blume, die viele Hände nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parejas de 2, 6 y 8 con un pung de 4 Bam: este atril es 2468. El 3 Crak y el 9 Bam son impares y el Norte es un viento suelto, así que ninguno encaja en el plan de pares. Guarda la flor, que muchas manos usan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des paires de 2, 6 et 8 avec un pung de 4 Bam : ce chevalet évoque la section 2468. Le 3 Crak et le 9 Bam sont impairs, et le Nord est un vent isolé : aucun ne convient au plan des nombres pairs. Gardez la fleur, que beaucoup de mains utilisent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasangan 2, 6, dan 8 dengan pung 4 Bam: rak ini 2468. 3 Crak dan 9 Bam ganjil, sedangkan ubin Utara tidak punya pasangan, jadi tidak satu pun cocok dengan pola angka genap. Simpan bunganya, yang dipakai banyak tangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đôi 2, 6 và 8 cùng pung 4 Bam tạo thành hướng 2468. 3 Crak và 9 Bam là số lẻ, còn quân Bắc là quân gió đơn lẻ, nên cả ba đều không hợp hướng chẵn. Giữ hoa vì nhiều bộ bài cần đến."
          }
        }
      }
    },
    "Pass a joker to speed things up?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Joker abgeben, um Tempo zu machen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Pasas un comodín para acelerar las cosas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer un joker pour accélérer ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operkan joker untuk mempercepat?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyền một joker cho nhanh?"
          }
        }
      }
    },
    "Pass by family: when the rack is odd, the even tiles leave first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Zahlenfamilie weitergeben: Wenn dein Rack auf ungerade Zahlen setzt, gib zuerst die geraden Steine weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué pasar según la familia: cuando el atril apunta a los impares, pasa primero las fichas pares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez par famille : quand votre chevalet est orienté vers les nombres impairs, commencez par les tuiles paires."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operkan berdasarkan pola angka: kalau rakmu didominasi ubin ganjil, ubin genap dioperkan lebih dulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyền theo nhóm bài: nếu bài đang theo hướng số lẻ, hãy chuyền các quân chẵn trước."
          }
        }
      }
    },
    "Pass one": {
