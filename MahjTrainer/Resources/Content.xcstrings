    "Mostly evens, no pairs yet. First pass.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist gerade, noch keine Paare. Erster Pass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predominan los números pares, aún no hay parejas. Primer pase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surtout des pairs, pas encore de paires. Première passe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebanyakan genap, belum ada pasangan. Operan pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần lớn là chẵn, chưa có đôi. Lượt chuyền đầu."
          }
        }
      }
    },
    "N E W S + dragons": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "N E W S + Drachen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "N E W S + dragones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N E O S + dragons"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NEWS + naga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắc, Đông, Tây, Nam + rồng"
          }
        }
      }
    },
    "NEWS means one North, one East, one West and one South, four single tiles. Jokers never fill a single, so every wind has to be the real tile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NEWS steht für je einen Nord-, Ost-, West- und Südwind, also vier einzelne Steine. Joker ersetzen nie einen Einzelstein, deshalb muss jeder Wind ein echter Stein sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NEWS significa un Norte, un Este, un Oeste y un Sur: cuatro fichas sueltas. Los comodines nunca completan una ficha suelta, así que cada viento debe ser la ficha natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NEOS signifie un Nord, un Est, un Ouest et un Sud, soit quatre tuiles isolées. Les jokers ne remplacent jamais une tuile isolée : chaque vent doit donc être une tuile naturelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NEWS berarti satu Utara, satu Timur, satu Barat, dan satu Selatan, empat ubin tunggal. Joker tidak pernah mengisi ubin tunggal, jadi setiap angin harus berupa ubin asli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NEWS tương ứng với Bắc, Đông, Tây và Nam, mỗi hướng một quân, tức bốn quân đơn. Joker không thể thay cho quân đơn, nên mỗi quân gió phải là quân thật."
          }
        }
      }
    },
    "Neither, it is dead": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner, er ist tot"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno, está muerta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun des deux, elle est morte"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak satu pun, ubinnya sudah mati"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai, vì quân đó đã chết."
          }
        }
