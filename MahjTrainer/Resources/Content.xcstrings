          }
        }
      }
    },
    "The one who called first": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der, der zuerst gerufen hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El que cantó primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui a appelé en premier"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang memanggil lebih dulu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người hô trước"
          }
        }
      }
    },
    "The one whose turn comes next": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der, der als Nächstes dran ist"
          }
        },
        "es": {
