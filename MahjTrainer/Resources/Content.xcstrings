        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memegang dua 5 Crak"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có hai quân 5 Crak"
          }
        }
      }
    },
    "You just drew the fourth 6 Dot, and your hand does not need it. Keep or throw?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade die vierte 6 Dot gezogen, und deine Hand braucht sie nicht. Behalten oder abwerfen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de robar el cuarto 6 Dot y tu mano no lo necesita. ¿Lo guardas o lo tiras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de piocher le quatrième 6 Dot, et votre main n'en a pas besoin. Le garder ou le jeter ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu baru mengambil 6 Dot keempat, dan tanganmu tidak membutuhkannya. Simpan atau buang?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa bốc quân 6 Dot thứ tư, và bộ bài của bạn không cần. Giữ hay bỏ?"
          }
        }
      }
    },
    "You just drew the real 6 Bam. Now what?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade die echte 6 Bam gezogen. Und jetzt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de robar el 6 Bam real. ¿Y ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de piocher le vrai 6 Bam. Et maintenant ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu baru saja mengambil 6 Bam yang asli. Lalu bagaimana?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa bốc được quân 6 Bam thật. Giờ làm gì?"
          }
        }
      }
    },
    "You lose a turn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du setzt einen Zug aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdes un turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous perdez un tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu kehilangan satu giliran"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn mất một lượt"
          }
        }
      }
    },
    "You may call until the next player has drawn a tile and put it on their rack. After that, the discard is gone. Speak up quickly.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst rufen, bis der nächste Spieler einen Stein gezogen und auf sein Rack gelegt hat. Danach ist der Abwurf weg. Sprich also schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cantar hasta que el siguiente jugador haya robado una ficha y la haya puesto en su atril. Después, el descarte ya no está disponible. Habla rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez appeler jusqu'à ce que le joueur suivant ait pioché une tuile et l'ait posée sur son chevalet. Après cela, la défausse est perdue. Parlez vite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu boleh memanggil sampai pemain berikutnya mengambil ubin dan menaruhnya di rak. Setelah itu, buangan sudah lewat. Cepatlah bicara."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể hô cho đến khi người kế tiếp đã bốc một quân và đặt lên giá. Sau đó quân bỏ không còn nữa. Hãy lên tiếng nhanh."
          }
        }
      }
    },
    "You must pass three tiles. Which ones?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst drei Steine abgeben. Welche?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes pasar tres fichas. ¿Cuáles?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez passer trois tuiles. Lesquelles ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu harus mengoperkan tiga ubin. Yang mana?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn phải chuyền ba quân. Chọn quân nào?"
          }
        }
      }
    },
    "You need a pung of 5 Bams.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst einen Pung 5 Bam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas un pung de 5 Bam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous faut un pung de 5 Bam."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu butuh pung 5 Bam."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cần một pung 5 Bam."
          }
        }
      }
    },
    "You need one tile to complete a PAIR and it gets discarded. Can you call it?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir fehlt ein Stein, um ein PAAR zu vollenden, und er wird abgeworfen. Kannst du ihn rufen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas una ficha para completar una PAREJA y la descartan. ¿Puedes cantarla?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous faut une tuile pour compléter une PAIRE et elle est défaussée. Pouvez-vous l'appeler ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu butuh satu ubin untuk melengkapi PASANGAN dan ubin itu dibuang. Bisakah kamu memanggilnya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cần một quân để hoàn thành ĐÔI và nó bị bỏ. Bạn có hô được không?"
          }
        }
      }
    },
    "You need the same number across different suits, and only four of each exist. Losing one suit usually means losing the hand, so count what has been discarded before you commit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du brauchst dieselbe Zahl in verschiedenen Farben, und von jeder gibt es nur vier. Eine Farbe zu verlieren heißt meist, die Hand zu verlieren, also zähl den Abwurf, bevor du dich festlegst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitas el mismo número en distintos palos, y solo existen cuatro de cada uno. Perder un palo suele significar perder la mano, así que cuenta lo que se ha descartado antes de comprometerte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous faut le même chiffre dans différentes familles, et il n'en existe que quatre de chaque. Perdre une famille signifie souvent perdre la main : comptez donc ce qui a été défaussé avant de vous engager."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu butuh angka yang sama di jenis berbeda, dan hanya ada empat untuk tiap angka. Kehilangan satu jenis biasanya berarti kehilangan tangan, jadi hitung apa yang sudah dibuang sebelum berkomitmen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cần cùng một số ở các chất khác nhau, mà mỗi số chỉ có bốn quân. Mất một chất thường là mất bộ bài, nên hãy đếm những gì đã bị bỏ trước khi chốt."
          }
        }
      }
    },
    "You pay double": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du zahlst doppelt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagas el doble"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez le double"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membayar dua kali lipat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn trả gấp đôi"
          }
        }
      }
    },
    "You show them once, then hide them": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du zeigst sie einmal, dann verdeckst du sie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las muestras una vez y luego las ocultas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous les montrez une fois, puis vous les cachez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menunjukkannya sekali, lalu menyembunyikannya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cho xem một lần rồi giấu đi"
          }
        }
      }
    },
    "You skip your next turn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du setzt deinen nächsten Zug aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierdes tu próximo turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous passez votre prochain tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu melewatkan giliran berikutnya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn mất lượt kế tiếp"
          }
        }
      }
    },
    "You swap it for a joker": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tauschst ihn gegen einen Joker"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo cambias por un comodín"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l'échangez contre un joker"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menukarnya dengan joker"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đổi nó lấy joker"
          }
        }
      }
    },
    "You win on a tile you drew from the wall yourself. Who pays?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gewinnst mit einem Stein, den du selbst von der Mauer gezogen hast. Wer zahlt?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganas con una ficha que robaste tú mismo del muro. ¿Quién paga?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gagnez avec une tuile piochée vous-même dans le mur. Qui paie ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menang dengan ubin yang kamu ambil sendiri dari dinding. Siapa yang membayar?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thắng bằng quân tự bốc từ tường. Ai trả?"
          }
        }
      }
    },
    "You win on another player's discard. Who pays what?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gewinnst mit dem Abwurf eines anderen. Wer zahlt wie viel?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganas con el descarte de otro jugador. ¿Quién paga qué?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gagnez sur la défausse d'un autre joueur. Qui paie quoi ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menang dari buangan pemain lain. Siapa membayar berapa?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thắng bằng quân bỏ của người khác. Ai trả bao nhiêu?"
          }
        }
      }
    },
    "You win with a hand outside Singles and Pairs, and it has no jokers. What changes?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gewinnst mit einer Hand außerhalb von Singles & Paare, und sie hat keine Joker. Was ändert sich?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganas con una mano que no es de Sueltas y Parejas y no tiene comodines. ¿Qué cambia?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gagnez avec une main hors Simples et Paires, sans aucun joker. Qu'est-ce qui change ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu menang dengan tangan di luar Tunggal dan Pasangan, tanpa joker. Apa yang berubah?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thắng bằng bộ bài ngoài Đơn & Đôi, và không có joker. Điều gì thay đổi?"
          }
        }
      }
    },
    "You're building 2468 in craks and dots.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du baust 2468 in Crak und Dot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás armando 2468 en Crak y Dot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous construisez 2468 en Crak et en Dot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sedang menyusun 2468 dalam Crak dan Dot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang xây 2468 ở Crak và Dot."
          }
        }
      }
    },
    "You're committed to Singles & Pairs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du spielst auf Singles & Paare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te has comprometido con Sueltas y Parejas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes engagé dans Simples et Paires."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu berkomitmen pada Tunggal & Pasangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chốt Đơn & Đôi."
          }
        }
      }
    },
    "You're ready to train": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bereit zu trainieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya puedes entrenar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt à vous entraîner"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu siap berlatih"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẵn sàng luyện tập"
          }
        }
      }
    },
    "Your deal leans odd. First pass, three tiles to the right.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Blatt neigt zu ungerade. Erster Pass, drei Steine nach rechts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reparto se inclina a los impares. Primer pase, tres fichas a la derecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre donne penche vers les impairs. Première passe, trois tuiles à droite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembagianmu condong ganjil. Operan pertama, tiga ubin ke kanan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài của bạn nghiêng về số lẻ. Lượt chuyền đầu, ba quân sang phải."
          }
        }
      }
    },
    "Your discards never have to match anything. Any tile you do not want can go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Abwürfe müssen nie zu etwas passen. Jeder Stein, den du nicht willst, darf weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus descartes nunca tienen que coincidir con nada. Cualquier ficha que no quieras puede salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos défausses n'ont jamais à correspondre à quoi que ce soit. Toute tuile dont vous ne voulez pas peut partir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buanganmu tidak harus cocok dengan apa pun. Ubin mana pun yang tidak kamu inginkan boleh dibuang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân bỏ của bạn không bao giờ phải khớp gì. Quân nào bạn không muốn đều bỏ được."
          }
        }
      }
    },
    "Your final pass is a defensive tool. Feed a neighbor the kind of tile they have hinted they do not want.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein letzter Pass ist ein Verteidigungswerkzeug. Gib einem Nachbarn die Art Stein, die er angedeutet hat, nicht zu wollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pase final es una herramienta defensiva. Dale a un vecino el tipo de ficha que ha dado a entender que no quiere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dernière passe est un outil défensif. Donnez à un voisin le genre de tuile dont il a laissé entendre qu'il ne veut pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operan terakhirmu adalah alat bertahan. Beri tetangga jenis ubin yang mereka isyaratkan tidak mereka inginkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt chuyền cuối của bạn là công cụ phòng thủ. Hãy đưa hàng xóm loại quân mà họ đã ngầm cho thấy họ không muốn."
          }
        }
      }
    },
    "Your hand cannot win, so drawing toward it gains nothing, and the risky tiles still have to go somewhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand kann nicht gewinnen, auf sie zu ziehen bringt also nichts, und die riskanten Steine müssen trotzdem irgendwohin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano no puede ganar, así que robar hacia ella no aporta nada, y las fichas arriesgadas igual tienen que ir a algún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main ne peut pas gagner : piocher vers elle ne rapporte rien, et les tuiles risquées doivent bien aller quelque part."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu tidak bisa menang, jadi mengambil menuju ke sana tidak ada gunanya, dan ubin berisiko tetap harus dibuang ke suatu tempat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn không thể thắng, nên bốc theo nó chẳng được gì, và quân rủi ro vẫn phải đi đâu đó."
          }
        }
      }
    },
    "Your hand is built on numbers, and nobody has exposed a wind. Keep or throw?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand baut auf Zahlen, und niemand hat einen Wind ausgelegt. Behalten oder abwerfen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano se basa en números y nadie ha expuesto un viento. ¿La guardas o la tiras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main est bâtie sur les chiffres, et personne n'a exposé de vent. Le garder ou le jeter ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu dibangun dari angka, dan belum ada yang mengekspos angin. Simpan atau buang?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn xây trên số, và chưa ai để lộ gió. Giữ hay bỏ?"
          }
        }
      }
    },
    "Your hand is concealed (marked C) and someone throws your winning tile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand ist verdeckt (mit C markiert) und jemand wirft deinen Gewinnstein ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano es oculta (marcada con C) y alguien tira tu ficha ganadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main est cachée (marquée C) et quelqu'un jette votre tuile gagnante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu tertutup (bertanda C) dan seseorang membuang ubin kemenanganmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn kín (đánh dấu C) và có người bỏ quân thắng của bạn."
          }
        }
      }
    },
    "Your hand is dead, and the other three play on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand ist tot, und die anderen drei spielen weiter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano queda muerta y los otros tres siguen jugando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main est morte, et les trois autres continuent"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu mati, dan tiga lainnya lanjut main"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn chết, ba người kia chơi tiếp"
          }
        }
      }
    },
    "Your hand is going 2468. Keep or throw?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand geht auf 2468. Behalten oder abwerfen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano va por 2468. ¿La guardas o la tiras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main va vers 2468. Le garder ou le jeter ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu menuju 2468. Simpan atau buang?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn đang theo 2468. Giữ hay bỏ?"
          }
        }
      }
    },
    "Your hand is going nowhere, but you hold a joker.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand kommt nicht voran, aber du hältst einen Joker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano no va a ninguna parte, pero tienes un comodín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main ne mène nulle part, mais vous avez un joker."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu tidak ke mana-mana, tapi kamu memegang joker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn chẳng đi đến đâu, nhưng bạn có một joker."
          }
        }
      }
    },
    "Your hand is hopeless, and an opponent is one tile away from mah jongg on an obvious hand. What is the right play?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand ist hoffnungslos, und ein Gegner ist mit einer offensichtlichen Hand einen Stein von Mah Jongg entfernt. Was ist das richtige Spiel?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano no tiene salvación y un oponente está a una ficha del mah jongg con una mano evidente. ¿Cuál es la jugada correcta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main est sans espoir, et un adversaire est à une tuile de mah jongg avec une main évidente. Quel est le bon coup ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu tanpa harapan, dan lawan tinggal satu ubin dari mah jongg dengan tangan yang jelas. Apa langkah yang tepat?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn vô vọng, và một đối thủ còn một quân nữa là mah jongg với một bộ bài lộ rõ. Nước đi đúng là gì?"
          }
        }
      }
    },
    "Your hand looks hopeless and you hold three jokers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand sieht hoffnungslos aus und du hältst drei Joker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano parece perdida y tienes tres comodines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main semble sans espoir et vous avez trois jokers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu tampak tanpa harapan dan kamu memegang tiga joker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn trông vô vọng và bạn có ba joker."
          }
        }
      }
    },
    "Your hand needs four flowers and you hold three. Can a joker be the fourth?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand braucht vier Blumen und du hältst drei. Kann ein Joker die vierte sein?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano necesita cuatro flores y tienes tres. ¿Puede un comodín ser la cuarta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main a besoin de quatre fleurs et vous en avez trois. Un joker peut-il être la quatrième ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu butuh empat bunga dan kamu punya tiga. Bisakah joker menjadi yang keempat?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn cần bốn hoa và bạn có ba. Joker có thể là quân thứ tư không?"
          }
        }
      }
    },
    "Your hand needs one more single tile to win. Can a joker finish it?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deiner Hand fehlt noch ein einzelner Stein zum Gewinn. Kann ein Joker ihn vollenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A tu mano le falta una ficha suelta para ganar. ¿Puede un comodín completarla?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque une seule tuile isolée à votre main pour gagner. Un joker peut-il la compléter ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu butuh satu ubin tunggal lagi untuk menang. Bisakah joker menyelesaikannya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn cần thêm một quân lẻ để thắng. Joker có hoàn thành được không?"
          }
        }
      }
    },
    "Your hand spells 2026 with one tile per digit. Can a joker stand in for one of them?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand schreibt 2026 mit je einem Stein pro Ziffer. Kann ein Joker eine davon ersetzen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano forma 2026 con una ficha por dígito. ¿Puede un comodín sustituir a uno de ellos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main épelle 2026 avec une tuile par chiffre. Un joker peut-il remplacer l'un d'eux ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu membentuk 2026 dengan satu ubin per angka. Bisakah joker menggantikan salah satunya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn viết 2026 với mỗi chữ số một quân. Joker có thay được một chữ số không?"
          }
        }
      }
    },
    "Your hand went dead earlier, and another player wins. Do you pay?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hand war schon tot, und ein anderer Spieler gewinnt. Zahlst du?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu mano quedó muerta antes y otro jugador gana. ¿Pagas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre main est morte depuis un moment et un autre joueur gagne. Payez-vous ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanganmu sudah mati lebih awal, dan pemain lain menang. Apakah kamu membayar?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài của bạn đã chết từ trước, và người khác thắng. Bạn có phải trả không?"
          }
        }
      }
    },
    "Your left opponent calls a tile, exposes a pung, and then discards a 2 Dot. What does that suggest?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein linker Gegner ruft einen Stein, legt einen Pung aus und wirft dann eine 2 Dot ab. Was legt das nahe?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu oponente de la izquierda canta una ficha, expone un pung y luego descarta un 2 Dot. ¿Qué sugiere eso?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre adversaire de gauche appelle une tuile, expose un pung, puis défausse un 2 Dot. Qu'est-ce que cela suggère ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan di kirimu memanggil ubin, mengekspos pung, lalu membuang 2 Dot. Apa yang diisyaratkan itu?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối thủ bên trái hô một quân, để lộ pung, rồi bỏ một 2 Dot. Điều đó gợi ý gì?"
          }
        }
      }
    },
    "Your left opponent exposes a pung of 4 Dots.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein linker Gegner legt einen Pung 4 Dot aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu oponente de la izquierda expone un pung de 4 Dot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre adversaire de gauche expose un pung de 4 Dot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lawan di kirimu mengekspos pung 4 Dot."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối thủ bên trái của bạn để lộ một pung 4 Dot."
          }
        }
      }
    },
    "Your other option: a concealed hand you are 2 tiles from. Call it?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine andere Option: eine verdeckte Hand, der 2 Steine fehlen. Rufen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu otra opción: una mano oculta a la que le faltan 2 fichas. ¿Cantas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre autre option : une main cachée à 2 tuiles de la fin. L'appeler ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan lainmu: tangan tertutup yang tinggal 2 ubin lagi. Panggil?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn khác: một bộ bài kín bạn còn thiếu 2 quân. Hô không?"
          }
        }
      }
    },
    "Your own exposed pung of 8 Craks holds a joker.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem eigenen ausgelegten Pung 8 Crak steckt ein Joker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propio pung expuesto de 8 Crak tiene un comodín."
          }
        },
        "fr": {
          "stringUnit": {
