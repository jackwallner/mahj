          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách các bộ bài thắng"
          }
        }
      }
    },
    "The mah jongg caller": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mah-Jongg-Rufer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien canta mah jongg"
          }
        },
        "fr": {
          "stringUnit": {
