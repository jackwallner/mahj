    "A Like Numbers line is printed with 1s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile mit gleichen Zahlen ist mit 1ern gedruckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea de Números iguales está impresa con 1."
          }
        },
        "fr": {
          "stringUnit": {
