    "The Green Dragon belongs with which suit?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu welcher Farbe gehört der Grüne Drache?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Con qué palo va el Dragón Verde?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dragon Vert appartient à quelle famille ?"
          }
        },
        "id": {
          "stringUnit": {
