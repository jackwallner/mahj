        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un 7 est impair : il ne correspond donc pas à une main paire que cette table pourrait laisser entrevoir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka 7 ganjil, jadi tidak cocok dengan pola genap yang mungkin terlihat di meja ini."
