    },
    "Winds and Dragons": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Winde & Drachen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vientos y Dragones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vents et Dragons"
          }
        },
        "id": {
          "stringUnit": {
