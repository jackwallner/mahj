          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có"
          }
        }
      }
    },
    "None, it is truly impossible": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner, es ist wirklich unmöglich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno, es realmente imposible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun, c'est vraiment impossible"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada, benar-benar mustahil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không, hoàn toàn không thể"
          }
        }
      }
    },
    "North": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nord"
          }
        },
        "es": {
          "stringUnit": {
