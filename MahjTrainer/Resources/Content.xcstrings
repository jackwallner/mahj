    "Dragons and winds are both honors. A rack full of them wants Winds & Dragons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drachen und Winde sind beide Ehrensteine. Ein Rack voller Ehrensteine spricht für Winde & Drachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dragones y los vientos son honores. Un atril lleno de ellos apunta a una mano de Vientos y Dragones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dragons et les vents sont tous des honneurs. Un chevalet qui en regorge fait penser à la section Vents et Dragons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naga dan angin sama-sama termasuk ubin kehormatan. Rak yang penuh dengan keduanya mengarah ke bagian Angin & Naga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rồng và gió đều là quân chữ. Giá bài đầy quân chữ thường hợp với Gió & Rồng."
          }
        }
      }
    },
    "Dragons required": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drachen nötig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requieren dragones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des dragons obligatoires"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naga wajib"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt buộc có rồng"
          }
        }
      }
    },
    "Draw and hope your own hand comes together": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen und hoffen, dass deine Hand aufgeht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar y esperar que tu propia mano se complete"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher et espérer que votre main se complète"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil ubin sambil berharap susunan tanganmu terbentuk"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốc quân và hy vọng bộ bài của bạn dần thành hình"
          }
        }
      }
    },
    "Draw from the wall, then discard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Mauer ziehen, dann abwerfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar del muro y luego descartar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher dans le mur, puis défausser"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil dari dinding, lalu buang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốc từ tường bài rồi bỏ một quân"
          }
        }
      }
    },
    "Drawing toward your own hand anyway": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem auf deine eigene Hand ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir robando para completar tu propia mano de todas formas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher quand même vers votre main"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap mengambil ubin untuk menyusun tanganmu sendiri"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn bốc theo hướng bộ bài của mình"
          }
        }
      }
    },
    "During the first round": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der ersten Runde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la primera ronda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le premier tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di putaran pertama"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong vòng đầu tiên"
          }
        }
      }
    },
    "Each hand on the card is marked X or C. What does C mean?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Hand auf der Karte ist mit X oder C markiert. Was bedeutet C?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mano de la tarjeta está marcada con X o C. ¿Qué significa C?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque main de la carte est marquée X ou C. Que signifie C ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tangan di kartu bertanda X atau C. Apa arti C?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bộ bài trên thẻ được đánh dấu X hoặc C. C nghĩa là gì?"
          }
        }
      }
    },
    "Early in the game, you must throw a flower or a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh im Spiel musst du eine Blume oder einen einzelnen Wind abwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al principio de la partida, debes tirar una flor o un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début de la partie, vous devez jeter une fleur ou un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di awal permainan, kamu harus membuang bunga atau ubin angin tunggal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ván, bạn phải bỏ một hoa hoặc một quân gió lẻ."
          }
        }
      }
    },
    "Early in the hand, nobody has exposed anything. Which discard is safest?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh in der Hand hat niemand etwas ausgelegt. Welcher Abwurf ist am sichersten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al principio de la mano, nadie ha expuesto nada. ¿Qué descarte es el más seguro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début de la manche, personne n'a rien exposé. Quelle défausse est la plus sûre ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di awal tangan, belum ada yang mengekspos apa pun. Buangan mana yang paling aman?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ván, chưa ai để lộ gì. Quân bỏ nào an toàn nhất?"
          }
        }
      }
    },
    "Early in the hand, you hold N N and draw a third North.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh in der Hand hältst du N N und ziehst einen dritten Nord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al principio de la mano, tienes N N y robas un tercer Norte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début de la manche, vous avez N N et vous piochez un troisième Nord."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di awal tangan, kamu memegang U U dan mengambil Utara ketiga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ván, bạn có hai quân Bắc và bốc được quân Bắc thứ ba."
          }
        }
      }
    },
    "Early passes are about narrowing, not deciding. Keep the majority and let the Charleston tell you the rest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei den ersten Pässen geht es ums Eingrenzen, nicht ums Entscheiden. Behalte die Mehrheit und lass dir vom Charleston den Rest zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros pases sirven para acotar, no para decidir. Quédate con la mayoría y deja que el Charleston te ayude a decidir lo demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les premières passes servent à réduire les options, pas à décider. Gardez la plupart des tuiles qui vous conviennent et laissez le Charleston vous guider pour le reste."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operan awal bertujuan mempersempit pilihan, bukan menentukan tangan. Pertahankan sebagian besar ubin yang cocok, lalu biarkan Charleston memberi petunjuk sisanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lượt chuyền đầu giúp thu hẹp lựa chọn, chứ chưa cần quyết định. Hãy giữ lại nhóm quân chiếm đa số và để Charleston giúp bạn chọn tiếp."
          }
        }
      }
    },
    "East": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Est"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đông"
          }
        }
      }
    },
    "Eight": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám"
          }
        }
      }
    },
    "Eight 1s, spread over all three suits. When one number turns up in every suit like this, Like Numbers is the read. The 4 Dot is the one number that does not fit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 1er, über alle drei Farben verteilt. Taucht dieselbe Zahl in jeder Farbe auf, spricht das für die Hand „Gleiche Zahlen“. Die 4 Dot passt als einzige Zahl nicht dazu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas del 1 repartidas en los tres palos. Cuando el mismo número aparece en los tres palos, como aquí, la mano apunta a Números iguales. El 4 Dot es el único número que no encaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles 1 réparties dans les trois familles. Quand un même chiffre apparaît dans chaque famille, cela évoque la section Nombres identiques. Le 4 Dot est le seul chiffre qui ne cadre pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 1, tersebar di ketiga jenis. Kalau satu angka muncul di setiap jenis seperti ini, bacaannya Angka Sama. 4 Dot adalah satu-satunya angka yang tidak cocok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 1, rải ở cả ba chất. Khi một số xuất hiện ở mọi chất như vậy, đây là Số giống nhau. 4 Dot là quân số duy nhất không hợp."
          }
        }
      }
    },
    "Eight 2s across the three suits. When a rack is mostly one number in every suit, Like Numbers is the read. The 9 Dot is the one number that does not fit, and the North is a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 2er in den drei Farben. Wenn ein Rack überwiegend dieselbe Zahl in allen Farben zeigt, spricht das für die Hand „Gleiche Zahlen“. Die 9 Dot passt als einzige Zahl nicht dazu, und der Nord ist ein einzelner Wind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas del 2 en los tres palos. Cuando un atril tiene sobre todo fichas del mismo número repartidas en los tres palos, apunta a Números iguales. El 9 Dot es el único número que no encaja, y el Norte es un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles 2 réparties dans les trois familles. Quand un chevalet contient surtout le même chiffre dans chaque famille, on pense à la section Nombres identiques. Le 9 Dot est le seul chiffre qui ne cadre pas, et le Nord est un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 2 di ketiga jenis. Kalau rak didominasi satu angka di setiap jenis, bacaannya Angka Sama. 9 Dot adalah satu-satunya ubin yang tidak cocok, dan ubin Utara adalah angin tunggal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 2 ở ba chất. Khi giá phần lớn là một số ở mọi chất, đây là Số giống nhau. 9 Dot là quân số duy nhất không hợp, và quân Bắc là gió lẻ."
          }
        }
      }
    },
    "Eight 4s in three suits. Like Numbers is built on one number repeated across suits, and this rack is mostly one number. The 7 Crak, the Red Dragon and the West Wind are the strays.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 4er in drei Farben. Die Hand „Gleiche Zahlen“ basiert auf derselben Zahl in mehreren Farben, und dieses Rack besteht überwiegend aus 4ern. Die 7 Crak, der Rote Drache und der West sind die Ausreißer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas del 4 en tres palos. La mano de Números iguales se basa en repetir un mismo número en varios palos, y en este atril casi todas las fichas son de ese número. El 7 Crak, el Dragón Rojo y el Viento del Oeste son las fichas que sobran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles 4 dans trois familles. La section Nombres identiques repose sur la répétition d'un même chiffre d'une famille à l'autre, et le chevalet contient surtout des 4. Le 7 Crak, le Dragon Rouge et le vent d'Ouest sont les tuiles isolées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 4 di tiga jenis. Angka Sama dibangun dari satu angka yang diulang di berbagai jenis, dan rak ini kebanyakan satu angka. 7 Crak, Naga Merah, dan Angin Barat adalah ubin nyasar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 4 ở ba chất. Số giống nhau được xây trên một số lặp lại qua các chất, và giá này phần lớn là một số. 7 Crak, Rồng Đỏ và gió Tây là quân lạc loài."
          }
        }
      }
    },
    "Eight 8s spread across all three suits, with a joker to help. That is the Like Numbers shape. The 3 Bam and 5 Dot are the numbers that do not fit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 8er in allen drei Farben, dazu ein Joker. Das ist die typische Form der Hand „Gleiche Zahlen“. Die 3 Bam und die 5 Dot passen nicht dazu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas del 8 repartidas en los tres palos, con un comodín de ayuda. Esa es la estructura de una mano de Números iguales. El 3 Bam y el 5 Dot son los números que no encajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles 8 réparties dans les trois familles, avec un joker pour aider. C'est la configuration typique de la section Nombres identiques. Le 3 Bam et le 5 Dot sont les chiffres qui ne cadrent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 8 tersebar di ketiga jenis, ditambah satu joker. Itulah pola Angka Sama. 3 Bam dan 5 Dot adalah angka yang tidak cocok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 8 rải ở cả ba chất, có một joker hỗ trợ. Đó là hình dạng của Số giống nhau. 3 Bam và 5 Dot là hai quân số không hợp."
          }
        }
      }
    },
    "Eight 9s across Craks, Bams and Dots. One number filling every suit is the Like Numbers shape. The 4 Crak is the one number that does not fit, and the North is a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 9er in Crak, Bam und Dot. Eine Zahl in allen drei Farben ist typisch für die Hand „Gleiche Zahlen“. Die 4 Crak passt als einzige Zahl nicht dazu, und der Nord ist ein einzelner Wind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas del 9 en Crak, Bam y Dot. Repetir el mismo número en todos los palos es el patrón de Números iguales. El 4 Crak es el único número que no encaja, y el Norte es un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles 9 en Crak, Bam et Dot. Quand un même chiffre apparaît dans chaque famille, c'est la configuration typique de la section Nombres identiques. Le 4 Crak est le seul chiffre qui ne cadre pas, et le Nord est un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 9 di Crak, Bam, dan Dot. Satu angka yang muncul di setiap jenis membentuk pola Angka Sama. 4 Crak adalah satu-satunya angka yang tidak cocok, dan ubin Utara adalah angin tunggal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 9 ở Crak, Bam và Dot. Một số xuất hiện ở mọi chất là kiểu bài Số giống nhau. 4 Crak là quân số duy nhất không hợp, và quân Bắc là gió lẻ."
          }
        }
      }
    },
    "Eight evens across all three suits is a real 2468 spine. The two lonely winds do almost nothing for 2468, and the 3 Dot is your only odd number tile. Those three leave without a second thought.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht gerade Steine in allen drei Farben bilden ein gutes Grundgerüst für 2468. Die zwei einsamen Winde bringen 2468 fast nichts, und die 3 Dot ist dein einziger ungerader Zahlenstein. Diese drei kannst du ohne langes Überlegen abgeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas con números pares repartidas entre los tres palos forman una buena base para 2468. Los dos vientos solitarios casi no sirven a 2468, y el 3 Dot es tu única ficha numérica impar. Esas tres se van sin pensarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles paires réparties dans les trois familles forment une solide ossature 2468. Les deux vents isolés n'aident presque pas 2468, et le 3 Dot est votre seule tuile impaire. Passez ces trois tuiles sans hésiter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan ubin genap dari ketiga jenis membentuk dasar pola 2468. Dua ubin angin tunggal hampir tidak berguna untuk 2468, dan 3 Dot adalah satu-satunya ubin angka ganjilmu. Operkan ketiganya tanpa ragu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân chẵn ở cả ba chất tạo nên nền tảng vững chắc cho bài 2468. Hai quân gió lẻ gần như không giúp gì cho 2468, còn 3 Dot là quân số lẻ duy nhất. Bỏ cả ba, khỏi cần nghĩ."
          }
        }
      }
    },
    "Eight fives across all three suits. When one number fills your rack like this, Any Like Numbers is the read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 5er in allen drei Farben. Wenn eine Zahl dein Rack so füllt, spricht das für die Hand „Gleiche Zahlen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho cincos en los tres palos. Cuando un mismo número llena tu atril así, la lectura es Números iguales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles 5 dans les trois familles. Quand un seul chiffre remplit ainsi votre chevalet, cela évoque la section Nombres identiques."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka lima di ketiga jenis. Kalau satu angka memenuhi rakmu seperti ini, bacaannya Angka Sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 5 ở cả ba chất. Khi một số chiếm đầy giá như vậy, đây là Số giống nhau."
          }
        }
      }
    },
    "Eight flower tiles come in the set, and for card purposes any flower can stand in for any other. They are never part of a numbered run. Wherever the card shows an F, any flower works.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Blumensteine gehören zum Set, und für die Karte kann jede Blume jede andere ersetzen. Sie sind nie Teil einer Zahlenfolge. Wo die Karte ein F zeigt, passt jede Blume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego trae ocho flores, y a efectos de la tarjeta cualquier flor puede sustituir a cualquier otra. Nunca forman parte de una escalera numérica. Donde la tarjeta muestra una F, vale cualquier flor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu contient huit fleurs, et pour la carte, n'importe quelle fleur peut remplacer n'importe quelle autre. Elles ne font jamais partie d'une suite numérotée. Partout où la carte montre un F, n'importe quelle fleur convient."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Set berisi delapan ubin bunga, dan untuk keperluan kartu, bunga mana pun bisa menggantikan bunga lainnya. Bunga tidak pernah menjadi bagian dari urutan angka. Di mana pun kartu menampilkan F, bunga apa pun bisa digunakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ có tám quân hoa, và theo quy định trên thẻ, hoa nào cũng có thể thay cho hoa khác. Hoa không bao giờ thuộc dãy số. Chỗ nào trên thẻ ghi F thì dùng hoa nào cũng được."
          }
        }
      }
    },
    "Eight flowers, and unlike suited tiles they are all interchangeable with each other.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anders als Farbsteine sind Blumen untereinander austauschbar. Es gibt acht davon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho flores, y a diferencia de las fichas de palo, todas son intercambiables entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu compte huit fleurs. Contrairement aux tuiles des trois familles, elles sont toutes interchangeables."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan bunga dalam satu set bisa saling menggantikan, tidak seperti ubin angka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có tám quân hoa, và khác với quân thuộc các chất, hoa nào cũng có thể thay cho hoa khác."
          }
        }
      }
    },
    "Eight jokers, and counting them helps. If you've seen 6 on racks and discards, only 2 are left in play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt acht Joker, und Mitzählen hilft. Wenn du sechs auf den Racks und unter den abgelegten Steinen gesehen hast, sind nur noch zwei im Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay ocho comodines y conviene contarlos. Si has visto 6 en atriles y descartes, solo quedan 2 en juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu compte huit jokers, et il est utile de les compter. Si vous en avez vu 6 sur les chevalets et dans les défausses, il n'en reste que 2 en jeu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan joker, dan menghitungnya berguna. Kalau kamu sudah melihat 6 di rak dan buangan, hanya 2 yang tersisa dalam permainan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ có tám joker, nên việc đếm chúng rất hữu ích. Nếu bạn đã thấy 6 quân trên giá bài và trong đống bỏ, chỉ còn 2 quân trong ván."
          }
        }
      }
    },
    "Eight odd tiles and a pair of 5 Craks: this is a 13579 hand. The even Dots (2, 4, 6) are the passes. Do NOT ship the flowers to make the choice easier. Many sections want flowers, and passing one hands a neighbor a tile your own hand may need later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht ungerade Steine und ein Paar 5 Crak: Das ist eine 13579-Hand. Die geraden Dots (2, 4, 6) sind die Abgaben. Gib NICHT die Blumen ab, nur um dir die Wahl leichter zu machen. Viele Sektionen brauchen Blumen, und wenn du eine weitergibst, bekommt ein Nachbar einen Stein, den deine Hand später vielleicht braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas impares y una pareja de 5 Crak: esta es una mano 13579. Las fichas pares de Dot (2, 4 y 6) son las que debes pasar. NO pases las flores para decidir con más facilidad. Muchas secciones las necesitan, y pasar una flor le da a un vecino una ficha que quizá necesites más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles impaires et une paire de 5 Crak : c'est une main 13579. Les tuiles paires de la famille Dot (2, 4, 6) sont celles qu'il faut passer. Ne passez PAS les fleurs pour vous faciliter le choix. Beaucoup de sections veulent des fleurs, et en passer une donne à un voisin une tuile dont votre main pourrait avoir besoin plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan ubin ganjil dan sepasang 5 Crak: ini tangan 13579. Dot genap (2, 4, 6) yang dioperkan. JANGAN operkan bunga demi mempermudah pilihan. Banyak bagian menginginkan bunga, dan mengoperkannya memberi tetangga ubin yang mungkin dibutuhkan tanganmu nanti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân lẻ và một đôi 5 Crak: đây là bộ 13579. Các Dot chẵn (2, 4, 6) là quân để chuyền. ĐỪNG chuyền hoa cho dễ chọn. Nhiều nhóm cần hoa, và chuyền một quân là trao cho hàng xóm quân mà bộ bài của bạn có thể cần sau này."
          }
        }
      }
    },
    "Eight odd tiles with two pairs already: this hand wants 13579. The three even Dots serve nothing you are building, so they go together on the very first pass, before anyone has committed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht ungerade Steine mit bereits zwei Paaren: Das spricht für 13579. Die drei geraden Dots helfen keiner Hand, die du aufbaust, also gib sie gleich im ersten Pass zusammen ab, bevor sich jemand festlegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas impares y dos parejas: esta mano apunta a 13579. Las tres fichas pares de Dot no sirven para la mano que estás formando, así que pásalas juntas en el primer pase, antes de que nadie se haya comprometido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles impaires dont deux paires : cette main vise 13579. Les trois tuiles paires de la famille Dot n'ont pas leur place dans cette main : passez-les ensemble dès la première passe, avant que quiconque ne se soit engagé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan ubin ganjil dengan dua pasangan: ini tangan 13579. Tiga Dot genap tidak cocok dengan pola yang sedang kamu susun, jadi operkan ketiganya pada operan pertama, sebelum siapa pun menentukan pilihan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bài này có tám quân lẻ và đã có sẵn hai đôi: đây là hướng 13579. Ba quân Dot chẵn không giúp gì cho bài bạn đang xây, nên chuyền cả ba ngay lượt đầu, trước khi ai chốt hướng."
          }
        }
      }
    },
    "Eight wild tiles. A joker can stand in for a tile inside a group of three or more (a pung, kong or quint). It can never be a pair, a single, or part of a Singles and Pairs hand, and it can never be passed in the Charleston.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Joker. Ein Joker kann in einer Gruppe aus drei oder mehr Steinen (Pung, Kong oder Quint) einen Stein ersetzen. Er kann weder ein Paar noch ein Einzelstein sein und ist in einer Hand aus Einzelsteinen und Paaren nicht erlaubt. Im Charleston darf er nie weitergegeben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho comodines. Un comodín puede sustituir a una ficha dentro de un grupo de tres o más (pung, kong o quint). Nunca puede formar una pareja ni ser una ficha suelta, ni formar parte de una mano de Sueltas y Parejas, y nunca se puede pasar en el Charleston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit jokers. Un joker peut remplacer une tuile dans un groupe de trois ou plus (un pung, un kong ou un quint). Il ne peut jamais faire partie d'une paire, être utilisé seul ou entrer dans une main Simples et Paires, et il ne peut jamais être passé au Charleston."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan joker. Joker bisa mewakili ubin dalam kelompok tiga atau lebih (pung, kong, atau quint). Joker tidak bisa menjadi pasangan, ubin tunggal, atau bagian dari tangan Tunggal dan Pasangan, dan tidak boleh dioperkan saat Charleston."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có tám joker. Joker có thể thay cho một quân trong nhóm từ ba quân trở lên (pung, kong hoặc quint). Joker không thể ghép đôi, đứng riêng hoặc dùng trong bài Đơn & Đôi, và không bao giờ được chuyền trong Charleston."
          }
        }
      }
    },
    "Eight winds including a pung of Norths, plus two dragons, and only one number tile in the whole rack. The read is Winds & Dragons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Winde mit einem Pung Nord, dazu zwei Drachen und nur ein Zahlenstein im ganzen Rack. Das Blatt ist Winde & Drachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho vientos, incluido un pung de Nortes, más dos dragones y una sola ficha numérica en todo el atril. La lectura es Vientos y Dragones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit vents dont un pung de Nord, plus deux dragons, et une seule tuile chiffrée sur tout le chevalet. Tout indique la section Vents et Dragons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angin termasuk pung Utara, ditambah dua naga, dan hanya satu ubin angka di seluruh rak. Bacaannya Angin & Naga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân gió gồm một pung Bắc, thêm hai quân rồng, và cả bài chỉ có một quân số. Đây là hướng Gió & Rồng."
          }
        }
      }
    },
    "Eight winds, a pung of Easts, and three dragons, with not one number tile on the rack. Any section built on numbers would be starting from nothing. Winds and Dragons it is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Winde, ein Pung Ost und drei Drachen, aber kein einziger Zahlenstein auf dem Rack. Jede Sektion mit Zahlen würde bei null anfangen. Also Winde & Drachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho vientos, un pung de Estes y tres dragones, sin una sola ficha numérica en el atril. Cualquier sección basada en números partiría de cero. Se trata de Vientos y Dragones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit vents, un pung d'Est et trois dragons, sans une seule tuile chiffrée sur le chevalet. Toute section fondée sur les chiffres partirait de zéro. C'est donc la section Vents et Dragons qu'il faut viser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angin, pung Timur, dan tiga naga, tanpa satu pun ubin angka di rak. Bagian berbasis angka mana pun akan mulai dari nol. Jadi, pilih Angin & Naga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân gió, một pung Đông và ba quân rồng, không có quân số nào trong bài. Mọi nhóm dựa trên số đều phải bắt đầu từ con số không. Bài này hợp với Gió & Rồng."
          }
        }
      }
    },
    "Eleven more racks, including the ones with a convincing decoy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elf weitere Racks, darunter auch welche mit einer überzeugenden falschen Fährte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Once atriles más, incluidos los que tienen un señuelo convincente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onze chevalets de plus, dont certains avec un leurre convaincant"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelas rak lagi, termasuk yang punya umpan meyakinkan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mười một bộ bài nữa, kể cả những bộ có mồi nhử trông rất thuyết phục"
          }
        }
      }
    },
    "Even Dots from 2 to 8 with three pairs, plus a pair of 6 Craks: this is a 2468 rack. The 1 Bam and 3 Crak are odd and the North is a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade Dot-Steine von 2 bis 8, darunter drei Paare, dazu ein Paar 6 Crak: Das ist ein 2468-Rack. Die 1 Bam und die 3 Crak sind ungerade, und der Nord ist ein einzelner Wind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichas pares de Dot del 2 al 8, con tres parejas, más una pareja de 6 Crak: este es un atril 2468. El 1 Bam y el 3 Crak son impares y el Norte es un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tuiles paires de la famille Dot, du 2 au 8, forment trois paires. Avec une paire de 6 Crak, cela donne un chevalet 2468. Le 1 Bam et le 3 Crak sont impairs et le Nord est un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubin Dot genap dari 2 sampai 8 dengan tiga pasang, ditambah pasangan 6 Crak: ini rak 2468. 1 Bam dan 3 Crak ganjil, dan ubin Utara adalah angin tunggal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các Dot chẵn từ 2 đến 8 với ba đôi, cộng thêm đôi 6 Crak: đây là bài 2468. 1 Bam và 3 Crak là số lẻ, còn Bắc là quân gió lẻ."
          }
        }
      }
    },
    "Even numbers only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur gerade Zahlen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo números pares"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffres pairs uniquement"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya angka genap"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ số chẵn"
          }
        }
      }
    },
    "Even on their own turn, an exposure that is already down cannot take more tiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst im eigenen Zug kann niemand eine bereits ausgelegte Gruppe um weitere Steine ergänzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni siquiera en su propio turno se pueden añadir más fichas a una exposición ya hecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même à son propre tour, une exposition déjà posée ne peut pas recevoir d'autres tuiles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahkan di giliran mereka sendiri, ekspos yang sudah ada tidak bisa menerima ubin lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngay cả đến lượt mình, họ cũng không thể thêm quân vào nhóm đã lộ."
          }
        }
      }
    },
    "Evens in Craks edge out odds in Bams, with five tiles including a pair against four singles, so lean 2468. The two lone winds help neither plan, so both go now, with the 3 Bam to start letting the odds go. The other odd Bams can follow over later passes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade Zahlen in Crak liegen knapp vor ungeraden Zahlen in Bam: fünf Steine, darunter ein Paar, gegenüber vier Einzelsteinen. Tendiere zu 2468. Die zwei einzelnen Winde helfen keinem Plan und gehen jetzt weg; wirf dazu die 3 Bam ab, um auch die ungeraden Steine nach und nach loszuwerden. Die übrigen ungeraden Bam-Steine kannst du in späteren Pässen abgeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fichas pares de Crak superan en número a las impares de Bam: son cinco, incluida una pareja, frente a cuatro sueltas, así que conviene optar por 2468. Los dos vientos sueltos no ayudan a ninguno de los dos planes, así que descarta ambos ahora junto con el 3 Bam para empezar a pasar los impares. Puedes pasar los demás Bam impares en rondas posteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chiffres pairs en Crak prennent l'avantage sur les chiffres impairs en Bam : cinq tuiles, dont une paire, contre quatre tuiles isolées. Penchez donc pour 2468. Les deux vents isolés ne servent aucun des deux plans : passez-les tous les deux dès maintenant, ainsi que le 3 Bam pour commencer à vous défaire des tuiles impaires. Vous pourrez passer les autres Bam impairs aux passes suivantes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubin genap di Crak sedikit mengungguli Bam ganjil: lima ubin termasuk sepasang berbanding empat ubin tunggal, jadi pilih 2468. Dua ubin angin tunggal tidak membantu rencana mana pun, jadi operkan keduanya sekarang bersama 3 Bam sebagai awal melepas ubin ganjil. Bam ganjil lainnya bisa dioperkan pada operan berikutnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chẵn ở Crak nhỉnh hơn lẻ ở Bam, với năm quân gồm một đôi so với bốn quân lẻ, nên nghiêng về 2468. Hai quân gió lẻ không giúp kế hoạch nào, nên chuyền cả hai ngay, cùng 3 Bam để bắt đầu bỏ các quân lẻ. Các Bam lẻ còn lại có thể theo sau ở những lượt chuyền sau."
          }
        }
      }
    },
    "Every 2 Bam is face up in the discards, so none is left in the wall or in anyone's rack. Old discards can never be called back, and the hand goes on as normal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vier 2-Bam-Steine wurden bereits abgeworfen. Es ist also keiner mehr in der Mauer oder auf einem Rack. Alte Abwürfe können nie zurückgerufen werden, und die Hand läuft normal weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los 2 Bam están boca arriba en los descartes, así que no queda ninguno en el muro ni en el atril de nadie. Los descartes antiguos nunca se pueden volver a cantar, y la mano sigue con normalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quatre 2 Bam sont visibles dans les défausses : il n'en reste donc ni dans le mur ni sur les chevalets. Une défausse passée ne peut pas être réclamée plus tard, et la manche continue normalement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keempat 2 Bam sudah dibuang, jadi tidak ada yang tersisa di dinding atau rak siapa pun. Buangan lama tidak bisa dipanggil kembali, dan permainan berlanjut seperti biasa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả bốn quân 2 Bam đều ngửa trong đống bỏ, nên không còn quân nào trong tường bài hay trên giá bài của ai. Quân đã bỏ không thể được gọi lại, và ván tiếp tục như bình thường."
          }
        }
      }
    },
    "Every exposure has to belong to a real hand on the card. Once another player calls your hand dead and the exposure proves it, you stop drawing and discarding for the rest of the hand, and you still pay the winner. Check the card before you call.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Auslage muss zu einer echten Hand der Karte gehören. Erklärt ein anderer Spieler deine Hand für tot und die Auslage belegt es, ziehst und wirfst du für den Rest der Hand nicht mehr, und zahlst trotzdem dem Gewinner. Prüf die Karte, bevor du rufst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda exposición debe pertenecer a una mano real de la tarjeta. Cuando otro jugador declara muerta tu mano y la exposición lo demuestra, dejas de robar y descartar el resto de la mano, y aun así le pagas al ganador. Revisa la tarjeta antes de declarar una mano muerta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exposition doit correspondre à une main valide sur la carte. Si un autre joueur déclare votre main morte et que l'exposition le confirme, vous cessez de piocher et de défausser jusqu'à la fin de la manche, mais vous payez quand même le gagnant. Vérifiez la carte avant de déclarer une main morte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ekspos harus cocok dengan salah satu pola tangan di kartu. Jika pemain lain menyatakan tanganmu mati dan eksposmu membuktikan bahwa itu benar, kamu berhenti mengambil dan membuang ubin sampai tangan selesai, tetapi tetap harus membayar pemenang. Periksa kartu sebelum menyatakan tangan lawan mati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi nhóm quân đã lộ đều phải khớp với một bài hợp lệ trên thẻ. Nếu người khác tuyên bố bài của bạn đã chết và nhóm bạn lộ ra chứng minh điều đó, bạn phải ngừng bốc và bỏ quân đến hết ván, nhưng vẫn phải trả tiền cho người thắng. Hãy kiểm tra thẻ trước khi hô."
          }
        }
      }
    },
    "Every number is a 3, 6 or 9 except the stray 2 Bam. A pung of 6 Craks plus pairs of 9s gives the 369 section a solid start.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen sind 3, 6 oder 9, bis auf die einzelne 2 Bam. Ein Pung 6 Crak plus Paare von 9ern geben der Sektion 369 einen soliden Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números son 3, 6 o 9, salvo el 2 Bam suelto. Un pung de 6 Crak más parejas de 9 dan a la sección 369 un buen inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont des 3, 6 ou 9, sauf le 2 Bam isolé. Un pung de 6 Crak plus des paires de 9 donnent à la section 369 un bon départ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka adalah 3, 6, atau 9 kecuali 2 Bam yang nyasar. Pung 6 Crak dan pasangan 9 menjadi awal yang kuat untuk pola 369."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số đều là 3, 6 hoặc 9 trừ quân 2 Bam lạc loài. Một pung 6 Crak cùng các đôi 9 là khởi đầu vững cho nhóm 369."
          }
        }
      }
    },
    "Every number is even: 2s, 4s, 6s and 8s across all three suits, with pungs of 2 Dots and 6 Bams. All evens is the 2468 pattern, and with no odd numbers between them they cannot step up as a run.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen sind gerade: 2er, 4er, 6er und 8er in allen drei Farben, darunter Pungs aus 2 Dot und 6 Bam. Das ist das 2468-Muster. Da keine ungeraden Zahlen dazwischenliegen, bilden sie keine Folge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números son pares: 2, 4, 6 y 8 en los tres palos, con pungs de 2 Dot y 6 Bam. La mano de números pares sigue el patrón 2468 y, como no hay números impares entre ellos, no se puede formar una escalera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont pairs : 2, 4, 6 et 8 dans les trois familles, avec des pungs de 2 Dot et de 6 Bam. Les nombres pairs forment le motif 2468 et, sans nombre impair entre eux, ils ne peuvent pas former une suite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ubin angkanya genap: 2, 4, 6, dan 8 dari ketiga jenis, termasuk pung 2 Dot dan 6 Bam. Ini pola 2468. Tanpa angka ganjil di antaranya, ubin-ubin ini tidak bisa membentuk urutan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả quân số đều chẵn: 2, 4, 6 và 8 ở cả ba chất, với pung 2 Dot và 6 Bam. Đây là kiểu bài 2468; vì không có số lẻ xen giữa, chúng không thể nối thành dãy."
          }
        }
      }
    },
    "Every number is odd except one stray 2 Dot. Three pairs of odd bams is a solid 13579 start. The 2 Dot and the lone wind are your first passes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen sind ungerade, bis auf eine einzelne 2 Dot. Drei Paare ungerader Bam sind ein solider Start für 13579. Die 2 Dot und der einzelne Wind sind deine ersten Abgaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números son impares salvo un 2 Dot suelto. Tres parejas de fichas impares de Bam dan una buena base para 13579. El 2 Dot y el viento suelto son tus primeros pases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont impairs, sauf un 2 Dot isolé. Trois paires de tuiles impaires en Bam constituent un bon départ pour 13579. Le 2 Dot et le vent isolé sont les premières tuiles à passer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka ganjil kecuali satu 2 Dot yang nyasar. Tiga pasang Bam ganjil adalah awal 13579 yang kuat. 2 Dot dan ubin angin tunggal adalah operan pertamamu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số đều lẻ trừ một quân 2 Dot lạc loài. Ba đôi Bam lẻ là khởi đầu vững cho 13579. Quân 2 Dot và quân gió lẻ là hai quân chuyền đầu tiên."
          }
        }
      }
    },
    "Every number on this rack is even, with not an odd tile in sight, so 2468 is the read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen auf diesem Rack sind gerade, kein einziger Stein ist ungerade. Das spricht für 2468."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números de este atril son pares, sin una sola ficha impar a la vista, así que la lectura es 2468."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres de ce chevalet sont pairs, sans une seule tuile impaire : le motif 2468 s'impose."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka di rak ini genap, tidak ada ubin ganjil sama sekali, jadi bacaannya 2468."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số trên giá này đều chẵn, không có quân lẻ nào, nên đây là 2468."
          }
        }
      }
    },
    "Every number tile is even, from 2s to 8s across the suits. The flowers and the joker point nowhere else, so the numbers decide and the read is 2468.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlensteine sind gerade, von 2 bis 8 in allen Farben. Blumen und Joker sprechen für keine andere Hand, die Zahlen geben also den Ausschlag: 2468."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fichas numéricas son pares, del 2 al 8 en los distintos palos. Las flores y el comodín no apuntan a otro lado, así que mandan los números y la lectura es 2468."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont pairs, du 2 au 8, dans les trois familles. Les fleurs et le joker n'indiquent aucune autre piste : le motif 2468 s'impose."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ubin angka genap, dari 2 sampai 8 di berbagai jenis. Bunga dan joker tidak memberi petunjuk tentang pola lain, jadi ubin angka yang menentukan pola: 2468."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quân số đều chẵn, từ 2 đến 8 ở cả ba chất. Hoa và joker không gợi ý hướng bài nào khác, nên các quân số quyết định hướng: bài 2468."
          }
        }
      }
    },
    "Every number tile is odd: 1s, 3s, 5s, 7s, 9s, with a pung of 3 Craks in hand. The flowers and the joker do not point anywhere else, so the numbers decide: this is a 13579 rack.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlensteine sind ungerade: 1er, 3er, 5er, 7er, 9er, dazu ein Pung 3 Crak. Blumen und Joker sprechen für keine andere Hand, die Zahlen geben also den Ausschlag: Das ist ein 13579-Rack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fichas numéricas son impares: 1, 3, 5, 7, 9, con un pung de 3 Crak en la mano. Las flores y el comodín no apuntan a otro lado, así que deciden los números: es un atril 13579."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont impairs : 1, 3, 5, 7, 9, avec un pung de 3 Crak. Les fleurs et le joker n'indiquent aucune autre piste. Les chiffres tranchent : le chevalet correspond à 13579."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ubin angka ganjil: 1, 3, 5, 7, 9, dengan pung 3 Crak di tangan. Bunga dan joker tidak memberi petunjuk tentang pola lain, jadi ubin angka yang menentukan pola: 13579."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quân số đều lẻ: 1, 3, 5, 7, 9, với một pung 3 Crak trong tay. Hoa và joker không chỉ hướng nào khác, nên các số quyết định: đây là bài 13579."
          }
        }
      }
    },
    "Every odd tile you pick up is dead weight. If half your rack is odd after the Charleston, you are in the wrong section.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder ungerade Stein, den du aufnimmst, ist Ballast. Ist nach dem Charleston die Hälfte deines Racks ungerade, bist du in der falschen Sektion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ficha impar que robas es un lastre. Si la mitad de tu atril es impar después del Charleston, estás en la sección equivocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque tuile impaire que vous ramassez est du poids mort. Si la moitié de votre chevalet est impaire après le Charleston, vous êtes dans la mauvaise section."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ubin ganjil yang kamu ambil adalah beban. Kalau separuh rakmu ganjil setelah Charleston, kamu salah bagian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi quân lẻ bạn bốc được chỉ làm vướng bài. Nếu sau Charleston, một nửa số quân trên giá bài của bạn là số lẻ, bạn đang theo sai nhóm."
          }
        }
      }
    },
    "Every other player just had the chance to take that exact tile and passed. Following a fresh discard is a classic safe throw. It is not a guarantee: one draw can change a hand, so it is safest right away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen Spieler hatten gerade die Chance, genau diesen Stein zu nehmen, und haben verzichtet. Einen gerade erst abgeworfenen Stein ebenfalls abzuwerfen, gilt als klassischer sicherer Abwurf. Das ist keine Garantie: Schon ein Zug kann eine Hand verändern. Deshalb ist es direkt danach am sichersten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los demás jugadores acaban de tener la oportunidad de cantar esa misma ficha y la dejaron pasar. Volver a descartarla enseguida es una jugada clásica y relativamente segura. No es infalible: una ficha que salga del muro puede cambiar una mano, así que cuanto antes la descartes, más segura será la jugada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres joueurs viennent d'avoir l'occasion de prendre cette même tuile et l'ont laissée passer. La défausser juste après est une stratégie classique pour jouer prudemment. Ce n'est pas une garantie : une pioche peut changer une main, mais c'est à ce moment que cette défausse est la plus sûre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pemain lain baru saja berkesempatan mengambil ubin yang sama, tetapi melewatkannya. Membuang ubin yang baru saja dilewatkan pemain lain adalah cara klasik untuk bermain aman. Ini bukan jaminan: satu kali mengambil ubin bisa mengubah tangan, jadi cara ini paling aman jika langsung dilakukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người chơi khác vừa có cơ hội lấy đúng quân đó nhưng đã bỏ qua. Bỏ quân cùng loại ngay sau đó là cách đánh an toàn kinh điển. Điều này không bảo đảm an toàn: chỉ một lần bốc cũng có thể làm thay đổi bài, nên quân đó an toàn nhất nếu bạn bỏ ngay."
          }
        }
      }
    },
    "Every player races to build a 14-tile hand that exactly matches one of the hands printed on the yearly card. Thirteen tiles live on your rack; the fourteenth is the tile you draw or call that completes the pattern. Complete it first and you call mahj.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Spieler wetteifern darum, eine Hand aus 14 Steinen zu bauen, die genau zu einer der Hände auf der Jahreskarte passt. Dreizehn Steine liegen auf deinem Rack, der vierzehnte ist der Stein, den du ziehst oder rufst und der das Muster vollendet. Wer zuerst fertig ist, ruft Mah Jongg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los jugadores compiten por formar una mano de 14 fichas que coincida exactamente con una de las manos impresas en la tarjeta anual. En tu atril hay trece fichas; la decimocuarta es la que robas o cantas para completar el patrón. Quien la complete primero canta mahj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque joueur cherche à être le premier à former une main de 14 tuiles correspondant exactement à l'une des mains imprimées sur la carte de l'année. Treize tuiles restent sur votre chevalet ; la quatorzième est celle que vous piochez ou réclamez pour compléter la combinaison. Complétez-la en premier et annoncez mahj."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pemain berlomba menyusun tangan 14 ubin yang persis cocok dengan salah satu tangan yang tercetak di kartu tahunan. Tiga belas ubin ada di rakmu; yang keempat belas adalah ubin yang kamu ambil atau panggil untuk melengkapi pola. Selesaikan lebih dulu dan kamu memanggil mah jongg."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người đua nhau tạo bộ 14 quân khớp chính xác với một bài in trên thẻ năm. Bạn giữ 13 quân trên giá bài; quân thứ 14 là quân bốc hoặc hô để hoàn thành mẫu. Ai hoàn thành trước sẽ hô mahj."
          }
        }
      }
    },
    "Everyone holds thirteen between turns. Nine are showing in the three pungs, so only four are hidden, and those four plus one more tile make the hand. The fewer tiles hidden, the easier they are to read and the closer they usually are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen den Zügen hält jeder dreizehn Steine. Neun liegen in den drei Pungs offen, also sind nur vier verdeckt, und diese vier plus ein weiterer Stein bilden die Hand. Je weniger Steine verdeckt sind, desto leichter lässt sich die Hand lesen und desto näher ist der Spieler meist am Mah Jongg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tienen trece fichas entre turnos. Nueve quedan a la vista en los tres pungs, así que solo cuatro siguen ocultas; esas cuatro y una ficha más completan la mano. Cuantas menos fichas ocultas tenga un jugador, más fácil será leer su mano y más cerca estará normalmente de ganar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde a treize tuiles entre deux tours. Neuf sont visibles dans les trois pungs ; il ne lui en reste donc que quatre cachées, auxquelles s'ajoute une tuile pour former sa main. Moins il a de tuiles cachées, plus sa main est facile à lire et plus il est généralement proche de gagner."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua orang memegang tiga belas ubin di antara giliran. Sembilan ubin terlihat dalam tiga pung, jadi hanya empat yang tersembunyi. Empat ubin itu ditambah satu lagi melengkapi tangan. Makin sedikit ubin tersembunyi, makin mudah membaca tangan mereka, dan biasanya mereka makin dekat dengan kemenangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữa các lượt, ai cũng giữ 13 quân. Chín quân đã lộ trong ba pung, nên chỉ còn bốn quân úp; thêm một quân nữa là đủ hoàn thành bài. Càng ít quân úp thì càng dễ đọc bài của đối thủ, và họ thường càng gần thắng."
          }
        }
      }
    },
    "Everyone pays East": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle zahlen an Ost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos pagan al Este"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde paie l'Est"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pemain membayar pemain Timur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người đều trả tiền cho người chơi Đông"
          }
        }
      }
    },
    "Exactly four": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau vier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactamente cuatro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactement quatre"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tepat empat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng bốn"
          }
        }
      }
    },
    "Expert Rack Reading": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rack-Lesen für Profis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lectura experta de atriles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture experte du chevalet"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca Rak Tingkat Ahli"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc bài chuyên sâu"
          }
        }
      }
    },
    "Expose the pung and draw a replacement tile": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Pung auslegen und einen Ersatzstein ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponer el pung y robar una ficha de reemplazo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposer le pung et piocher une tuile de remplacement"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspos pung dan ambil ubin pengganti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để lộ pung và bốc một quân thay thế"
          }
        }
      }
    },
    "Expose the pung, then discard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Pung auslegen, dann abwerfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponer el pung y luego descartar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposer le pung, puis défausser"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspos pung, lalu buang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để lộ pung, rồi bỏ"
          }
        }
      }
    },
    "Exposed jokers are up for grabs. A single spare natural tile can pull one into your hand on your turn. Knowing which jokers are live tells you when a swap is waiting for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgelegte Joker kannst du dir holen. Mit einem einzelnen überzähligen echten Stein kannst du in deinem Zug den passenden Joker ablösen und auf die Hand nehmen. Wenn du weißt, welche Joker ausliegen, erkennst du, wann sich ein Tausch lohnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comodines expuestos están disponibles. Una ficha natural que te sobre te permite cambiarla por uno en tu turno. Saber cuáles siguen disponibles te indica cuándo puedes hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jokers exposés sont disponibles pour un échange. À votre tour, une tuile naturelle en trop peut vous permettre d'en récupérer un. Savoir lesquels sont encore disponibles vous aide à repérer les occasions d'échange."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Joker yang diekspos bisa diambil siapa saja. Pada giliranmu, kamu bisa memakai satu ubin asli cadangan untuk menebus joker yang diekspos. Mengetahui joker mana yang masih bisa ditebus menunjukkan kapan ada kesempatan menukarnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joker đã lộ thì ai cũng có thể lấy. Chỉ cần một quân thật dư, bạn có thể đổi lấy joker đó trong lượt của mình. Biết joker nào còn có thể đổi sẽ giúp bạn nhận ra cơ hội."
          }
        }
      }
    },
    "Exposed jokers can be traded for the real tile they stand in for.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgelegte Joker können gegen den echten Stein getauscht werden, den sie vertreten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comodines expuestos se pueden cambiar por la ficha natural que representan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jokers exposés peuvent être échangés contre la tuile naturelle qu'ils remplacent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Joker yang diekspos bisa ditukar dengan ubin asli yang diwakilinya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joker đã lộ có thể đổi lấy quân thật mà nó thay thế."
          }
        }
      }
    },
    "Exposed pungs can grow into kongs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgelegte Pungs können zu Kongs wachsen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pungs expuestos pueden convertirse en kongs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pungs exposés peuvent devenir des kongs"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pung yang diekspos bisa tumbuh jadi kong"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pung đã lộ có thể được bổ sung để thành kong"
          }
        }
      }
    },
    "Exposure": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auslage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposición"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposition"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspos"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ đã lộ"
          }
        }
      }
    },
    "Exposures already down make no difference to who gets a tile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits ausgelegte Gruppen ändern nichts daran, wer einen Stein bekommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exposiciones que ya están en la mesa no influyen en quién puede reclamar una ficha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les expositions déjà posées ne déterminent pas qui peut réclamer une tuile."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspos yang sudah ada tidak berpengaruh pada siapa yang mendapat ubin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các nhóm quân đã lộ trên bàn không ảnh hưởng đến thứ tự ai được nhận quân."
          }
        }
      }
    },
    "Find the stretch your numbers share, then pass what falls outside it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde den gemeinsamen Zahlenbereich und gib die Steine außerhalb davon ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra el tramo que comparten tus números y pasa las fichas que queden fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez l'intervalle couvert par vos chiffres, puis passez les tuiles qui n'en font pas partie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari rentang angka yang dibentuk ubinmu, lalu operkan ubin di luar rentang itu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy tìm khoảng số chung giữa các quân bạn có, rồi chuyền những quân nằm ngoài khoảng đó."
          }
        }
      }
    },
    "First Charleston, pass ACROSS. Dragons are stacking up.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erster Charleston: Gib die Steine an dein Gegenüber weiter. Drachen häufen sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer Charleston, pasa AL OTRO LADO. Los dragones se acumulan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premier Charleston, passez EN FACE. Les dragons s'accumulent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston pertama, operkan ke SEBERANG. Naga makin banyak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
