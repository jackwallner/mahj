    "Stopping the Second Charleston": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den zweiten Charleston stoppen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener el segundo Charleston"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
