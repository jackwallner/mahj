            "state": "translated",
            "value": "Không làm gì, joker lộ bị đóng băng"
          }
        }
      }
    },
    "Nothing, just decoration": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, nur Dekoration"
