            "value": "Attendre votre tour normal"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu giliranmu seperti biasa"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chờ đến lượt bình thường"
          }
        }
      }
    },
    "Wall": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mauer"
          }
        },
        "es": {
