      }
    },
    "Pass tiles that fit no section you are chasing. Never pass a joker.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Steine ab, die zu keiner Sektion passen, die du verfolgst. Gib nie einen Joker ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa las fichas que no encajan en ninguna sección que persigues. Nunca pases un comodín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez les tuiles qui ne conviennent à aucune section visée. Ne passez jamais un joker."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operkan ubin yang tidak cocok dengan bagian mana pun yang kamu kejar. Jangan pernah mengoperkan joker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chuyền những quân không hợp với bất kỳ nhóm nào bạn đang theo. Không bao giờ chuyền joker."
          }
        }
      }
    },
    "Pass what does not fit the story your rack is already telling.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib Steine weiter, die nicht zu dem passen, was dein Rack bereits erkennen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa lo que no encaja con la historia que ya cuenta tu atril."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez ce qui ne cadre pas avec l'histoire que raconte déjà votre chevalet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operkan ubin yang tidak mendukung arah yang sudah ditunjukkan rakmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chuyền những quân không hợp với hướng bài của bạn."
          }
        }
      }
    },
    "Passes Are Hints": {
      "extractionState": "manual",
      "localizations": {
