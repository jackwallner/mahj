            "state": "translated",
            "value": "Giữ nếu có dòng dùng nó"
          }
        }
      }
    },
    "Keep a backup in mind when you pass: here odds and 369 both still use your 9s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte beim Abgeben einen Plan B im Kopf: Hier nutzen Ungerade und 369 beide noch deine 9er."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten un respaldo en mente al pasar: aquí los impares y 369 aún usan tus 9."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez un secours en tête quand vous passez : ici, impairs et 369 utilisent tous deux vos 9."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingat cadangan saat mengoperkan: di sini ganjil dan 369 sama-sama masih memakai 9-mu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhớ một phương án dự phòng khi chuyền: ở đây bài lẻ và 369 đều vẫn dùng các quân 9 của bạn."
          }
        }
      }
    },
