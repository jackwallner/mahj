            "state": "translated",
            "value": "Il met fin immédiatement à la partie"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung mengakhiri permainan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nó kết thúc ván ngay lập tức"
          }
        }
      }
    },
    "It floats between all three": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er schwebt zwischen allen dreien"
          }
        },
        "es": {
