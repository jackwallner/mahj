            "value": "Các số nối tiếp nhau"
          }
        }
      }
    },
    "Odd numbers only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ungerade Zahlen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
