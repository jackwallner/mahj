        }
      }
    },
    "The player on your left just threw a 4 Bam and nobody called it. You hold a 4 Bam. How risky is throwing it now?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spieler links von dir hat gerade eine 4 Bam abgeworfen, und niemand hat sie gerufen. Du hältst eine 4 Bam. Wie riskant ist es, sie jetzt abzuwerfen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jugador a tu izquierda acaba de tirar un 4 Bam y nadie lo cantó. Tienes un 4 Bam. ¿Qué riesgo corres si lo tiras ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joueur à votre gauche vient de défausser un 4 Bam et personne ne l'a appelé. Vous en avez un aussi. Est-ce risqué de le défausser maintenant ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain di kirimu baru membuang 4 Bam dan tidak ada yang memanggilnya. Kamu memegang 4 Bam. Seberapa berisiko membuangnya sekarang?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người bên trái bạn vừa bỏ một 4 Bam và không ai hô. Bạn có một 4 Bam. Bỏ nó bây giờ rủi ro thế nào?"
          }
        }
      }
    },
    "The player on your right has discarded three Craks in a row. Which suit are they least likely to be collecting?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spieler rechts von dir hat dreimal hintereinander Crak abgeworfen. Welche Farbe sammelt er wohl am wenigsten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jugador a tu derecha ha descartado tres Crak seguidos. ¿Qué palo es menos probable que esté reuniendo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joueur à votre droite a défaussé trois Crak d'affilée. Quelle famille a-t-il le moins de chances de collectionner ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain di kananmu membuang tiga Crak berturut-turut. Jenis mana yang paling kecil kemungkinannya sedang mereka kumpulkan?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người bên phải bạn đã bỏ liên tiếp ba quân Crak. Họ ít có khả năng đang gom chất nào nhất?"
          }
        }
      }
    },
    "The player who throws the winning tile pays double": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den Gewinnstein abwirft, zahlt doppelt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tira la ficha ganadora paga el doble"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joueur qui défausse la tuile gagnante paie le double"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain yang membuang ubin kemenangan membayar dua kali lipat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người bỏ quân thắng trả gấp đôi"
          }
        }
      }
    },
    "The player whose turn comes next": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spieler, der als Nächstes dran ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jugador al que le toca el turno a continuación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le joueur dont le tour vient ensuite"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain yang mendapat giliran berikutnya"
          }
        },
        "vi": {
          "stringUnit": {
