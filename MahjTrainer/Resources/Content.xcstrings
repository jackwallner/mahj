          }
        }
      }
    },
    "Breaking Up Pairs": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paare auflösen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Romper parejas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Briser des paires"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memecah Pasangan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tách đôi"
          }
        }
      }
    },
    "Breaking your own pair costs you a start, and the tile is no safer for it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein eigenes Paar aufzulösen kostet dich einen Start, und der Stein wird dadurch nicht sicherer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Romper tu propia pareja te quita un comienzo, y la ficha no es más segura por eso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Casser votre propre paire vous coûte un départ, et la tuile n'en est pas plus sûre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memecah pasanganmu sendiri merugikan awalanmu, dan ubinnya tidak jadi lebih aman."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phá đôi của mình làm bạn mất một khởi đầu, mà quân đó cũng không an toàn hơn."
          }
        }
      }
    },
    "But you like Hand A...": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aber Hand A gefällt dir ..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pero te gusta la Mano A..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais vous aimez la main A..."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapi kamu suka Tangan A..."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhưng bạn thích Bộ A..."
          }
        }
      }
    },
    "C means concealed, so nothing may be exposed before mah jongg. Once a group is face up on your rack, every C line is closed to you and only X lines can still win.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "C steht für verdeckt, vor Mah Jongg darf also nichts ausgelegt sein. Sobald eine Gruppe offen auf deinem Rack liegt, sind alle C-Zeilen für dich zu, und nur X-Zeilen können noch gewinnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "C significa oculta, así que no se puede exponer nada antes del mah jongg. Cuando un grupo está boca arriba en tu atril, todas las líneas C quedan cerradas y solo las líneas X pueden ganar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C signifie cachée : rien ne doit être exposé avant mah jongg. Dès qu'un groupe est face visible sur votre chevalet, toutes les lignes C vous sont fermées et seules les lignes X peuvent encore gagner."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "C berarti tertutup, jadi tidak boleh ada yang diekspos sebelum mah jongg. Begitu sebuah kelompok terbuka di rakmu, semua baris C tertutup bagimu dan hanya baris X yang masih bisa menang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C nghĩa là kín, nên không được để lộ quân nào trước khi mah jongg. Khi một nhóm đã ngửa trên giá, mọi dòng C đều đóng với bạn và chỉ còn dòng X có thể thắng."
          }
        }
      }
    },
    "C vs X on the Card": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "C und X auf der Karte"
