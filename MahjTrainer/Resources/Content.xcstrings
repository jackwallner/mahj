          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubin yang baru kamu ambil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một quân bạn vừa bốc"
          }
        }
      }
    },
    "A wall game costs nothing. The tiles are reshuffled and the next hand is dealt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Runde ohne Gewinner kostet nichts. Die Steine werden neu gemischt und die nächste Hand wird ausgeteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mano que termina al agotarse el muro no cuesta nada. Se vuelven a mezclar las fichas y se reparte la siguiente mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie sans vainqueur ne coûte rien. Les tuiles sont remélangées et la main suivante est distribuée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika permainan berakhir karena dinding habis, tidak ada yang membayar. Ubin diacak ulang dan tangan berikutnya dibagikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ván hòa không mất gì. Các quân được xáo lại rồi chia ván tiếp theo."
          }
        }
      }
    },
    "A wind nobody has thrown is still live for anyone collecting winds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wind, den noch niemand abgeworfen hat, ist für alle, die Winde sammeln, noch im Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viento que nadie ha descartado sigue disponible para quien esté reuniendo vientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vent que personne n'a jeté reste disponible pour les joueurs qui collectionnent les vents."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angin yang belum dibuang siapa pun masih bisa didapat oleh siapa pun yang mengumpulkan ubin angin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một quân gió chưa ai bỏ vẫn có thể dùng được cho bất kỳ ai đang gom các quân gió."
          }
        }
      }
    },
    "A wind nobody has thrown yet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wind, den noch niemand abgeworfen hat"
          }
        },
        "es": {
