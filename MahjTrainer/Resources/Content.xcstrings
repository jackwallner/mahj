    "Dragons and winds are both honors. A rack full of them wants Winds & Dragons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drachen und Winde sind beide Ehrensteine. Ein Rack voll davon will Winde & Drachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dragones y los vientos son honores. Un atril lleno de ellos quiere Vientos y Dragones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dragons et les vents sont tous des honneurs. Un chevalet qui en regorge veut Vents et Dragons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naga dan angin sama-sama ubin kehormatan. Rak penuh keduanya menginginkan Angin & Naga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rồng và gió đều là quân danh dự. Giá đầy chúng cần Gió & Rồng."
          }
        }
      }
    },
    "Dragons required": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drachen nötig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requieren dragones"
          }
        },
        "fr": {
