            "state": "translated",
            "value": "Nó còn một công dụng khác"
          }
        }
      }
    },
    "It is against the rules to discard one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihn abzuwerfen ist gegen die Regeln"
