    "Nothing stops the hand. Play goes on as normal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts stoppt die Hand. Das Spiel läuft normal weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada detiene la mano. El juego continúa con normalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'arrête la manche. Le jeu continue normalement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menghentikan tangan. Permainan berlanjut seperti biasa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gì dừng ván bài. Ván tiếp tục bình thường."
          }
        }
      }
    },
    "Nothing tells you they do not want Bams. The Dots are the suit they gave away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts sagt dir, dass er keine Bam will. Die Dots sind die Farbe, die er abgegeben hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada te dice que no quiera Bam. Los Dot son el palo que regaló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne dit qu'il ne veut pas de Bam. Les Dot sont la famille qu'il a donnée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menunjukkan mereka tidak menginginkan Bam. Dot adalah jenis yang mereka lepas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gì cho thấy họ không muốn Bam. Dot là chất họ đã cho đi."
