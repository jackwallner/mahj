          }
        }
      }
    },
    "Mostly evens, no pairs yet. First pass.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist gerade, noch keine Paare. Erster Pass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi todo pares, sin parejas todavía. Primer pase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surtout des pairs, pas encore de paires. Première passe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebanyakan genap, belum ada pasangan. Operan pertama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần lớn là chẵn, chưa có đôi. Lượt chuyền đầu."
          }
        }
      }
    },
    "N E W S + dragons": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "N E W S + Drachen"
          }
        },
        "es": {
