    },
    "Keep the flowers. Many hands use them, and they cost you nothing to hold.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte die Blumen. Viele Hände nutzen sie, und sie zu halten kostet dich nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las flores. Muchas manos las usan y no te cuesta nada tenerlas."
