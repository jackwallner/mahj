    },
    "Neither: a tie means nobody takes it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keiner: Bei Gleichstand nimmt ihn niemand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno: un empate significa que nadie la toma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun : en cas d'égalité, personne ne la prend"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak satu pun: seri berarti tidak ada yang mengambilnya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai: hòa nghĩa là không ai lấy"
          }
        }
      }
    },
