    },
    "Hold natural pairs by default, and break one only when every other pass costs more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte natürliche Paare grundsätzlich und löse eins nur auf, wenn jede andere Abgabe mehr kostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva las parejas naturales por defecto y rompe una solo cuando cualquier otro pase cueste más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les paires naturelles par défaut, et n'en cassez une que si toutes les autres passes coûtent plus cher."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan pasangan asli secara default, dan pecahkan hanya kalau setiap operan lain lebih mahal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định hãy giữ đôi thật, và chỉ phá một đôi khi mọi lựa chọn khác tốn hơn."
          }
        }
      }
    },
    "Hold pairs by default, but a pair that fits none of your target section is fair to pass early, before opponents lock in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Paare grundsätzlich, aber ein Paar, das zu keiner Zielsektion passt, kannst du früh abgeben, bevor sich die Gegner festlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva las parejas por defecto, pero una pareja que no encaja en tu sección objetivo se puede pasar al principio, antes de que los rivales se definan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les paires par défaut, mais une paire qui ne convient à aucune de vos sections visées peut être passée tôt, avant que les adversaires se fixent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertahankan pasangan secara default, tapi pasangan yang tidak cocok dengan bagian targetmu wajar dioperkan di awal, sebelum lawan terkunci."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định hãy giữ đôi, nhưng đôi không hợp nhóm mục tiêu nào của bạn thì chuyền sớm được, trước khi đối thủ chốt."
          }
        }
      }
    },
    "Holding a pair does not bring an old discard back. Only the latest one can be called.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Paar zu halten holt keinen alten Abwurf zurück. Nur der letzte kann gerufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tener una pareja no devuelve un descarte antiguo. Solo se puede cantar el último."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoir une paire ne ramène pas une ancienne défausse. Seule la dernière peut être appelée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memegang pasangan tidak mengembalikan buangan lama. Hanya yang terbaru yang bisa dipanggil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có đôi không làm quân bỏ cũ quay lại. Chỉ quân mới nhất mới hô được."
          }
        }
      }
    },
    "Holding a tile you do not need wastes a spot in your hand, and the joker is yours for the trade.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Stein zu halten, den du nicht brauchst, verschwendet einen Platz in deiner Hand, und der Joker gehört dir für den Tausch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar una ficha que no necesitas desperdicia un lugar en tu mano, y el comodín es tuyo con el canje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder une tuile inutile gaspille une place dans votre main, et le joker est à vous pour l'échange."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan ubin yang tidak kamu perlukan memboroskan tempat di tanganmu, dan jokernya jadi milikmu lewat pertukaran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ quân không cần là lãng phí một chỗ trong bài, và joker là của bạn nếu đổi."
          }
        }
      }
    },
    "Holding too many flowers": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Blumen halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tener demasiadas flores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoir trop de fleurs"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memegang terlalu banyak bunga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ quá nhiều hoa"
          }
        }
      }
    },
    "Honors": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehrensteine"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Honores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Honneurs"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubin kehormatan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân danh dự"
          }
        }
      }
    },
    "Honors are stacking up and the numbers are scattered. First pass, three tiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehrensteine häufen sich und die Zahlen sind verstreut. Erster Pass, drei Steine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los honores se acumulan y los números están dispersos. Primer pase, tres fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les honneurs s'accumulent et les chiffres sont dispersés. Première passe, trois tuiles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubin kehormatan menumpuk dan angkanya tersebar. Operan pertama, tiga ubin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân danh dự đang chất đống còn các số thì rải rác. Lượt chuyền đầu, ba quân."
          }
        }
      }
    },
    "Hot tile": {
