          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deuxième Charleston, passez EN FACE. Vous avez déjà de bonnes bases pour une main de nombres pairs. Choisissez 3 tuiles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston kedua, operkan ke SEBERANG. Kamu sudah mantap mengejar angka genap. Pilih 3."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston thứ hai, chuyền ĐỐI DIỆN. Các quân chẵn của bạn đã ổn. Chọn 3."
          }
        }
      }
    },
    "Second Charleston, pass ACROSS. Your numbers sit low.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, ans GEGENÜBER. Du hast eher niedrige Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundo Charleston, pasa AL OTRO LADO. Tus números son bajos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deuxième Charleston, passez EN FACE. Vous avez surtout des petits chiffres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston kedua, operkan ke SEBERANG. Angkamu rendah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston thứ hai, chuyền ĐỐI DIỆN. Các số của bạn thấp."
          }
        }
      }
    },
    "Second Charleston, pass ACROSS. Your numbers sit low. Pick 3.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, ans GEGENÜBER. Du hast eher niedrige Zahlen. Wähl 3."
          }
        },
        "es": {
