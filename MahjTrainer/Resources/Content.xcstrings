    "A Consecutive Run line is printed with 1s, 2s and 3s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile für Folgen zeigt 1er, 2er und 3er."
