      }
    },
    "The Twice-Thrown Wind": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zweimal abgeworfene Wind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El viento tirado dos veces"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vent jeté deux fois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angin yang Sudah Dibuang Dua Kali"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân gió đã bị bỏ hai lần"
          }
        }
      }
    },
    "The White Dragon, so called because the plain-faced version looks like a bar of soap. It is the dot suit's dragon, and it also stands in for a zero in year hands.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Weiße Drache, so genannt, weil die schlichte Version wie ein Stück Seife aussieht. Er ist der Drache der Dot-Farbe und steht in Jahreshänden auch für die Null."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dragón Blanco, llamado así porque la versión de cara lisa parece una pastilla de jabón. Es el dragón del palo Dot y también hace de cero en las manos del año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Dragon Blanc, ainsi nommé parce que la version à face unie ressemble à une savonnette. C'est le dragon des Dot, et il remplace aussi un zéro dans les mains de l'année."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naga Putih, disebut begitu karena versi polosnya tampak seperti sabun batang. Ia naga jenis Dot, dan juga mewakili nol di tangan tahun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rồng Trắng, gọi vậy vì bản mặt trơn trông như cục xà phòng. Nó là rồng của chất Dot, và cũng thay cho số 0 trong bộ bài Năm."
          }
        }
      }
    },
    "The Whole Set": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ganze Set"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego completo"
          }
        },
        "fr": {
