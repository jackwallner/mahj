          }
        }
      }
    },
    "Discarding out of turn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Außer der Reihe abwerfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar fuera de turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser hors de son tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang di luar giliran"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ bài sai lượt"
          }
        }
      }
    },
    "Discards after the halfway point are scored": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwürfe nach der Hälfte werden gewertet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los descartes después de la mitad puntúan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défausses après la moitié de la manche sont notées"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan setelah titik tengah dihitung skornya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân bỏ sau nửa ván được tính điểm"
          }
        }
      }
    },
    "Discards are never scored. Only the winning hand is paid.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwürfe werden nie gewertet. Bezahlt wird nur die Gewinnhand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los descartes nunca puntúan. Solo se paga la mano ganadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défausses ne sont jamais notées. Seule la main gagnante est payée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan tidak pernah dihitung skornya. Hanya tangan kemenangan yang dibayar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân bỏ không bao giờ được tính điểm. Chỉ bộ bài thắng được trả tiền."
          }
        }
      }
    },
    "Discards are the clue. Three of one suit in a row is a real hint.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwürfe sind der Hinweis. Dreimal dieselbe Farbe hintereinander ist ein echter Fingerzeig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los descartes son la pista. Tres de un mismo palo seguidos son una pista real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défausses sont l'indice. Trois d'une même famille d'affilée, c'est un vrai signal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan adalah petunjuknya. Tiga dari satu jenis berturut-turut adalah isyarat nyata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân bỏ là manh mối. Ba quân cùng chất liên tiếp là gợi ý thật."
          }
        }
      }
    },
    "Discards can be called for pairs at any time": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwürfe können jederzeit für Paare gerufen werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los descartes se pueden cantar para parejas en cualquier momento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les défausses peuvent être appelées pour des paires à tout moment"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan bisa dipanggil untuk pasangan kapan saja"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân bỏ hô được cho đôi bất cứ lúc nào"
          }
        }
      }
    },
    "Discards can only be called to make a group of 3 or more, or to win. A pair is not an exposure, so the only way to claim a discard for a pair is if it is your winning tile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwürfe kann man nur rufen, um eine Gruppe aus 3 oder mehr Steinen zu bilden oder zu gewinnen. Ein Paar ist keine Auslage, du kannst einen Abwurf für ein Paar also nur rufen, wenn es dein Gewinnstein ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los descartes solo se pueden cantar para formar un grupo de 3 o más, o para ganar. Una pareja no es una exposición, así que la única forma de reclamar un descarte para una pareja es que sea tu ficha ganadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne peut appeler une défausse que pour former un groupe de 3 tuiles ou plus, ou pour gagner. Une paire n'est pas une exposition : la seule façon de réclamer une défausse pour une paire est que ce soit votre tuile gagnante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan hanya bisa dipanggil untuk membuat kelompok 3 ubin atau lebih, atau untuk menang. Pasangan bukan ekspos, jadi satu-satunya cara mengambil buangan untuk pasangan adalah kalau itu ubin kemenanganmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ được hô quân bỏ để tạo nhóm từ 3 quân trở lên, hoặc để thắng. Đôi không phải là quân lộ, nên cách duy nhất để nhận quân bỏ cho đôi là khi đó là quân thắng của bạn."
          }
        }
      }
    },
    "Do your tiles fill that part of the line?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen deine Steine zu diesem Teil der Zeile?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Tus fichas cubren esa parte de la línea?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tuiles complètent-elles cette partie de la ligne ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah ubinmu mengisi bagian baris itu?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân của bạn có khớp phần đó của dòng không?"
          }
        }
      }
    },
    "Doesn't fit": {
