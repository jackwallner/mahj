            "value": "An toàn nhất có thể"
          }
        }
      }
    },
    "Advanced Charleston": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortgeschrittener Charleston"
          }
        },
        "es": {
