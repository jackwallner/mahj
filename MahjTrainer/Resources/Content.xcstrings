    "The mirror of the evens family, with five numbers to build from instead of four.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gegenstück zur Familie der geraden Zahlen, mit fünf statt vier Zahlen zur Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espejo de la familia de pares, con cinco números para construir en lugar de cuatro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le miroir de la famille des nombres pairs, avec cinq chiffres à combiner au lieu de quatre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebalikan dari keluarga genap, dengan lima angka yang bisa dipilih, bukan empat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm số lẻ, tương tự nhóm số chẵn nhưng có năm số để ghép thay vì bốn."
          }
        }
      }
    },
