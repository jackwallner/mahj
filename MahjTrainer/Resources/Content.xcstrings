          }
        }
      }
    },
    "A 7 is odd, so it misses the evens read this table may show.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine 7 ist ungerade und passt nicht zu dem Muster aus geraden Zahlen, das sich an diesem Tisch abzeichnen könnte."
          }
        },
        "es": {
