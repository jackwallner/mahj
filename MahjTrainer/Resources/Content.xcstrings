          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, joker dùng ở đâu cũng được"
          }
        }
      }
    },
    "Yes, like any discard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, wie jeden Abwurf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, como cualquier descarte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, comme n'importe quelle défausse"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, seperti buangan lain"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, như mọi quân bỏ"
          }
        }
      }
    },
    "Yes, like any other player": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, wie jeder andere Spieler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, como cualquier otro jugador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, comme tout autre joueur"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, seperti pemain lain"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, như mọi người chơi khác"
          }
        }
      }
    },
    "Yes, on their own turn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, in seinem eigenen Zug"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, en su propio turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, à son propre tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, di giliran mereka sendiri"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, vào lượt của họ"
          }
        }
      }
    },
    "Yes, on your turn": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, in deinem Zug"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, en tu turno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, à votre tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, di gilirmu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, vào lượt của bạn"
          }
        }
      }
    },
    "Yes, then expose all four": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, dann alle vier auslegen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, y luego expones las cuatro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, puis exposez les quatre"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, lalu ekspos keempatnya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, rồi để lộ cả bốn"
          }
        }
      }
    },
    "Yes, unless noted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, wenn nichts dasteht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, salvo que se indique lo contrario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, sauf mention"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, kecuali ada catatan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có, trừ khi có ghi chú"
          }
        }
      }
    },
    "Yes. On your turn, before you discard, you may give the real matching tile to any exposure holding a joker, yours or an opponent's, and take the joker into your hand. Check every exposure for jokers you can take.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja. In deinem Zug darfst du vor dem Abwerfen den passenden echten Stein auf jede Auslage mit einem Joker legen, deine oder die eines Gegners, und den Joker auf die Hand nehmen. Prüf jede Auslage auf Joker, die du nehmen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí. En tu turno, antes de descartar, puedes entregar la ficha natural correspondiente a cualquier exposición con un comodín, tuya o de un oponente, y llevarte el comodín a la mano. Revisa todas las exposiciones para ver si hay comodines que puedas tomar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui. À votre tour, avant de défausser, vous pouvez donner la tuile naturelle correspondante à toute exposition contenant un joker, la vôtre ou celle d'un adversaire, et prendre le joker en main. Vérifiez chaque exposition pour repérer les jokers que vous pouvez récupérer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya. Di gilirmu, sebelum membuang, kamu boleh memberikan ubin asli yang cocok ke ekspos mana pun yang berisi joker, milikmu atau lawan, dan mengambil jokernya ke tanganmu. Periksa setiap ekspos untuk joker yang bisa kamu ambil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có. Đến lượt bạn, trước khi bỏ quân, bạn có thể đưa quân thật tương ứng cho bất kỳ bộ đã lộ nào có joker, dù là của bạn hay của đối thủ, rồi lấy joker về tay. Hãy kiểm tra mọi bộ đã lộ để xem có joker nào bạn lấy được."
          }
        }
      }
    },
    "You are 3 tiles from a 2468 hand and 4 from a Consecutive Run.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir fehlen 3 Steine bis zur 2468-Hand und 4 bis zu einer Folge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a 3 fichas de una mano 2468 y a 4 de una Escalera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à 3 tuiles d'une main 2468 et à 4 d'une Suite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu butuh 3 ubin lagi untuk tangan 2468 dan 4 lagi untuk Urutan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn còn thiếu 3 quân cho bộ 2468 và 4 quân cho Dãy liên tiếp."
          }
        }
      }
    },
    "You are chasing a quint (five of a kind) of 5 Dots using jokers. Three 5 Dots are already visible around the table. Keep pushing?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du versuchst, mit Jokern einen Quint aus fünf 5-Dot-Steinen zu bilden. Drei 5 Dot sind schon am Tisch sichtbar. Machst du weiter?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás intentando formar un quint de 5 Dot con comodines. Ya se ven tres 5 Dot en la mesa. ¿Sigues adelante?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous visez un quint (cinq identiques) de 5 Dot avec des jokers. Trois 5 Dot sont déjà visibles autour de la table. Continuer ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu mengejar quint 5 Dot (lima ubin sejenis) dengan joker. Tiga 5 Dot sudah terlihat di sekitar meja. Tetap mau mengejarnya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang cố tạo một quint gồm năm quân 5 Dot bằng joker. Ba quân 5 Dot đã lộ quanh bàn. Có nên tiếp tục theo đuổi không?"
          }
        }
      }
    },
    "You are one tile from mah jongg: a lone 5 Dot.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dir fehlt ein Stein zu Mah Jongg: eine einzelne 5 Dot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a una ficha de cantar mah jongg: un 5 Dot suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous manque une tuile pour mah jongg : un 5 Dot isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu tinggal satu ubin dari mah jongg: 5 Dot yang sendirian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn còn một quân nữa là mah jongg: một 5 Dot lẻ."
          }
        }
      }
    },
    "You call a discard for a pung. What comes next?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du rufst einen Abwurf für einen Pung. Was kommt als Nächstes?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantas un descarte para un pung. ¿Qué sigue?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous appelez une défausse pour un pung. Que se passe-t-il ensuite ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memanggil buangan untuk pung. Apa selanjutnya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn hô một quân bỏ để tạo pung. Tiếp theo là gì?"
          }
        }
      }
    },
    "You call a discard to complete a pung, kong or quint that you then expose, or to finish your hand. You cannot call for a pair or a single unless it is your winning tile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du rufst einen Abwurf, um einen Pung, Kong oder Quint zu vervollständigen und dann offen auszulegen, oder um Mah Jongg zu machen. Für ein Paar oder einen Einzelstein darfst du nur rufen, wenn der Abwurf dein Gewinnstein ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantas un descarte para completar un pung, kong o quint que luego expones, o para terminar tu mano. No puedes cantar para una pareja ni una ficha suelta, salvo que sea tu ficha ganadora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous appelez une défausse pour compléter un pung, un kong ou un quint que vous exposez ensuite, ou pour finir votre main. Vous ne pouvez pas appeler pour une paire ou une tuile isolée, sauf si c'est votre tuile gagnante."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memanggil buangan untuk melengkapi pung, kong, atau quint yang lalu kamu ekspos, atau untuk menyelesaikan tanganmu. Kamu tidak bisa memanggil untuk pasangan atau ubin tunggal kecuali itu ubin kemenanganmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn hô một quân bỏ để hoàn thành pung, kong hoặc quint rồi để lộ, hoặc để hoàn thành bộ bài. Bạn không thể hô cho đôi hay quân lẻ trừ khi đó là quân thắng."
          }
        }
      }
    },
    "You call a discard to complete a pung. What happens to those tiles?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du rufst einen Abwurf, um einen Pung zu vollenden. Was passiert mit diesen Steinen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantas un descarte para completar un pung. ¿Qué pasa con esas fichas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous appelez une défausse pour compléter un pung. Que deviennent ces tuiles ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memanggil buangan untuk melengkapi pung. Apa yang terjadi pada ubin-ubin itu?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn hô một quân bỏ để hoàn thành pung. Những quân đó sẽ ra sao?"
          }
        }
      }
    },
    "You call mah jongg, lay your hand down, and it turns out one tile is wrong. What happens?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du rufst Mah Jongg und legst deine Hand offen aus, aber ein Stein ist falsch. Was passiert?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cantas mah jongg, muestras tu mano y resulta que una ficha está mal. ¿Qué pasa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous annoncez mah jongg, posez votre main, et une tuile se révèle fausse. Que se passe-t-il ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memanggil mah jongg, membuka susunan ubinmu, lalu ternyata ada satu ubin yang salah. Apa yang terjadi?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn hô mah jongg, đặt bài xuống rồi phát hiện có một quân không đúng. Chuyện gì xảy ra?"
          }
        }
      }
    },
    "You can call a discard for a pung, a kong or a quint, as long as you expose the whole group. Pairs and singles are the ones you can only call to win.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst einen Abwurf für einen Pung, Kong oder Quint rufen, solange du die ganze Gruppe auslegst. Einen Abwurf für ein Paar oder einen Einzelstein darfst du nur rufen, wenn du damit Mah Jongg machst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cantar un descarte para un pung, un kong o un quint, siempre que expongas el grupo completo. Las parejas y las fichas sueltas solo se pueden cantar para ganar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez appeler une défausse pour compléter un pung, un kong ou un quint, à condition d'exposer tout le groupe. On ne peut appeler une défausse pour compléter une paire ou une tuile isolée que si elle permet de gagner."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa memanggil buangan untuk pung, kong, atau quint, asalkan kamu mengekspos seluruh kelompoknya. Pasangan dan ubin tunggal hanya bisa dipanggil untuk menang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể hô quân bỏ để lập pung, kong hoặc quint, miễn là để lộ cả nhóm. Chỉ được hô đôi hoặc quân lẻ khi đó là quân giúp bạn thắng."
          }
        }
      }
    },
    "You can call that discard for an exposed pung.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diesen Abwurf für einen Pung rufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cantar ese descarte para un pung expuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez appeler cette défausse pour un pung exposé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa memanggil buangan itu untuk pung yang diekspos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể hô quân bỏ đó để lập pung đã lộ."
          }
        }
      }
    },
    "You can only call a discard, never another player's exposure.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nur einen Abwurf rufen, nie die Auslage eines anderen Spielers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes cantar un descarte, nunca la exposición de otro jugador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez appeler qu'une défausse, jamais l'exposition d'un autre joueur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu hanya boleh memanggil buangan, bukan mengambil ubin dari ekspos pemain lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ được hô quân bỏ, không thể lấy bộ đã lộ của người khác."
          }
        }
      }
    },
    "You can redeem a joker from your own exposure, not just an opponent's. The 8 Crak goes on the pung, the joker comes back to your rack, and now it can fill a group you still need.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst einen Joker aus deiner eigenen Auslage einlösen, nicht nur aus der eines Gegners. Die 8 Crak ergänzt den Pung, der Joker kommt zurück auf dein Rack und kann nun eine Gruppe vervollständigen, die du noch brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes canjear un comodín de tu propia exposición, no solo el de un oponente. El 8 Crak va al pung, el comodín vuelve a tu atril y ahora puede completar un grupo que aún necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez récupérer un joker dans votre propre exposition, pas seulement celle d'un adversaire. Le 8 Crak va sur le pung, le joker revient sur votre chevalet et vous pouvez maintenant l'utiliser dans un groupe qu'il vous reste à compléter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa menebus joker dari eksposmu sendiri, bukan hanya milik lawan. 8 Crak masuk ke pung, joker kembali ke rakmu, dan sekarang ia bisa mengisi kelompok yang masih kamu butuhkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể lấy lại joker từ bộ đã lộ của chính mình, không chỉ từ bộ của đối thủ. Đặt 8 Crak vào pung, joker trở lại giá của bạn và có thể lấp vào một nhóm bạn còn thiếu."
          }
        }
      }
    },
    "You can see your hand can no longer win, but you are still drawing and discarding. An opponent with three exposures looks one tile away. What is the safest discard?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst, dass deine Hand nicht mehr gewinnen kann, ziehst und wirfst aber weiter ab. Ein Gegner mit drei Auslagen scheint nur noch einen Stein von Mah Jongg entfernt zu sein. Was ist der sicherste Abwurf?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves que tu mano ya no puede ganar, pero sigues robando y descartando. Un oponente con tres exposiciones parece estar a una ficha de ganar. ¿Cuál es el descarte más seguro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez que votre main ne peut plus gagner, mais vous piochez et défaussez encore. Un adversaire a trois expositions et semble n'avoir plus qu'une tuile à trouver pour gagner. Quelle est la défausse la plus sûre ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa melihat tanganmu sudah tidak mungkin menang, tapi kamu masih mengambil dan membuang ubin. Lawan dengan tiga ekspos tampaknya hanya butuh satu ubin lagi untuk mah jongg. Apa ubin paling aman untuk dibuang?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn biết bộ bài của mình không còn khả năng thắng, nhưng vẫn đang bốc rồi bỏ quân. Một đối thủ có ba bộ đã lộ có vẻ chỉ còn thiếu một quân. Quân nào an toàn nhất để bỏ?"
          }
        }
      }
    },
    "You deal the next hand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du teilst die nächste Hand aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartes la siguiente mano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous distribuez la main suivante"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membagikan ubin untuk ronde berikutnya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chia ván tiếp theo"
          }
        }
      }
    },
    "You discard a 4 Bam and two opponents both call it for a pung at the same moment. Neither is going out. Who gets it?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirfst eine 4 Bam ab, und zwei Gegner rufen sie gleichzeitig für einen Pung. Keiner von beiden ruft Mah Jongg. Wer bekommt sie?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartas un 4 Bam y dos oponentes lo cantan a la vez para un pung. Ninguno canta mah jongg. ¿Quién se lo queda?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous défaussez un 4 Bam et deux adversaires l'appellent en même temps pour un pung. Aucun ne gagne. Qui l'obtient ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membuang 4 Bam dan dua lawan sama-sama memanggilnya untuk pung di saat yang sama. Tidak ada yang menang. Siapa yang mendapatkannya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bỏ một quân 4 Bam, hai đối thủ cùng lúc hô pung cho quân đó. Không ai hô mah jongg. Ai được lấy quân?"
          }
        }
      }
    },
    "You discard a 7 Crak. One player calls it for a pung and another calls it for mah jongg. Who gets it?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirfst eine 7 Crak ab. Ein Spieler ruft sie für einen Pung, ein anderer für Mah Jongg. Wer bekommt sie?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartas un 7 Crak. Un jugador lo canta para un pung y otro para mah jongg. ¿Quién se lo queda?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous défaussez un 7 Crak. Un joueur l'appelle pour un pung et un autre pour mah jongg. Qui l'obtient ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu membuang 7 Crak. Satu pemain memanggilnya untuk pung dan pemain lain memanggilnya untuk mah jongg. Siapa yang mendapatkannya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bỏ một quân 7 Crak. Một người hô pung cho quân đó, người kia hô mah jongg. Ai được lấy quân?"
          }
        }
      }
    },
    "You draw 3 Bam. Keep or throw?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ziehst 3 Bam. Behalten oder abwerfen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robas un 3 Bam. ¿Lo guardas o lo tiras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
