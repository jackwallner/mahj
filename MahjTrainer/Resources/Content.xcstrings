        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada, los comodines expuestos están congelados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien, les jokers exposés sont figés"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada, joker yang diekspos terkunci"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần làm gì, joker đã lộ thì không thể đổi."
          }
        }
      }
    },
    "Nothing, just decoration": {
      "extractionState": "manual",
      "localizations": {
        "de": {
