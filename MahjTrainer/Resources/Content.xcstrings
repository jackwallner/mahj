            "value": "Celui qui appelle mah jongg"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemanggil mah jongg"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người hô mah jongg"
          }
        }
      }
    },
    "The mirror of the evens family, with five numbers to build from instead of four.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiegelbild der geraden Familie, mit fünf Zahlen zum Bauen statt vier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espejo de la familia de pares, con cinco números para construir en lugar de cuatro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le miroir de la famille des pairs, avec cinq chiffres pour construire au lieu de quatre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cermin dari keluarga genap, dengan lima angka untuk dibangun, bukan empat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh phản chiếu của họ chẵn, với năm số để xây thay vì bốn."
          }
        }
      }
    },
    "The no-joker zone": {
