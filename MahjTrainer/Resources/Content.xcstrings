          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne dit qu'il manque de Dot. Les Crak sont la famille qu'il continue de lâcher."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menunjukkan mereka kekurangan Dot. Crak adalah jenis yang terus mereka lepas."
          }
