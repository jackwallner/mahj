    "Throwing a tile does not stop you winning later, as long as your hand can still be made.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Stein abzuwerfen hindert dich nicht am späteren Gewinn, solange deine Hand noch möglich ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar una ficha no te impide ganar después, mientras tu mano aún pueda completarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser une tuile ne vous empêche pas de gagner plus tard, tant que votre main peut encore être complétée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang ubin tidak menghalangimu menang nanti, selama tanganmu masih bisa dilengkapi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ một quân không ngăn bạn thắng sau đó, miễn là bạn vẫn có thể hoàn thành bộ bài."
          }
        }
      }
    },
    "Throwing the tiles least likely to finish anyone else's hand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steine abwerfen, mit denen wahrscheinlich niemand seine Hand vervollständigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar las fichas con menos probabilidad de completar la mano de otro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser les tuiles les moins susceptibles de compléter la main d'un autre joueur"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang ubin yang paling kecil kemungkinannya menyelesaikan tangan orang lain"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ những quân ít có khả năng hoàn thành bài của người khác nhất"
          }
        }
      }
    },
    "Throwing the winning tile costs double. The other two players pay the value printed beside the hand on the card.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Gewinnstein abzuwerfen kostet das Doppelte. Die beiden anderen Spieler zahlen den Wert, der auf der Karte neben der Hand steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar la ficha ganadora cuesta el doble. Los otros dos jugadores pagan el valor impreso junto a la mano en la tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser la tuile gagnante coûte le double. Les deux autres joueurs paient la valeur imprimée à côté de la main sur la carte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemain yang membuang ubin kemenangan membayar dua kali lipat. Dua pemain lain membayar sesuai nilai yang tercetak di samping pola itu pada kartu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người bỏ quân thắng phải trả gấp đôi. Hai người còn lại trả số điểm ghi cạnh bộ bài trên thẻ."
          }
        }
      }
    },
    "Throwing whatever you draw ignores which tiles are dangerous.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer einfach den gezogenen Stein abwirft, achtet nicht darauf, welche Steine gefährlich sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si descartas siempre lo que robas, pasas por alto qué fichas son peligrosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser systématiquement la tuile que vous venez de piocher, c'est ignorer quelles tuiles sont dangereuses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau kamu selalu membuang ubin yang baru diambil, kamu tidak mempertimbangkan ubin mana yang berbahaya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cứ bốc được gì bỏ nấy là bạn sẽ bỏ qua việc xem quân nào đang nguy hiểm."
          }
        }
      }
    },
    "Throwing whatever you just drew": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwerfen, was du gerade gezogen hast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirar lo que acabas de robar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser la tuile que vous venez de piocher"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang apa pun yang baru kamu ambil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ bất cứ quân nào vừa bốc"
          }
        }
      }
    },
    "Tile Check": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steincheck"
          }
