    "Second Charleston, the LAST pass, going RIGHT. You are all-in on evens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, der LETZTE Pass, nach RECHTS. Du setzt voll auf gerade Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundo Charleston, el ÚLTIMO pase, a la DERECHA. Vas con todo a los pares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Second Charleston, DERNIÈRE passe, vers la DROITE. Vous jouez tout sur les pairs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston kedua, operan TERAKHIR, ke KANAN. Kamu all-in di genap."
