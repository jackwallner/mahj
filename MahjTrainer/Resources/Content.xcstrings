    "Exposures already down make no difference to who gets a tile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits ausgelegte Gruppen ändern nichts daran, wer einen Stein bekommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exposiciones ya bajadas no influyen en quién se queda una ficha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les expositions déjà posées ne changent rien à qui obtient une tuile."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspos yang sudah ada tidak berpengaruh pada siapa yang mendapat ubin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân lộ đã đặt xuống không ảnh hưởng ai được quân."
          }
        }
      }
    },
    "Find the stretch your numbers share, then pass what falls outside it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde den Abschnitt, den deine Zahlen teilen, und gib ab, was außerhalb liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra el tramo que comparten tus números y pasa lo que cae fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez la plage que partagent vos chiffres, puis passez ce qui tombe en dehors."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan rentang yang dibagi angkamu, lalu operkan yang di luarnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm đoạn mà các số của bạn chung nhau, rồi chuyền những gì ngoài đoạn đó."
          }
        }
      }
    },
