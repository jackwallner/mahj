            "state": "translated",
            "value": "Operan Sopan Santun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt chuyền xã giao"
          }
        }
      }
    },
    "Courtesy hand": {
      "extractionState": "manual",
      "localizations": {
