          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Main de courtoisie"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangan sopan santun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài xã giao"
          }
        }
      }
    },
    "Courtesy pass": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höflichkeitspass"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pase de cortesía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe de courtoisie"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operan sopan santun"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt chuyền xã giao"
          }
        }
      }
    },
    "Courtesy pass, 3 tiles across. You are locked into 369.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höflichkeitspass, 3 Steine gegenüber. Du bist auf 369 festgelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pase de cortesía, 3 fichas al frente. Estás fijo en 369."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe de courtoisie, 3 tuiles en face. Vous êtes engagé dans 369."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operan sopan santun, 3 ubin ke seberang. Kamu terkunci di 369."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt chuyền xã giao, 3 quân sang đối diện. Bạn đã chốt 369."
          }
        }
      }
    },
    "Courtesy pass, 3 tiles across. You are locked into 369. Pick 3.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höflichkeitspass, 3 Steine gegenüber. Du bist auf 369 festgelegt. Wähl 3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pase de cortesía, 3 fichas al frente. Estás fijo en 369. Elige 3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe de courtoisie, 3 tuiles en face. Vous êtes engagé dans 369. Choisissez 3 tuiles."
          }
