          }
        }
      }
    },
    "North wind": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nord"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Viento Norte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vent du Nord"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angin Utara"
          }
        },
        "vi": {
