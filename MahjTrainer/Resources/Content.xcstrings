    "Honors are stacking up and the numbers are scattered. First pass, three tiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehrensteine häufen sich und die Zahlen sind verstreut. Erster Pass, drei Steine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los honores se acumulan y los números están dispersos. Primer pase, tres fichas."
          }
        },
        "fr": {
          "stringUnit": {
