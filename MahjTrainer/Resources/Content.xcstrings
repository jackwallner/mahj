            "value": "Des dragons obligatoires"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naga wajib"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt buộc có rồng"
          }
        }
      }
    },
    "Draw and hope your own hand comes together": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen und hoffen, dass deine eigene Hand zusammenkommt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar y esperar que tu mano se arme"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher et espérer que votre main se complète"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil dan berharap tanganmu akhirnya menyatu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốc bài và hy vọng bộ bài của bạn thành"
          }
        }
      }
    },
    "Draw from the wall, then discard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Mauer ziehen, dann abwerfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar del muro y luego descartar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher dans le mur, puis défausser"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil dari dinding, lalu buang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốc từ tường, rồi bỏ"
          }
        }
      }
    },
    "Drawing toward your own hand anyway": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem auf deine eigene Hand ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robar hacia tu propia mano de todos modos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piocher quand même vers votre main"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap mengambil menuju tanganmu sendiri"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn bốc theo hướng bộ bài của mình"
          }
        }
      }
    },
    "During the first round": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der ersten Runde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la primera ronda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant le premier tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di putaran pertama"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong vòng đầu tiên"
          }
        }
      }
    },
    "Each hand on the card is marked X or C. What does C mean?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Hand auf der Karte ist mit X oder C markiert. Was bedeutet C?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mano de la tarjeta está marcada con X o C. ¿Qué significa C?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque main de la carte est marquée X ou C. Que signifie C ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tangan di kartu bertanda X atau C. Apa arti C?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bộ bài trên thẻ được đánh dấu X hoặc C. C nghĩa là gì?"
          }
        }
      }
    },
    "Early in the game, you must throw a flower or a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh im Spiel musst du eine Blume oder einen einzelnen Wind abwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al principio de la partida, debes tirar una flor o un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début de la partie, vous devez jeter une fleur ou un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di awal permainan, kamu harus membuang bunga atau angin yang sendirian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ván, bạn phải bỏ một hoa hoặc một quân gió lẻ."
          }
        }
      }
    },
    "Early in the hand, nobody has exposed anything. Which discard is safest?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh in der Hand hat niemand etwas ausgelegt. Welcher Abwurf ist am sichersten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al principio de la mano, nadie ha expuesto nada. ¿Qué descarte es el más seguro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début de la manche, personne n'a rien exposé. Quelle défausse est la plus sûre ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di awal tangan, belum ada yang mengekspos apa pun. Buangan mana yang paling aman?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ván, chưa ai để lộ gì. Quân bỏ nào an toàn nhất?"
          }
        }
      }
    },
    "Early in the hand, you hold N N and draw a third North.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Früh in der Hand hältst du N N und ziehst einen dritten Nord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al principio de la mano, tienes N N y robas un tercer Norte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au début de la manche, vous avez N N et vous piochez un troisième Nord."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di awal permainan, kamu memegang U U dan mengambil Utara ketiga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ván, bạn có N N và bốc được quân Bắc thứ ba."
          }
        }
      }
    },
    "Early passes are about narrowing, not deciding. Keep the majority and let the Charleston tell you the rest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühe Pässe grenzen ein, sie entscheiden nicht. Behalte die Mehrheit und lass den Charleston den Rest zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los primeros pases sirven para acotar, no para decidir. Quédate con la mayoría y deja que el Charleston te cuente el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les premières passes servent à resserrer, pas à décider. Gardez la majorité et laissez le Charleston vous dire le reste."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operan awal soal mempersempit, bukan memutuskan. Pertahankan mayoritas dan biarkan Charleston memberi tahu sisanya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lượt chuyền đầu là để thu hẹp, không phải để quyết định. Hãy giữ phần đa số và để Charleston nói cho bạn phần còn lại."
          }
        }
      }
    },
    "East": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Est"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Timur"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đông"
          }
        }
      }
    },
    "Eight": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám"
          }
        }
      }
    },
    "Eight 1s, spread over all three suits. When one number turns up in every suit like this, Like Numbers is the read. The 4 Dot is the one number that does not fit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 1er, über alle drei Farben verteilt. Taucht eine Zahl so in jeder Farbe auf, ist es Gleiche Zahlen. Die 4 Dot ist die eine Zahl, die nicht passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho 1, repartidos en los tres palos. Cuando un número aparece en todos los palos así, la lectura es Números iguales. El 4 Dot es el único número que no encaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit 1, répartis dans les trois familles. Quand un même chiffre apparaît dans chaque famille ainsi, la lecture est Nombres identiques. Le 4 Dot est le seul chiffre qui ne cadre pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 1, tersebar di ketiga jenis. Kalau satu angka muncul di setiap jenis seperti ini, bacaannya Angka Sama. 4 Dot adalah satu-satunya angka yang tidak cocok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 1, rải ở cả ba chất. Khi một số xuất hiện ở mọi chất như vậy, đây là Số giống nhau. 4 Dot là quân số duy nhất không hợp."
          }
        }
      }
    },
    "Eight 2s across the three suits. When a rack is mostly one number in every suit, Like Numbers is the read. The 9 Dot is the one number that does not fit, and the North is a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 2er in den drei Farben. Besteht ein Rack überwiegend aus einer Zahl in jeder Farbe, ist es Gleiche Zahlen. Die 9 Dot ist die eine Zahl, die nicht passt, und der Nord ist ein einzelner Wind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho 2 en los tres palos. Cuando un atril es casi todo un mismo número en cada palo, la lectura es Números iguales. El 9 Dot es el único número que no encaja, y el Norte es un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit 2 dans les trois familles. Quand un chevalet est surtout un seul chiffre dans chaque famille, la lecture est Nombres identiques. Le 9 Dot est le seul chiffre qui ne cadre pas, et le Nord est un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 2 di ketiga jenis. Kalau rak kebanyakan satu angka di setiap jenis, bacaannya Angka Sama. 9 Dot satu-satunya angka yang tidak cocok, dan Utara adalah angin sendirian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 2 ở ba chất. Khi giá phần lớn là một số ở mọi chất, đây là Số giống nhau. 9 Dot là quân số duy nhất không hợp, và quân Bắc là gió lẻ."
          }
        }
      }
    },
    "Eight 4s in three suits. Like Numbers is built on one number repeated across suits, and this rack is mostly one number. The 7 Crak, the Red Dragon and the West Wind are the strays.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 4er in drei Farben. Gleiche Zahlen baut auf einer Zahl, die sich über Farben wiederholt, und dieses Rack ist überwiegend eine Zahl. Die 7 Crak, der Rote Drache und der West sind die Ausreißer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho 4 en tres palos. Números iguales se construye sobre un número repetido en varios palos, y este atril es casi todo un mismo número. El 7 Crak, el Dragón Rojo y el Viento Oeste son las sueltas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit 4 dans trois familles. Nombres identiques repose sur un chiffre répété d'une famille à l'autre, et ce chevalet est surtout un seul chiffre. Le 7 Crak, le Dragon Rouge et le vent d'Ouest sont les tuiles isolées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 4 di tiga jenis. Angka Sama dibangun dari satu angka yang diulang di berbagai jenis, dan rak ini kebanyakan satu angka. 7 Crak, Naga Merah, dan Angin Barat adalah ubin nyasar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 4 ở ba chất. Số giống nhau được xây trên một số lặp lại qua các chất, và giá này phần lớn là một số. 7 Crak, Rồng Đỏ và gió Tây là quân lạc loài."
          }
        }
      }
    },
    "Eight 8s spread across all three suits, with a joker to help. That is the Like Numbers shape. The 3 Bam and 5 Dot are the numbers that do not fit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 8er in allen drei Farben, dazu ein Joker. Das ist die Form von Gleiche Zahlen. Die 3 Bam und die 5 Dot sind die Zahlen, die nicht passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho 8 repartidos en los tres palos, con un comodín de ayuda. Esa es la forma de Números iguales. El 3 Bam y el 5 Dot son los números que no encajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit 8 répartis dans les trois familles, avec un joker pour aider. C'est la forme Nombres identiques. Le 3 Bam et le 5 Dot sont les chiffres qui ne cadrent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 8 tersebar di ketiga jenis, dengan joker sebagai bantuan. Itu bentuk Angka Sama. 3 Bam dan 5 Dot adalah angka yang tidak cocok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 8 rải ở cả ba chất, có một joker hỗ trợ. Đó là hình dạng của Số giống nhau. 3 Bam và 5 Dot là hai quân số không hợp."
          }
        }
      }
    },
    "Eight 9s across Craks, Bams and Dots. One number filling every suit is the Like Numbers shape. The 4 Crak is the one number that does not fit, and the North is a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht 9er in Crak, Bam und Dot. Eine Zahl, die jede Farbe füllt, ist die Form von Gleiche Zahlen. Die 4 Crak ist die eine Zahl, die nicht passt, und der Nord ist ein einzelner Wind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho 9 en Crak, Bam y Dot. Un número que llena todos los palos es la forma de Números iguales. El 4 Crak es el único número que no encaja, y el Norte es un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit 9 en Crak, Bam et Dot. Un seul chiffre qui remplit chaque famille, c'est la forme Nombres identiques. Le 4 Crak est le seul chiffre qui ne cadre pas, et le Nord est un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka 9 di Crak, Bam, dan Dot. Satu angka memenuhi setiap jenis adalah bentuk Angka Sama. 4 Crak satu-satunya angka yang tidak cocok, dan Utara adalah angin sendirian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 9 ở Crak, Bam và Dot. Một số lấp đầy mọi chất là hình dạng của Số giống nhau. 4 Crak là quân số duy nhất không hợp, và quân Bắc là gió lẻ."
          }
        }
      }
    },
    "Eight evens across all three suits is a real 2468 spine. The two lonely winds do almost nothing for 2468, and the 3 Dot is your only odd number tile. Those three leave without a second thought.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht gerade Steine in allen drei Farben sind ein echtes 2468-Rückgrat. Die zwei einsamen Winde bringen 2468 fast nichts, und die 3 Dot ist dein einziger ungerader Zahlenstein. Diese drei gehen ohne langes Überlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho pares en los tres palos son una verdadera columna vertebral de 2468. Los dos vientos solitarios casi no sirven a 2468, y el 3 Dot es tu única ficha numérica impar. Esas tres se van sin pensarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit pairs répartis sur les trois familles forment une vraie colonne vertébrale 2468. Les deux vents isolés n'aident presque pas 2468, et le 3 Dot est votre seule tuile impaire. Ces trois-là partent sans hésiter."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan genap di ketiga jenis adalah tulang punggung 2468 yang nyata. Dua angin yang sendirian hampir tidak berguna untuk 2468, dan 3 Dot adalah satu-satunya ubin angka ganjilmu. Ketiganya pergi tanpa pikir panjang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân chẵn ở cả ba chất là xương sống thật của 2468. Hai quân gió lẻ gần như không giúp gì cho 2468, và 3 Dot là quân số lẻ duy nhất. Ba quân đó đi không cần nghĩ."
          }
        }
      }
    },
    "Eight fives across all three suits. When one number fills your rack like this, Any Like Numbers is the read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Fünfen in allen drei Farben. Wenn eine Zahl dein Rack so füllt, ist es Gleiche Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho cincos en los tres palos. Cuando un mismo número llena tu atril así, la lectura es Números iguales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit 5 dans les trois familles. Quand un seul chiffre remplit votre chevalet ainsi, la lecture est Nombres identiques."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angka lima di ketiga jenis. Kalau satu angka memenuhi rakmu seperti ini, bacaannya Angka Sama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân 5 ở cả ba chất. Khi một số chiếm đầy giá như vậy, đây là Số giống nhau."
          }
        }
      }
    },
    "Eight flower tiles come in the set, and for card purposes any flower can stand in for any other. They are never part of a numbered run. Wherever the card shows an F, any flower works.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Blumensteine gehören zum Set, und für die Karte kann jede Blume jede andere ersetzen. Sie sind nie Teil einer Zahlenfolge. Wo die Karte ein F zeigt, passt jede Blume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego trae ocho flores, y a efectos de la tarjeta cualquier flor puede sustituir a cualquier otra. Nunca forman parte de una escalera numérica. Donde la tarjeta muestra una F, vale cualquier flor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu contient huit fleurs, et pour la carte, n'importe quelle fleur peut remplacer n'importe quelle autre. Elles ne font jamais partie d'une suite numérotée. Partout où la carte montre un F, n'importe quelle fleur convient."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Set berisi delapan ubin bunga, dan untuk keperluan kartu, bunga mana pun bisa menggantikan bunga lain. Mereka tidak pernah jadi bagian urutan bernomor. Di mana pun kartu menampilkan F, bunga mana pun cocok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ có tám quân hoa, và với thẻ thì hoa nào cũng thay được hoa khác. Chúng không bao giờ thuộc một dãy số. Chỗ nào thẻ ghi F, hoa nào cũng được."
          }
        }
      }
    },
    "Eight flowers, and unlike suited tiles they are all interchangeable with each other.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Blumen, und anders als Farbsteine sind sie alle untereinander austauschbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho flores, y a diferencia de las fichas de palo, todas son intercambiables entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit fleurs, et contrairement aux tuiles de famille, elles sont toutes interchangeables."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan bunga, dan tidak seperti ubin berjenis, semuanya bisa saling menggantikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám hoa, và không như quân chất, chúng thay thế được cho nhau."
          }
        }
      }
    },
    "Eight jokers, and counting them helps. If you've seen 6 on racks and discards, only 2 are left in play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Joker, und Mitzählen hilft. Hast du 6 auf Racks und im Abwurf gesehen, sind nur noch 2 im Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho comodines, y contarlos ayuda. Si has visto 6 en atriles y descartes, solo quedan 2 en juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit jokers, et les compter aide. Si vous en avez vu 6 sur les chevalets et dans les défausses, il n'en reste que 2 en jeu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan joker, dan menghitungnya berguna. Kalau kamu sudah melihat 6 di rak dan buangan, hanya 2 yang tersisa dalam permainan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám joker, và đếm chúng rất có ích. Nếu bạn đã thấy 6 quân trên giá và đống bỏ, chỉ còn 2 quân trong ván."
          }
        }
      }
    },
    "Eight odd tiles and a pair of 5 Craks: this is a 13579 hand. The even Dots (2, 4, 6) are the passes. Do NOT ship the flowers to make the choice easier. Many sections want flowers, and passing one hands a neighbor a tile your own hand may need later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht ungerade Steine und ein Paar 5 Crak: Das ist eine 13579-Hand. Die geraden Dots (2, 4, 6) sind die Abgaben. Gib NICHT die Blumen ab, nur um dir die Wahl leichter zu machen. Viele Sektionen wollen Blumen, und eine abzugeben gibt einem Nachbarn einen Stein, den deine Hand später brauchen könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas impares y una pareja de 5 Crak: es una mano 13579. Los Dot pares (2, 4, 6) son los pases. NO mandes las flores para facilitar la decisión. Muchas secciones quieren flores, y pasar una le da a un vecino una ficha que tu propia mano quizá necesite después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles impaires et une paire de 5 Crak : c'est une main 13579. Les Dot pairs (2, 4, 6) sont les tuiles à passer. N'expédiez PAS les fleurs pour vous faciliter le choix. Beaucoup de sections veulent des fleurs, et en passer une donne à un voisin une tuile dont votre main pourrait avoir besoin plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan ubin ganjil dan sepasang 5 Crak: ini tangan 13579. Dot genap (2, 4, 6) yang dioperkan. JANGAN kirim bunga demi mempermudah pilihan. Banyak bagian menginginkan bunga, dan mengoperkannya memberi tetangga ubin yang mungkin dibutuhkan tanganmu nanti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân lẻ và một đôi 5 Crak: đây là bộ 13579. Các Dot chẵn (2, 4, 6) là quân để chuyền. ĐỪNG chuyền hoa cho dễ chọn. Nhiều nhóm cần hoa, và chuyền một quân là trao cho hàng xóm quân mà bộ bài của bạn có thể cần sau này."
          }
        }
      }
    },
    "Eight odd tiles with two pairs already: this hand wants 13579. The three even Dots serve nothing you are building, so they go together on the very first pass, before anyone has committed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht ungerade Steine mit schon zwei Paaren: Diese Hand will 13579. Die drei geraden Dots dienen nichts, was du baust, also gehen sie gleich im allerersten Pass zusammen weg, bevor sich jemand festgelegt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas impares con dos parejas ya: esta mano quiere 13579. Los tres Dot pares no sirven a nada de lo que armas, así que salen juntos en el primer pase, antes de que nadie se haya comprometido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles impaires dont deux paires : cette main veut 13579. Les trois Dot pairs ne servent à rien dans ce que vous construisez : ils partent ensemble dès la toute première passe, avant que quiconque se soit engagé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan ubin ganjil dengan dua pasangan: tangan ini menginginkan 13579. Tiga Dot genap tidak berguna bagi yang kamu susun, jadi ketiganya dioperkan bersama di operan pertama, sebelum ada yang berkomitmen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân lẻ và đã có hai đôi: bộ bài này muốn 13579. Ba quân Dot chẵn không phục vụ gì bạn đang xây, nên chuyền cùng nhau ở lượt đầu tiên, trước khi ai chốt."
          }
        }
      }
    },
    "Eight wild tiles. A joker can stand in for a tile inside a group of three or more (a pung, kong or quint). It can never be a pair, a single, or part of a Singles and Pairs hand, and it can never be passed in the Charleston.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Wildcard-Steine. Ein Joker kann in einer Gruppe aus drei oder mehr Steinen (Pung, Kong oder Quint) einen Stein ersetzen. Er kann nie ein Paar, ein Einzelstein oder Teil einer Singles-&-Paare-Hand sein und darf im Charleston nie abgegeben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho fichas comodín. Un comodín puede sustituir a una ficha dentro de un grupo de tres o más (pung, kong o quint). Nunca puede ser una pareja, una ficha suelta ni parte de una mano de Sueltas y Parejas, y nunca se puede pasar en el Charleston."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit tuiles joker. Un joker peut remplacer une tuile dans un groupe de trois ou plus (pung, kong ou quint). Il ne peut jamais être une paire, une tuile isolée ni faire partie d'une main Simples et Paires, et il ne peut jamais être passé au Charleston."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan ubin serba bisa. Joker bisa mewakili ubin dalam kelompok tiga atau lebih (pung, kong, atau quint). Ia tidak pernah bisa jadi pasangan, ubin tunggal, atau bagian tangan Tunggal dan Pasangan, dan tidak boleh dioperkan di Charleston."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân đa năng. Joker thay được một quân trong nhóm từ ba quân trở lên (pung, kong hoặc quint). Nó không bao giờ là đôi, quân lẻ, hay thuộc bộ Đơn & Đôi, và không bao giờ được chuyền trong Charleston."
          }
        }
      }
    },
    "Eight winds including a pung of Norths, plus two dragons, and only one number tile in the whole rack. The read is Winds & Dragons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Winde mit einem Pung Nord, dazu zwei Drachen und nur ein Zahlenstein im ganzen Rack. Das Blatt ist Winde & Drachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho vientos, incluido un pung de Nortes, más dos dragones y una sola ficha numérica en todo el atril. La lectura es Vientos y Dragones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit vents dont un pung de Nord, plus deux dragons, et une seule tuile chiffrée sur tout le chevalet. La lecture est Vents et Dragons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angin termasuk pung Utara, ditambah dua naga, dan hanya satu ubin angka di seluruh rak. Bacaannya Angin & Naga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân gió gồm một pung Bắc, thêm hai quân rồng, và cả giá chỉ có một quân số. Đây là Gió & Rồng."
          }
        }
      }
    },
    "Eight winds, a pung of Easts, and three dragons, with not one number tile on the rack. Any section built on numbers would be starting from nothing. Winds and Dragons it is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Acht Winde, ein Pung Ost und drei Drachen, aber kein einziger Zahlenstein auf dem Rack. Jede Sektion mit Zahlen würde bei null anfangen. Also Winde & Drachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocho vientos, un pung de Estes y tres dragones, sin una sola ficha numérica en el atril. Cualquier sección basada en números partiría de cero. Es Vientos y Dragones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit vents, un pung d'Est et trois dragons, sans une seule tuile chiffrée sur le chevalet. Toute section fondée sur les chiffres partirait de zéro. Ce sera Vents et Dragons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Delapan angin, pung Timur, dan tiga naga, tanpa satu pun ubin angka di rak. Bagian berbasis angka mana pun akan mulai dari nol. Jadi Angin dan Naga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tám quân gió, một pung Đông, và ba rồng, giá không có quân số nào. Nhóm nào xây trên số cũng phải bắt đầu từ con số không. Vậy là Gió & Rồng."
          }
        }
      }
    },
    "Eleven more racks, including the ones with a convincing decoy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elf weitere Racks, auch mit überzeugender Falle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Once atriles más, incluidos los que tienen un señuelo convincente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onze chevalets de plus, dont certains avec un leurre convaincant"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelas rak lagi, termasuk yang punya umpan meyakinkan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mười một giá, gồm cả những giá có mồi nhử đáng tin"
          }
        }
      }
    },
    "Even Dots from 2 to 8 with three pairs, plus a pair of 6 Craks: this is a 2468 rack. The 1 Bam and 3 Crak are odd and the North is a lone wind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade Dots von 2 bis 8 mit drei Paaren, dazu ein Paar 6 Crak: Das ist ein 2468-Rack. Die 1 Bam und 3 Crak sind ungerade, und der Nord ist ein einzelner Wind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dot pares del 2 al 8 con tres parejas, más una pareja de 6 Crak: este es un atril 2468. El 1 Bam y el 3 Crak son impares y el Norte es un viento suelto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des Dot pairs de 2 à 8 avec trois paires, plus une paire de 6 Crak : c'est un chevalet 2468. Le 1 Bam et le 3 Crak sont impairs et le Nord est un vent isolé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dot genap dari 2 sampai 8 dengan tiga pasang, ditambah pasangan 6 Crak: ini rak 2468. 1 Bam dan 3 Crak ganjil dan Utara adalah angin sendirian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dot chẵn từ 2 đến 8 với ba đôi, cùng đôi 6 Crak: đây là giá 2468. 1 Bam và 3 Crak lẻ và quân Bắc là gió lẻ."
          }
        }
      }
    },
    "Even numbers only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur gerade Zahlen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo números pares"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffres pairs uniquement"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya angka genap"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ số chẵn"
          }
        }
      }
    },
    "Even on their own turn, an exposure that is already down cannot take more tiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbst in seinem eigenen Zug kann eine schon ausgelegte Auslage keine weiteren Steine aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni siquiera en su propio turno, una exposición ya bajada puede tomar más fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même à son propre tour, une exposition déjà posée ne peut pas recevoir d'autres tuiles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahkan di giliran mereka sendiri, ekspos yang sudah ada tidak bisa menerima ubin lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kể cả vào lượt của họ, quân lộ đã đặt xuống không nhận thêm quân."
          }
        }
      }
    },
    "Evens in Craks edge out odds in Bams, with five tiles including a pair against four singles, so lean 2468. The two lone winds help neither plan, so both go now, with the 3 Bam to start letting the odds go. The other odd Bams can follow over later passes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade in Crak liegen knapp vor ungeraden in Bam: fünf Steine mit einem Paar gegen vier Einzelsteine, also tendiere zu 2468. Die zwei einzelnen Winde helfen keinem Plan und gehen jetzt weg, dazu die 3 Bam, um die ungeraden loszulassen. Die anderen ungeraden Bam können in späteren Pässen folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pares en Crak superan a los impares en Bam, con cinco fichas (una pareja incluida) frente a cuatro sueltas, así que inclínate por 2468. Los dos vientos sueltos no ayudan a ningún plan, así que salen ahora, junto con el 3 Bam para empezar a soltar los impares. Los demás Bam impares pueden seguir en los próximos pases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pairs en Crak devancent de peu les impairs en Bam : cinq tuiles dont une paire contre quatre tuiles isolées, donc penchez pour 2468. Les deux vents isolés n'aident aucun plan, ils partent donc tous les deux, avec le 3 Bam pour commencer à lâcher les impairs. Les autres Bam impairs pourront suivre aux passes suivantes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Genap di Crak sedikit mengungguli ganjil di Bam, dengan lima ubin termasuk sepasang melawan empat ubin tunggal, jadi condonglah ke 2468. Dua angin yang sendirian tidak membantu rencana mana pun, jadi keduanya dioperkan sekarang, bersama 3 Bam untuk mulai melepas yang ganjil. Bam ganjil lainnya bisa menyusul di operan berikutnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chẵn ở Crak nhỉnh hơn lẻ ở Bam, với năm quân gồm một đôi so với bốn quân lẻ, nên nghiêng về 2468. Hai quân gió lẻ không giúp kế hoạch nào, nên chuyền cả hai ngay, cùng 3 Bam để bắt đầu bỏ các quân lẻ. Các Bam lẻ còn lại có thể theo sau ở những lượt chuyền sau."
          }
        }
      }
    },
    "Every 2 Bam is face up in the discards, so none is left in the wall or in anyone's rack. Old discards can never be called back, and the hand goes on as normal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede 2 Bam liegt offen im Abwurf, es ist also keine mehr in der Mauer oder auf jemandes Rack. Alte Abwürfe können nie zurückgerufen werden, und die Hand läuft normal weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los 2 Bam están boca arriba en los descartes, así que no queda ninguno en el muro ni en el atril de nadie. Los descartes antiguos nunca se pueden volver a cantar, y la mano sigue con normalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque 2 Bam est face visible dans les défausses : il n'en reste donc ni dans le mur ni sur un chevalet. Les anciennes défausses ne peuvent jamais être rappelées, et la manche continue normalement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap 2 Bam menghadap atas di buangan, jadi tidak ada yang tersisa di dinding atau rak siapa pun. Buangan lama tidak pernah bisa dipanggil kembali, dan tangan berlanjut seperti biasa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi 2 Bam đều ngửa trong đống bỏ, nên không còn quân nào trong tường hay trên giá ai. Quân bỏ cũ không bao giờ hô lại được, và ván tiếp tục bình thường."
          }
        }
      }
    },
    "Every exposure has to belong to a real hand on the card. Once another player calls your hand dead and the exposure proves it, you stop drawing and discarding for the rest of the hand, and you still pay the winner. Check the card before you call.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Auslage muss zu einer echten Hand der Karte gehören. Erklärt ein anderer Spieler deine Hand für tot und die Auslage belegt es, ziehst und wirfst du für den Rest der Hand nicht mehr, und zahlst trotzdem dem Gewinner. Prüf die Karte, bevor du rufst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda exposición debe pertenecer a una mano real de la tarjeta. Cuando otro jugador declara muerta tu mano y la exposición lo demuestra, dejas de robar y descartar el resto de la mano, y aun así le pagas al ganador. Revisa la tarjeta antes de cantar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exposition doit appartenir à une vraie main de la carte. Quand un autre joueur déclare votre main morte et que l'exposition le prouve, vous cessez de piocher et de défausser jusqu'à la fin de la manche, et vous payez quand même le gagnant. Vérifiez la carte avant d'appeler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ekspos harus milik tangan nyata di kartu. Begitu pemain lain menyatakan tanganmu mati dan eksposnya membuktikannya, kamu berhenti mengambil dan membuang sampai tangan selesai, dan tetap membayar pemenang. Periksa kartu sebelum memanggil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quân lộ phải thuộc một bộ bài thật trên thẻ. Khi người khác tuyên bố bộ bài của bạn chết và quân lộ chứng minh điều đó, bạn ngừng bốc và bỏ bài đến hết ván, và vẫn trả người thắng. Hãy kiểm tra thẻ trước khi hô."
          }
        }
      }
    },
    "Every number is a 3, 6 or 9 except the stray 2 Bam. A pung of 6 Craks plus pairs of 9s gives the 369 section a solid start.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen sind 3, 6 oder 9, bis auf die einzelne 2 Bam. Ein Pung 6 Crak plus Paare von 9ern geben der Sektion 369 einen soliden Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números son 3, 6 o 9, salvo el 2 Bam suelto. Un pung de 6 Crak más parejas de 9 dan a la sección 369 un buen inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont des 3, 6 ou 9, sauf le 2 Bam isolé. Un pung de 6 Crak plus des paires de 9 donnent à la section 369 un bon départ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka adalah 3, 6, atau 9 kecuali 2 Bam yang nyasar. Pung 6 Crak ditambah pasangan 9 memberi bagian 369 awal yang kuat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số đều là 3, 6 hoặc 9 trừ quân 2 Bam lạc loài. Một pung 6 Crak cùng các đôi 9 là khởi đầu vững cho nhóm 369."
          }
        }
      }
    },
    "Every number is even: 2s, 4s, 6s and 8s across all three suits, with pungs of 2 Dots and 6 Bams. All evens is the 2468 pattern, and with no odd numbers between them they cannot step up as a run.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen sind gerade: 2er, 4er, 6er und 8er in allen drei Farben, mit Pungs 2 Dot und 6 Bam. Alles gerade ist das Muster 2468, und ohne ungerade Zahlen dazwischen können sie keine Folge bilden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números son pares: 2, 4, 6 y 8 en los tres palos, con pungs de 2 Dot y 6 Bam. Todo pares es el patrón 2468, y sin números impares entre ellos no pueden formar una escalera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont pairs : 2, 4, 6 et 8 dans les trois familles, avec des pungs de 2 Dot et de 6 Bam. Tout pair, c'est le schéma 2468, et sans chiffre impair entre eux, ils ne peuvent pas former une suite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka genap: 2, 4, 6, dan 8 di ketiga jenis, dengan pung 2 Dot dan 6 Bam. Semua genap adalah pola 2468, dan tanpa angka ganjil di antaranya, tidak bisa naik sebagai urutan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số đều chẵn: 2, 4, 6 và 8 ở cả ba chất, với pung 2 Dot và 6 Bam. Toàn chẵn là mẫu 2468, và không có số lẻ xen giữa nên chúng không thể nối thành dãy."
          }
        }
      }
    },
    "Every number is odd except one stray 2 Dot. Three pairs of odd bams is a solid 13579 start. The 2 Dot and the lone wind are your first passes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen sind ungerade, bis auf eine einzelne 2 Dot. Drei Paare ungerader Bam sind ein solider Start für 13579. Die 2 Dot und der einzelne Wind sind deine ersten Abgaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números son impares salvo un 2 Dot suelto. Tres parejas de Bam impares son un buen inicio para 13579. El 2 Dot y el viento suelto son tus primeros pases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont impairs, sauf un 2 Dot isolé. Trois paires de Bam impairs forment un bon début en 13579. Le 2 Dot et le vent isolé sont vos premières tuiles à passer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka ganjil kecuali satu 2 Dot yang nyasar. Tiga pasang Bam ganjil adalah awal 13579 yang kuat. 2 Dot dan angin yang sendirian adalah operan pertamamu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số đều lẻ trừ một quân 2 Dot lạc loài. Ba đôi Bam lẻ là khởi đầu vững cho 13579. Quân 2 Dot và quân gió lẻ là hai quân chuyền đầu tiên."
          }
        }
      }
    },
    "Every number on this rack is even, with not an odd tile in sight, so 2468 is the read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlen auf diesem Rack sind gerade, kein ungerader Stein in Sicht, also ist es 2468."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números de este atril son pares, sin una sola ficha impar a la vista, así que la lectura es 2468."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres de ce chevalet sont pairs, sans une seule tuile impaire : la lecture est 2468."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka di rak ini genap, tidak ada ubin ganjil sama sekali, jadi bacaannya 2468."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số trên giá này đều chẵn, không có quân lẻ nào, nên đây là 2468."
          }
        }
      }
    },
    "Every number tile is even, from 2s to 8s across the suits. The flowers and the joker point nowhere else, so the numbers decide and the read is 2468.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlensteine sind gerade, von 2 bis 8 in allen Farben. Blumen und Joker deuten nirgends sonst hin, die Zahlen entscheiden also: 2468."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fichas numéricas son pares, del 2 al 8 en los distintos palos. Las flores y el comodín no apuntan a otro lado, así que mandan los números y la lectura es 2468."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont pairs, du 2 au 8, dans les trois familles. Les fleurs et le joker n'indiquent rien d'autre : ce sont les chiffres qui décident, et la lecture est 2468."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ubin angka genap, dari 2 sampai 8 di berbagai jenis. Bunga dan joker tidak mengarah ke tempat lain, jadi angkalah yang menentukan: bacaannya 2468."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quân số đều chẵn, từ 2 đến 8 ở các chất. Hoa và joker không chỉ hướng nào khác, nên các số quyết định và đây là 2468."
          }
        }
      }
    },
    "Every number tile is odd: 1s, 3s, 5s, 7s, 9s, with a pung of 3 Craks in hand. The flowers and the joker do not point anywhere else, so the numbers decide: this is a 13579 rack.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Zahlensteine sind ungerade: 1er, 3er, 5er, 7er, 9er, dazu ein Pung 3 Crak. Blumen und Joker deuten nirgends sonst hin, die Zahlen entscheiden also: ein 13579-Rack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fichas numéricas son impares: 1, 3, 5, 7, 9, con un pung de 3 Crak en la mano. Las flores y el comodín no apuntan a otro lado, así que deciden los números: es un atril 13579."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les chiffres sont impairs : 1, 3, 5, 7, 9, avec un pung de 3 Crak. Les fleurs et le joker n'indiquent rien d'autre, ce sont donc les chiffres qui décident : c'est un chevalet 13579."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ubin angka ganjil: 1, 3, 5, 7, 9, dengan pung 3 Crak di tangan. Bunga dan joker tidak mengarah ke tempat lain, jadi angkalah yang menentukan: ini rak 13579."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quân số đều lẻ: 1, 3, 5, 7, 9, với một pung 3 Crak trong tay. Hoa và joker không chỉ hướng nào khác, nên các số quyết định: đây là giá 13579."
          }
        }
      }
    },
    "Every odd tile you pick up is dead weight. If half your rack is odd after the Charleston, you are in the wrong section.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder ungerade Stein, den du aufnimmst, ist Ballast. Ist nach dem Charleston die Hälfte deines Racks ungerade, bist du in der falschen Sektion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ficha impar que recoges es lastre. Si la mitad de tu atril es impar después del Charleston, estás en la sección equivocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque tuile impaire que vous ramassez est du poids mort. Si la moitié de votre chevalet est impaire après le Charleston, vous êtes dans la mauvaise section."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ubin ganjil yang kamu ambil adalah beban. Kalau separuh rakmu ganjil setelah Charleston, kamu salah bagian."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi quân lẻ bạn nhặt là gánh nặng. Nếu một nửa giá của bạn là số lẻ sau Charleston, bạn đang ở sai nhóm."
          }
        }
      }
    },
    "Every other player just had the chance to take that exact tile and passed. Following a fresh discard is a classic safe throw. It is not a guarantee: one draw can change a hand, so it is safest right away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen Spieler hatten gerade die Chance, genau diesen Stein zu nehmen, und haben verzichtet. Einem frischen Abwurf zu folgen, ist ein klassischer sicherer Wurf. Eine Garantie ist es nicht: Ein Zug kann eine Hand ändern, am sichersten ist es also sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los demás jugadores acaban de tener la oportunidad de tomar esa ficha exacta y la dejaron pasar. Seguir un descarte reciente es un clásico descarte seguro. No es una garantía: un robo puede cambiar una mano, así que es más seguro de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres joueurs viennent d'avoir la chance de prendre cette tuile exacte et ont laissé passer. Suivre une défausse fraîche est une défausse sûre classique. Ce n'est pas une garantie : une pioche peut changer une main, c'est donc le plus sûr tout de suite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua pemain lain baru saja punya kesempatan mengambil ubin persis itu dan melewatkannya. Mengikuti buangan yang baru adalah buangan aman yang klasik. Tidak dijamin: satu ambilan bisa mengubah tangan, jadi paling aman kalau langsung."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người chơi khác vừa có cơ hội lấy đúng quân đó và đã bỏ qua. Bỏ theo quân vừa bị bỏ là nước đi an toàn kinh điển. Không phải đảm bảo: một lần bốc có thể đổi bộ bài, nên an toàn nhất là bỏ ngay."
          }
        }
      }
    },
    "Every player races to build a 14-tile hand that exactly matches one of the hands printed on the yearly card. Thirteen tiles live on your rack; the fourteenth is the tile you draw or call that completes the pattern. Complete it first and you call mahj.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Spieler wetteifern darum, eine Hand aus 14 Steinen zu bauen, die genau zu einer der Hände auf der Jahreskarte passt. Dreizehn Steine liegen auf deinem Rack, der vierzehnte ist der Stein, den du ziehst oder rufst und der das Muster vollendet. Wer zuerst fertig ist, ruft Mahj."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los jugadores corren por armar una mano de 14 fichas que coincida exactamente con una de las manos impresas en la tarjeta anual. Trece fichas están en tu atril; la decimocuarta es la que robas o cantas para completar el patrón. Quien la complete primero canta mahj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque joueur s'efforce de bâtir une main de 14 tuiles qui correspond exactement à l'une des mains imprimées sur la carte de l'année. Treize tuiles sont sur votre chevalet ; la quatorzième est la tuile que vous piochez ou appelez pour compléter le schéma. Complétez-le le premier et vous annoncez mahj."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pemain berlomba menyusun tangan 14 ubin yang persis cocok dengan salah satu tangan yang tercetak di kartu tahunan. Tiga belas ubin ada di rakmu; yang keempat belas adalah ubin yang kamu ambil atau panggil untuk melengkapi pola. Selesaikan lebih dulu dan kamu memanggil mahj."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người chạy đua để xây bộ 14 quân khớp chính xác một bộ bài in trên thẻ hằng năm. Mười ba quân nằm trên giá; quân thứ mười bốn là quân bạn bốc hoặc hô để hoàn thành mẫu. Hoàn thành trước và bạn hô mahj."
          }
        }
      }
    },
    "Everyone holds thirteen between turns. Nine are showing in the three pungs, so only four are hidden, and those four plus one more tile make the hand. The fewer tiles hidden, the easier they are to read and the closer they usually are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen den Zügen hält jeder dreizehn. Neun liegen in den drei Pungs offen, also sind nur vier verdeckt, und diese vier plus ein weiterer Stein bilden die Hand. Je weniger Steine verdeckt sind, desto leichter sind sie zu lesen und desto näher ist er meist dran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tienen trece entre turnos. Nueve se ven en los tres pungs, así que solo cuatro están ocultas, y esas cuatro más una ficha forman la mano. Cuantas menos fichas ocultas, más fáciles de leer y, normalmente, más cerca están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chacun en a treize entre deux tours. Neuf sont visibles dans les trois pungs, quatre seulement sont donc cachées, et ces quatre plus une tuile forment la main. Moins il y a de tuiles cachées, plus elles sont faciles à deviner et plus il est généralement proche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua orang memegang tiga belas ubin di antara giliran. Sembilan terlihat di tiga pung, jadi hanya empat tersembunyi, dan empat itu ditambah satu ubin lagi membentuk tangan. Makin sedikit ubin tersembunyi, makin mudah dibaca dan biasanya makin dekat menangnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữa các lượt ai cũng có mười ba quân. Chín quân đang hiện trong ba pung, nên chỉ còn bốn quân úp, và bốn quân đó cộng thêm một quân nữa là bộ bài. Càng ít quân úp càng dễ đọc và thường họ càng gần thắng."
          }
        }
      }
    },
    "Everyone pays East": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle zahlen an Ost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos pagan a Este"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
