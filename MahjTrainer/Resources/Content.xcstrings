          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả bộ bài"
          }
        }
      }
    },
    "The Winds": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Winde"
          }
        },
        "es": {
