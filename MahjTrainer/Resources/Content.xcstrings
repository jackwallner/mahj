          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya setelah buangan berikutnya mendarat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ sau khi quân bỏ kế tiếp rơi xuống"
          }
        }
      }
    },
    "Only before your next discard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur vor deinem nächsten Abwurf"
          }
        },
        "es": {
          "stringUnit": {
