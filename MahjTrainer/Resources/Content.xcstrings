            "value": "Personne, la tuile est morte"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada, ubinnya mati"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai, quân đó chết"
          }
        }
      }
    },
    "None": {
      "extractionState": "manual",
      "localizations": {
        "de": {
