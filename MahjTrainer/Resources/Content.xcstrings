            "value": "Kartu belajar: bagian kartu dan cara membaca satu baris"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ ghi nhớ: mọi nhóm trên thẻ và cách đọc một dòng"
          }
        }
      }
    },
    "Flashcards: every tile family and what it does": {
      "extractionState": "manual",
      "localizations": {
