    "Second Charleston, the LAST pass, going RIGHT. Your odds are strong.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, der LETZTE Pass nach RECHTS. Deine ungerade Hand ist vielversprechend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundo Charleston, el ÚLTIMO pase, a la DERECHA. Tienes una buena base para una mano de impares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deuxième Charleston, DERNIÈRE passe à DROITE. Votre main est bien orientée vers les nombres impairs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston kedua, operan TERAKHIR, ke KANAN. Susunan ubin ganjilmu sudah kuat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston thứ hai, lượt CUỐI, chuyền sang PHẢI. Hướng số lẻ của bạn mạnh."
          }
        }
      }
    },
