        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston đầu tiên, chuyền sang phải. Năm quân gió và năm quân số rải rác."
          }
        }
      }
    },
    "First Charleston, pass right. Five winds and five scattered numbers. Pick 3.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erster Charleston, nach rechts. Fünf Winde und fünf verstreute Zahlen. Wähl 3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer Charleston, pasa a la derecha. Cinco vientos y cinco números dispersos. Elige 3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premier Charleston, passez à droite. Cinq vents et cinq tuiles numérotées dispersées. Choisissez 3 tuiles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston pertama, operkan ke kanan. Lima angin dan lima angka tersebar. Pilih 3."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston đầu tiên, chuyền sang phải. Năm quân gió và năm quân số rải rác. Chọn 3."
          }
        }
      }
    },
    "First Charleston, pass right. Pick 3 tiles to pass.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
