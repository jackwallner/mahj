            "state": "translated",
            "value": "Ninguno: un empate significa que nadie la toma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun : en cas d'égalité, personne ne la prend"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak keduanya: seri berarti tidak ada yang mengambil"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không ai: hòa nghĩa là không ai lấy"
          }
