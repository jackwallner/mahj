    "They cannot claim a tile to grow an old exposure.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kann keinen Stein beanspruchen, um eine alte Auslage zu erweitern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pueden reclamar una ficha para ampliar una exposición antigua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne peut pas réclamer une tuile pour agrandir une ancienne exposition."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka tidak bisa mengklaim ubin untuk memperbesar ekspos lama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ không thể nhận quân để mở rộng một quân lộ cũ."
          }
        }
      }
    },
    "They cannot win without calling a discard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kann nur gewinnen, wenn er einen Abwurf ruft"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puede ganar sin cantar un descarte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne peut pas gagner sans appeler une défausse"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka tidak bisa menang tanpa memanggil buangan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ không thể thắng nếu không hô quân bỏ"
          }
        }
      }
    },
    "They chose to throw a 2 Dot away, which is not what a player does with a tile they need.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er hat sich entschieden, eine 2 Dot wegzuwerfen, und das tut man nicht mit einem Stein, den man braucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligió tirar un 2 Dot, que no es lo que hace un jugador con una ficha que necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a choisi de jeter un 2 Dot, ce qu'un joueur ne fait pas d'une tuile dont il a besoin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mereka memilih membuang 2 Dot, dan itu bukan yang dilakukan pemain terhadap ubin yang dibutuhkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ chọn bỏ 2 Dot, không phải việc người ta làm với quân mình cần."
          }
        }
      }
    },
    "They go face up on top of your rack for the rest of the hand": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie liegen für den Rest der Hand offen auf deinem Rack"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan boca arriba sobre tu atril el resto de la mano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles sont posées face visible sur votre chevalet jusqu'à la fin de la manche"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditaruh menghadap atas di atas rakmu sampai tangan selesai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng được ngửa lên trên giá suốt phần còn lại của ván"
          }
        }
      }
    },
    "They have no jokers": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er hat keine Joker"
          }
        },
        "es": {
