          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa"
          }
        }
      }
    },
    "Flowers": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Flores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fleurs"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa"
          }
        }
      }
    },
    "Flowers are hard to replace. Pass them only when nothing else can go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen sind schwer zu ersetzen. Gib sie nur ab, wenn du nichts anderes abgeben kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flores son difíciles de reemplazar. Pásalas solo cuando no tengas nada más que pasar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fleurs sont difficiles à remplacer. Ne les passez que si vous n'avez rien d'autre à passer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga sulit diganti. Operkan hanya kalau tidak ada lagi yang bisa dilepas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa khó thay thế. Chỉ chuyền hoa khi không còn lựa chọn nào khác."
          }
        }
      }
    },
    "Flowers are the last thing you pass. All eight are interchangeable and they turn up across many sections, so passing one hands over a tile your own hand may need later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen gibst du zuletzt ab. Alle acht sind austauschbar und kommen in vielen Sektionen vor, also gibst du einen Stein ab, den deine Hand später brauchen könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flores son lo último que se pasa. Las ocho son intercambiables y aparecen en muchas secciones, así que pasar una entrega una ficha que tu propia mano quizá necesite después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fleurs sont les dernières tuiles à passer. Elles sont toutes interchangeables et servent dans de nombreuses sections : en céder une revient à se séparer d'une tuile dont votre main pourrait avoir besoin plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga sebaiknya dioperkan paling akhir. Kedelapannya bisa saling menggantikan dan dipakai di banyak bagian, jadi bunga yang kamu operkan mungkin dibutuhkan tanganmu nanti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa nên là loại quân cuối cùng bạn chuyền. Cả tám quân hoa đều thay thế được cho nhau và xuất hiện trong nhiều nhóm bài, nên chuyền một quân có thể khiến bạn mất quân mà bài của mình cần về sau."
          }
        }
      }
    },
    "Flowers are their own tiles. Only jokers stand in for others.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen sind eigenständige Steine. Nur Joker können andere Steine ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flores son fichas por sí mismas. Solo los comodines sustituyen a otras fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fleurs sont des tuiles à part. Seuls les jokers en remplacent d'autres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga adalah ubin tersendiri. Hanya joker yang menggantikan ubin lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa là quân riêng. Chỉ joker mới thay cho quân khác."
          }
        }
      }
    },
    "Flowers are useful in most sections, but a Singles and Pairs hand may only want a pair of them. Holding a third out of habit costs you a tile you need.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen sind in den meisten Sektionen nützlich, aber eine Hand aus der Sektion „Einzelsteine & Paare“ braucht vielleicht nur ein Paar davon. Eine dritte Blume aus Gewohnheit zu behalten, kostet dich einen Stein, den du brauchst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flores sirven en la mayoría de las secciones, pero una mano de Sueltas y Parejas quizá solo quiera una pareja de ellas. Guardar una tercera por costumbre ocupa el espacio de una ficha que necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fleurs servent dans la plupart des sections, mais une main Simples et Paires ne veut parfois qu'une paire de fleurs. En garder une troisième par habitude vous coûte une tuile utile."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga berguna di sebagian besar bagian, tapi tangan Tunggal dan Pasangan mungkin hanya menginginkan sepasang. Menyimpan yang ketiga karena kebiasaan membuatmu kehilangan ubin yang kamu perlukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa hữu ích ở hầu hết các nhóm, nhưng bộ Đơn & Đôi có thể chỉ cần một đôi hoa. Giữ quân hoa thứ ba theo thói quen sẽ khiến bạn thiếu chỗ cho quân cần thiết."
          }
        }
      }
    },
    "Flowers can stand in for it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen können ihn ersetzen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flores pueden sustituirla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fleurs peuvent la remplacer"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga bisa menggantikannya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa có thể thay cho nó"
          }
        }
      }
    },
    "Flowers turn up in many hands, so early passes seldom include one. Count yours. Extras beyond what your sections can use can go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blumen kommen in vielen Händen vor, deshalb ist eine in den frühen Pässen selten dabei. Zähl deine. Überzählige, die deine Sektionen nicht brauchen, kannst du abgeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las flores aparecen en muchas manos, así que rara vez conviene pasar una al principio. Cuenta cuántas tienes. Puedes pasar las que no necesites para tus secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fleurs figurent dans beaucoup de mains, donc les premières passes en contiennent rarement. Comptez les vôtres. Celles qui dépassent ce que vos sections peuvent utiliser peuvent partir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunga muncul di banyak tangan, jadi operan awal jarang menyertakannya. Hitung bungamu. Bunga yang melebihi kebutuhan bagianmu bisa dioperkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoa xuất hiện trong nhiều bộ bài, nên ít khi được chuyền ở lượt đầu. Hãy đếm số hoa bạn có. Bạn có thể chuyền số hoa vượt quá nhu cầu của các nhóm bài bạn đang theo."
          }
        }
      }
    },
    "Follow the count. The hand with more tiles home needs fewer lucky draws, unless the other is far more flexible or pays far more. Recount every few draws, because the best hand for your rack changes as tiles arrive.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die Anzahl passender Steine. Die Hand, für die du schon mehr Steine beisammen hast, braucht weniger Glück beim Ziehen, es sei denn, die andere ist viel flexibler oder bringt deutlich mehr Punkte. Zähle alle paar Züge neu, denn mit jedem gezogenen Stein kann sich ändern, welche Hand für dein Rack am besten ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue la cuenta. La mano para la que ya tienes más fichas necesita menos robos afortunados, salvo que la otra sea mucho más flexible o pague mucho más. Vuelve a contar cada pocos robos, porque la mejor opción para tu atril cambia según las fichas que vayas robando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez les comptes : la main où vous avez déjà réuni le plus de tuiles demande moins de tirages favorables, à moins que l'autre soit beaucoup plus souple ou rapporte bien plus. Refaites le point après quelques pioches, car la meilleure main pour votre chevalet change au fil des tirages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti hitungannya. Tangan dengan lebih banyak ubin di rak butuh lebih sedikit keberuntungan saat mengambil, kecuali yang lain jauh lebih fleksibel atau bayarannya jauh lebih besar. Hitung ulang setiap beberapa ambilan, karena tangan terbaik untuk rakmu berubah seiring ubin datang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dựa vào số quân đã khớp. Bộ bài gần hoàn thành hơn cần ít lần bốc may mắn hơn, trừ khi bộ kia linh hoạt hơn nhiều hoặc được điểm cao hơn nhiều. Đếm lại sau vài lần bốc, vì bộ bài phù hợp nhất với các quân bạn đang có sẽ thay đổi khi quân mới về."
          }
        }
      }
    },
    "For Consecutive Run hands, middle numbers (4-7) leave the most room to build in either direction.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Folgen bieten mittlere Zahlen (4 bis 7) den größten Spielraum, um in beide Richtungen weiterzubauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En las manos de Escalera, los números centrales (4-7) dejan más margen para construir en ambas direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les mains de Suite, les chiffres du milieu (4-7) laissent le plus de marge pour construire dans les deux sens."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk tangan Urutan, angka tengah (4-7) memberi ruang paling banyak untuk berkembang ke dua arah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với bài Dãy liên tiếp, các số giữa (4-7) dễ nối thêm về cả hai phía nhất."
          }
        }
      }
    },
    "Four": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn"
          }
        }
      }
    },
    "Four identical tiles. Jokers are allowed inside one, so a kong can be part natural tiles and part jokers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier gleiche Steine. Joker sind darin erlaubt, ein Kong kann also teils aus echten Steinen und teils aus Jokern bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro fichas idénticas. Un kong puede combinar fichas naturales y comodines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre tuiles identiques. On peut utiliser des jokers dans un kong, qui peut donc mêler tuiles naturelles et jokers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat ubin yang sama. Joker boleh dipakai dalam kelompok itu, jadi kong bisa terdiri dari ubin asli dan joker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kong gồm bốn quân giống nhau, có thể kết hợp quân thật với joker."
          }
        }
      }
    },
    "Four identical tiles. Pung is 3, kong is 4, quint is 5 (and a quint always needs a joker, since only 4 of each tile exist).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier gleiche Steine. Ein Pung besteht aus 3 Steinen, ein Kong aus 4 und ein Quint aus 5 (und ein Quint braucht immer einen Joker, da es von jedem Stein nur 4 gibt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro fichas idénticas. Un pung tiene 3 fichas, un kong 4 y un quint 5 (y un quint siempre necesita un comodín, porque solo hay 4 de cada ficha)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre tuiles identiques. Un pung en compte 3, un kong 4, un quint 5 (et un quint exige toujours un joker, puisqu'il n'existe que 4 exemplaires de chaque tuile)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat ubin identik. Pung itu 3, kong 4, quint 5 (dan quint selalu butuh joker, karena tiap ubin hanya ada 4)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn quân giống nhau. Pung là 3, kong là 4, quint là 5 (và quint luôn cần joker, vì mỗi loại quân chỉ có 4 quân)."
          }
        }
      }
    },
    "Four jokers beside two pungs. Each pung needs two jokers to reach five of a kind, so four is enough for either one, or both. Joker-heavy racks with big groups point at Quints.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Joker neben zwei Pungs. Jeder Pung braucht zwei Joker für fünf gleiche Steine, vier reichen also für einen oder beide. Jokerreiche Racks mit großen Gruppen deuten auf Quints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro comodines junto a dos pungs. Cada pung necesita dos comodines para llegar a cinco iguales, así que cuatro bastan para uno de ellos o para ambos. Los atriles con muchos comodines y grupos grandes apuntan a Quints."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre jokers à côté de deux pungs. Chaque pung a besoin de deux jokers pour atteindre cinq identiques : quatre suffisent donc pour l'un ou l'autre, ou pour les deux. Un chevalet chargé de jokers et comprenant de grands groupes oriente vers les Quints."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat joker di samping dua pung. Tiap pung butuh dua joker untuk mencapai lima ubin sama, jadi empat cukup untuk salah satunya, atau keduanya. Rak penuh joker dengan kelompok besar mengarah ke Quint."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn joker bên cạnh hai pung. Mỗi pung cần thêm hai joker để thành quint, nên bốn joker đủ cho một pung hoặc cả hai. Khay quân nhiều joker và nhiều nhóm lớn thường là dấu hiệu nên theo bài Quint."
          }
        }
      }
    },
    "Four of each wind, the same as every other tile. That is worth knowing: if three Easts are already visible, the fourth is the last one alive.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von jedem Wind gibt es vier Steine, genau wie von jedem anderen Stein. Gut zu wissen: Sind drei Oststeine bereits sichtbar, ist der vierte der letzte noch verfügbare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay cuatro fichas de cada viento, igual que de las demás fichas. Conviene saberlo: si ya se ven tres fichas de Viento Este, la cuarta es la última disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il existe quatre exemplaires de chaque vent, comme de toutes les autres tuiles. Bon à savoir : si trois tuiles Est sont déjà visibles, la quatrième est la dernière encore en jeu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap jenis angin ada empat ubin, sama seperti ubin lainnya. Ini penting diketahui: kalau tiga Timur sudah terlihat, yang keempat adalah satu-satunya yang tersisa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hướng gió có bốn quân, như các loại quân khác. Hãy nhớ rằng nếu đã thấy ba quân Đông, quân thứ tư là quân Đông cuối cùng còn lại."
          }
        }
      }
    },
    "Four real tiles is the most you can have, so the other two of the six have to be jokers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier echte Steine sind das Maximum, die anderen zwei der sechs müssen also Joker sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo puedes tener cuatro fichas naturales, así que las otras dos de las seis deben ser comodines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez avoir que quatre tuiles naturelles au maximum, donc les deux autres d'un groupe de six doivent être des jokers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat ubin asli adalah jumlah maksimal, jadi dua ubin sisanya harus berupa joker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chỉ có thể có tối đa bốn quân thật, nên hai quân còn lại trong bộ sáu phải là joker."
          }
        }
      }
    },
    "Four times the value": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den vierfachen Wert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro veces el valor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre fois la valeur"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat kali lipat nilai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gấp bốn giá trị"
          }
        }
      }
    },
    "Four, So Keep Count": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier, also zähl mit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro, así que cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre, donc comptez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Empat, Jadi Hitunglah"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn, nên hãy đếm"
          }
        }
      }
    },
    "Free information": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis-Information"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información gratis"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Information gratuite"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi gratis"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin sẵn có"
          }
        }
      }
    },
    "Go with the section where you hold the most tiles, not the one you like best. Seven of one number beats four scattered evens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm die Sektion, in der du die meisten Steine hast, nicht die, die dir am besten gefällt. Sieben Steine derselben Zahl sind besser als vier verstreute gerade Steine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la sección donde tienes más fichas, no la que más te gusta. Siete de un mismo número valen más que cuatro fichas de número par dispersas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la section où vous avez le plus de tuiles, pas celle que vous préférez. Sept tuiles d'un même chiffre valent mieux que quatre tuiles de valeur paire dispersées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bagian yang cocok dengan ubin terbanyak di rakmu, bukan yang paling kamu suka. Tujuh ubin dengan angka sama lebih baik daripada empat ubin genap yang terpencar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chọn nhóm bạn có nhiều quân nhất, không phải nhóm bạn thích nhất. Bảy quân cùng một số mạnh hơn bốn quân chẵn rải rác."
          }
        }
      }
    },
    "Great news": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gute Nachricht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena noticia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excellente nouvelle"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabar baik"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin tốt"
          }
        }
      }
    },
    "Green Dragon": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grüner Drache"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragón Verde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragon Vert"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naga Hijau"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rồng Xanh"
          }
        }
      }
    },
    "Green goes with Bams, because bamboo is green.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün gehört zu Bam, weil Bambus grün ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Verde va con los Bam, porque el bambú es verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vert va avec les bambous, puisque le bambou est vert."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hijau cocok dengan Bam, karena bambu itu hijau."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu xanh ứng với chất Bam, vì tre có màu xanh."
          }
        }
      }
    },
    "Green goes with Bams. Red goes with Craks, Soap goes with Dots. When a hand wants a dragon in a suit, the card means THAT suit's dragon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün gehört zu Bam. Rot gehört zu Crak, Soap zu Dot. Will eine Hand einen Drachen in einer Farbe, meint die Karte den Drachen DIESER Farbe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El verde va con los Bam. El rojo va con los Crak y el Dragón Blanco con los Dot. Cuando una mano pide un dragón de un palo, la tarjeta se refiere al dragón DE ESE palo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vert va avec les bambous. Le rouge va avec les caractères, et le Dragon blanc avec les cercles. Quand une main demande un dragon d'une famille, la carte désigne le dragon de CETTE famille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hijau cocok dengan Bam, merah dengan Crak, dan Soap dengan Dot. Jika suatu tangan membutuhkan naga dari jenis tertentu, yang dimaksud di kartu adalah naga dari JENIS tersebut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rồng Xanh ứng với Bam, Rồng Đỏ ứng với Crak, còn Soap ứng với Dot. Khi bài cần một quân rồng thuộc chất nào đó, thẻ muốn nói đến rồng của chất đó."
          }
        }
      }
    },
