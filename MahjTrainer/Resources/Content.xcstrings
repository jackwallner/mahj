    "Courtesy pass, 3 tiles across. You are locked into 369.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höflichkeitspass mit 3 Steinen an den Spieler gegenüber. Du bist auf 369 festgelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pase de cortesía, 3 fichas al jugador de enfrente. Ya estás comprometido con 369."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe de courtoisie, 3 tuiles à passer au joueur en face. Vous êtes engagé dans la main 369."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operan sopan santun, 3 ubin ke seberang. Kamu terkunci di 369."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt chuyền xã giao, 3 quân sang đối diện. Bạn đã chốt 369."
          }
        }
      }
    },
    "Courtesy pass, 3 tiles across. You are locked into 369. Pick 3.": {
      "extractionState": "manual",
