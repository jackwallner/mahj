          }
        }
      }
    },
    "Nothing tells you they do not want Bams. The Dots are the suit they gave away.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts sagt dir, dass er keine Bams will. Die Dots sind die Farbe, die er abgegeben hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada indica que no quiera fichas Bam. El palo que ha ido descartando es Dot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'indique qu'il ne veut pas de bambous. Les cercles sont la famille dont il s'est débarrassé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang menunjukkan mereka tidak menginginkan Bam. Dot adalah jenis yang mereka lepas."
          }
        },
        "vi": {
