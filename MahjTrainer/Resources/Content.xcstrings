            "value": "Premier Charleston, passez à droite. Choisissez 3 tuiles à passer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston pertama, operkan ke kanan. Pilih 3 ubin untuk dioperkan."
          }
        },
        "vi": {
