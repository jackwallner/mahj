          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seseorang membuang 5 Dot. Bisakah kamu memanggilnya?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có người bỏ 5 Dot. Bạn có hô được không?"
          }
        }
      }
    },
    "Someone discards a joker. Can you call it?": {
      "extractionState": "manual",
