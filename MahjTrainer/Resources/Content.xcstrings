    },
    "Defense School": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteidigungsschule"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuela de defensa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "École de défense"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekolah Pertahanan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trường phòng thủ"
          }
        }
      }
    },
    "Different colors mean different suits, not particular ones. Green, red and blue just tell you the hand uses three suits, and you pick which is which.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angezeigten Farben stehen für verschiedene Steinfarben, sind ihnen aber nicht fest zugeordnet. Grün, Rot und Blau zeigen nur, dass die Hand alle drei Steinfarben nutzt. Welche angezeigte Farbe für welche Steinfarbe steht, entscheidest du selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los colores distintos significan palos distintos, no palos concretos. Verde, rojo y azul solo te dicen que la mano usa tres palos, y tú eliges cuál es cuál."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des couleurs différentes indiquent des familles différentes, pas des familles précises. Le vert, le rouge et le bleu indiquent simplement que la main utilise trois familles ; c'est à vous de choisir laquelle correspond à chaque couleur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warna berbeda berarti jenis berbeda, bukan jenis tertentu. Hijau, merah, dan biru hanya memberi tahu bahwa tangan memakai tiga jenis, dan kamu yang menentukan mana yang mana."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu sắc khác nhau biểu thị các chất khác nhau, chứ không chỉ định chất cụ thể nào. Xanh lá, đỏ và xanh dương chỉ cho biết bài dùng ba chất; bạn tự chọn màu nào ứng với chất nào."
          }
        }
      }
    },
    "Discard fast to end the game sooner": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnell abwerfen, um das Spiel früher zu beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar rápido para acabar antes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défausser vite pour finir la partie plus tôt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Segera buang ubin agar permainan lekas selesai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ nhanh để ván kết thúc sớm hơn"
          }
        }
      }
    },
