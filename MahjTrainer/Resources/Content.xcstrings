    "First Charleston, pass RIGHT. Your craks scream odds, your bams start a run.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erster Charleston, nach RECHTS. Deine Craks sind klar ungerade, deine Bams bilden den Anfang einer Folge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer Charleston, pasa a la DERECHA. Tus fichas Crak apuntan a impares y tus fichas Bam empiezan una escalera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premier Charleston, passez à DROITE. Vos tuiles de caractère sont surtout impaires, et vos tuiles de bambou commencent à former une suite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston pertama, operkan ke KANAN. Crak-mu jelas bernomor ganjil, Bam-mu mulai membentuk urutan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston đầu tiên, chuyền sang PHẢI. Các quân Crak của bạn chủ yếu là số lẻ, còn các quân Bam có thể mở đầu một dãy."
          }
        }
      }
    },
