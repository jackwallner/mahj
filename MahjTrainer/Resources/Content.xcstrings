          }
        }
      }
    },
    "How do you pick a discard?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie wählst du einen Abwurf?"
          }
        },
        "es": {
          "stringUnit": {
