          }
        }
      }
    },
    "Odd numbers only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ungerade Zahlen"
          }
        },
        "es": {
