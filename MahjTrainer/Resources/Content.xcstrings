            "state": "translated",
            "value": "Không có tác dụng gì, chỉ để trang trí."
          }
        }
      }
    },
    "Nothing, you just take it back": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, du nimmst ihn einfach zurück"
          }
        },
        "es": {
          "stringUnit": {
