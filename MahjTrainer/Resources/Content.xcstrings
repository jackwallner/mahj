            "value": "Chỉ để mah jongg"
          }
        }
      }
    },
    "Only for the zero": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Null"
          }
        },
