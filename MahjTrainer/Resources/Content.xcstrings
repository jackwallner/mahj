      }
    },
    "At the Table": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Tisch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la mesa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À table"
