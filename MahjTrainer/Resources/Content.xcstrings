            "value": "Quien habló primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui a parlé en premier"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang bicara lebih dulu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người lên tiếng trước"
          }
        }
      }
    },
    "Why bother tracking the jokers sitting in opponents' exposures?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum solltest du die Joker in den Auslagen der Gegner im Blick behalten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué conviene llevar la cuenta de los comodines en las exposiciones de tus oponentes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi suivre les jokers dans les expositions des adversaires ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenapa repot melacak joker di ekspos lawan?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao nên theo dõi joker nằm trong các bộ đã lộ của đối thủ?"
          }
        }
      }
    },
    "Why do careful players slow down on their discards late in the hand?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum nehmen sich vorsichtige Spieler gegen Ende der Hand mehr Zeit für ihre Abwürfe?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué los jugadores cuidadosos descartan más despacio al final de la mano?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi les joueurs prudents ralentissent-ils leurs défausses en fin de manche ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenapa pemain yang cermat lebih berhati-hati saat membuang ubin menjelang akhir ronde?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao người chơi cẩn thận cân nhắc kỹ hơn trước khi bỏ quân vào cuối ván?"
          }
        }
      }
    },
    "Winds": {
