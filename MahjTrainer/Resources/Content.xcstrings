    "Defense School": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteidigungsschule"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuela de defensa"
          }
        },
        "fr": {
          "stringUnit": {
