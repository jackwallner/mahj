    "Craks are the suit their exposures are built in, so a Crak is the riskiest suit to throw against them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Auslagen bestehen aus Craks, daher ist ein Crak der riskanteste Stein, den du gegen ihn abwerfen kannst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exposiciones de ese jugador son de Crak, así que descartar una ficha Crak contra él es lo más arriesgado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses expositions sont toutes en Crak. Défausser un Crak est donc le choix le plus risqué face à lui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspos mereka menggunakan jenis Crak, jadi membuang ubin Crak adalah pilihan paling berisiko."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bộ đã lộ của họ đều thuộc chất Crak, nên bỏ quân Crak là nguy hiểm nhất khi đánh với họ."
          }
        }
      }
    },
    "Craks only": {
      "extractionState": "manual",
      "localizations": {
        "de": {
