            "value": "Hanya 4 di antaranya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ 4 quân trong số đó"
          }
        }
      }
    },
    "Only East": {
      "extractionState": "manual",
      "localizations": {
        "de": {
