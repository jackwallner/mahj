            "state": "translated",
            "value": "Tidak ada, kamu tinggal mengambilnya kembali"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có gì xảy ra, bạn chỉ cần lấy lại quân đó."
          }
        }
      }
    },
    "Nothing: an exposed joker is locked": {
      "extractionState": "manual",
      "localizations": {
