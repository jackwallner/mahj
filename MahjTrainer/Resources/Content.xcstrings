    "Second Charleston, pass LEFT. Honors everywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, nach LINKS. Überall Ehrensteine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundo Charleston, pase a la IZQUIERDA. Honores por todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Second Charleston, passe à GAUCHE. Des honneurs partout."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston kedua, operkan ke KIRI. Ubin kehormatan di mana-mana."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston thứ hai, chuyền sang TRÁI. Quân danh dự khắp nơi."
          }
        }
      }
    },
    "Second Charleston, pass LEFT. Honors everywhere. Pick 3.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, nach LINKS. Überall Ehrensteine. Wähl 3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundo Charleston, pase a la IZQUIERDA. Honores por todas partes. Elige 3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Second Charleston, passe à GAUCHE. Des honneurs partout. Choisissez 3 tuiles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston kedua, operkan ke KIRI. Ubin kehormatan di mana-mana. Pilih 3."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston thứ hai, chuyền sang TRÁI. Quân danh dự khắp nơi. Chọn 3."
          }
        }
      }
    },
    "Second Charleston, pass LEFT. Nobody stopped the second Charleston, so it goes ahead. You hold seven 6s across three suits.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, nach LINKS. Niemand hat den zweiten Charleston gestoppt, er findet also statt. Du hältst sieben 6er in drei Farben."
