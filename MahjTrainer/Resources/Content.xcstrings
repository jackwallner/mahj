        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundo Charleston, pase a la IZQUIERDA. Nadie detuvo el segundo Charleston, así que sigue. Tienes siete 6 en tres palos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Second Charleston, passe à GAUCHE. Personne n'a arrêté le second Charleston, il a donc lieu. Vous avez sept 6 dans trois familles."
