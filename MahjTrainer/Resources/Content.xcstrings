    "Second Charleston, the LAST pass, going RIGHT. You are all-in on evens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweiter Charleston, der LETZTE Pass, nach RECHTS. Du setzt voll auf gerade Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segundo Charleston, el ÚLTIMO pase, a la DERECHA. Has apostado todo a los números pares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deuxième Charleston, DERNIÈRE passe à DROITE. Vous misez tout sur les nombres pairs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston kedua, operan TERAKHIR, ke KANAN. Kamu sepenuhnya fokus pada angka genap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Charleston thứ hai, lượt CUỐI, chuyền sang PHẢI. Bạn dồn hết vào chẵn."
          }
        }
      }
    },
