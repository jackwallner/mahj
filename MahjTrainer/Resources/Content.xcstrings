    "A Consecutive Run line is printed with 1s, 2s and 3s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Folge-Zeile ist mit 1ern, 2ern und 3ern gedruckt."
