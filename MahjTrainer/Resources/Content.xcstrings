    "When 369 and Run overlap, count how many of your tiles each one can use. Commit to whichever uses more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überlappen 369 und Folge, zähl, wie viele deiner Steine jede nutzen kann. Leg dich auf die fest, die mehr nutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando 369 y Escalera se solapan, cuenta cuántas de tus fichas puede usar cada una. Comprométete con la que use más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand 369 et Suite se chevauchent, comptez combien de vos tuiles chacune peut utiliser. Engagez-vous sur celle qui en utilise le plus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalau 369 dan Urutan tumpang tindih, hitung berapa ubinmu yang bisa dipakai masing-masing. Berkomitmenlah ke yang memakai lebih banyak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi 369 và Dãy chồng nhau, hãy đếm số quân của bạn mỗi nhóm dùng được. Chốt nhóm nào dùng nhiều hơn."
          }
        }
      }
    },
    "When can you NOT redeem an exposed joker?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann kannst du einen ausgelegten Joker NICHT einlösen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuándo NO puedes canjear un comodín expuesto?"
          }
        },
        "fr": {
