        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo durante la primera ronda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement pendant le premier tour"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya di putaran pertama"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ trong vòng đầu tiên"
          }
        }
      }
    },
    "Only for mah jongg": {
      "extractionState": "manual",
      "localizations": {
        "de": {
