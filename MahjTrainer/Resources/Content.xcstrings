            "state": "translated",
            "value": "Naga mana yang milik jenis Bam?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rồng nào thuộc chất Bam?"
          }
        }
      }
    },
    "Which dragon goes with a crak hand?": {
      "extractionState": "manual",
      "localizations": {
