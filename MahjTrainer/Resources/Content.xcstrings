    "Yes, unless noted": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ja, wenn nichts dasteht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sí, salvo nota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui, sauf mention"
          }
