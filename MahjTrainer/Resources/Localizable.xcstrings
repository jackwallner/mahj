    "Goes straight to the developer, a real person. No account, no email needed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht direkt an den Entwickler, einen echten Menschen. Kein Konto, keine E-Mail nötig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega directamente al desarrollador, una persona real. Sin cuenta ni correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre message est envoyé directement au développeur, une vraie personne. Aucun compte ni e-mail requis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsung ke pengembang, orang sungguhan. Tanpa akun, tanpa email."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi thẳng đến nhà phát triển, một người thật. Không cần tài khoản hay email."
          }
        }
      }
    },
    "Good practice!": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gute Übung!"
          }
        },
        "es": {
