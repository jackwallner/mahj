    "Coached practice hands as often as you want, Game Night Prep, endless modes, and %lld more drills": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeleitete Übungshände, so oft du willst, Spieleabend-Vorbereitung, endlose Modi und %lld weitere Übungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos de práctica guiadas siempre que quieras, Preparar la noche de juego, modos sin fin y %lld ejercicios más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains d'entraînement guidées à volonté, Préparer la soirée, modes infinis et %lld exercices de plus"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi latihan dengan arahan pelatih sesering yang kamu mau, Persiapan Malam Main, mode tanpa batas, dan %lld latihan lagi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ván luyện có hướng dẫn không giới hạn, Chuẩn bị buổi chơi, chế độ vô tận và thêm %lld bài tập"
          }
        }
      }
    },
    "Come back now and then so it stays sharp.": {
