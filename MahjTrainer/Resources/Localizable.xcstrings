    "Choose your usual game night and get a five-minute session built from your mistakes and weakest room when it matters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl deinen Spieleabend und bekomm genau dann eine 5-Minuten-Runde aus deinen Fehlern und deinem schwächsten Raum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu noche de juego habitual y recibe una sesión de cinco minutos centrada en tus errores y en la sala que más te cuesta, justo cuando la necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre soirée habituelle et recevez, au bon moment, une session de cinq minutes adaptée à vos erreurs et à la salle où vous avez le plus besoin de progresser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih malam saat kamu biasa bermain dan dapatkan sesi latihan lima menit berdasarkan kesalahanmu serta ruang yang paling perlu kamu latih, tepat saat dibutuhkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn buổi chơi quen thuộc để nhận phiên luyện 5 phút đúng lúc cần, tập trung vào câu trả lời sai và phòng bạn cần luyện thêm nhất."
          }
        }
      }
    },
