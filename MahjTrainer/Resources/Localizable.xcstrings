    "Pick the day and a five-minute prep built from your own misses lands before you play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl den Tag, und vor dem Spiel wartet eine 5-Minuten-Vorbereitung aus deinen Fehlern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el día y, antes de jugar, tendrás una preparación de cinco minutos con tus propios fallos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le jour, et une préparation de cinq minutes basée sur vos erreurs vous attend avant de jouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih harinya, dan persiapan lima menit dari kesalahanmu sendiri siap sebelum kamu bermain."
          }
        },
        "vi": {
