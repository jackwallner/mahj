    "Like Numbers is built from one number in several suits, and this rack has only %lld number tiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Zahlen besteht aus einer Zahl in mehreren Farben, und dieses Rack hat nur %lld Zahlensteine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números iguales se forma con un número en varios palos, y este atril solo tiene %lld fichas con número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres identiques se construit avec un nombre dans plusieurs familles, et ce chevalet n'a que %lld tuiles numérotées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka Sama dibangun dari satu angka di beberapa jenis, dan rak ini hanya punya %lld ubin angka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số giống nhau được tạo từ một số ở nhiều chất, còn giá này chỉ có %lld quân số."
          }
        }
      }
    },
    "Like Numbers is built from one number in several suits, and this rack has only 1 number tile.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Zahlen besteht aus einer Zahl in mehreren Farben, und dieses Rack hat nur 1 Zahlenstein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números iguales se forma con un número en varios palos, y este atril solo tiene 1 ficha con número."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres identiques se construit avec un nombre dans plusieurs familles, et ce chevalet n'a qu'une tuile numérotée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Angka Sama dibangun dari satu angka di beberapa jenis, dan rak ini hanya punya 1 ubin angka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số giống nhau được tạo từ một số ở nhiều chất, còn giá này chỉ có 1 quân số."
          }
        }
      }
    },
    "Like Numbers repeats one number across the suits, and this rack spreads across %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Zahlen wiederholt eine Zahl über die Farben, und dieses Rack verteilt sich auf %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números iguales repite un número en varios palos, y este atril se reparte entre %@."
          }
        },
        "fr": {
