    "A balanced member mix now. As you answer more questions, this session will zero in on your real weak spots.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt ein ausgewogener Mix. Je mehr du beantwortest, desto genauer trifft die Runde deine echten Schwächen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, una mezcla equilibrada. Cuanto más respondas, más se centrará esta sesión en tus puntos débiles reales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mélange équilibré pour l'instant. Plus vous répondez, plus cette session ciblera vos vrais points faibles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk sekarang campuran seimbang. Makin banyak kamu menjawab, makin tepat sesi ini menyasar kelemahanmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện là phần trộn cân bằng. Bạn trả lời càng nhiều, phiên này càng nhắm đúng điểm yếu thật của bạn."
          }
        }
      }
    },
