    "Ordered by how strong the rack is, not by the raw count: a pair or a pung is worth more than the same tiles scattered.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert nach Stärke des Racks, nicht nach reiner Anzahl: Ein Paar oder Pung zählt mehr als dieselben Steine verstreut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenado por la fuerza del atril, no por la cantidad: una pareja o un pung vale más que las mismas fichas sueltas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classé selon la force du chevalet, pas le simple nombre : une paire ou un pung vaut plus que les mêmes tuiles éparpillées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diurutkan berdasarkan kekuatan rak, bukan jumlah: pasangan atau pung lebih berharga daripada ubin yang sama tapi tercecer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp theo độ mạnh của giá, không theo số lượng: một đôi hoặc pung giá trị hơn cùng số quân rời rạc."
          }
        }
      }
    },
