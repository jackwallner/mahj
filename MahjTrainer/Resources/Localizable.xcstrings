    "%@ challenge: %@. Today's Mahj Minute is done.": {
      "comment": "The month's name, then a point count",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-Challenge: %2$@. Die heutige Mahj Minute ist erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reto de %1$@: %2$@. El Mahj Minute de hoy está hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défi de %1$@ : %2$@. Le Mahj Minute du jour est fait."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantangan %1$@: %2$@. Mahj Minute hari ini selesai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử thách %1$@: %2$@. Đã xong Mahj Minute hôm nay."
          }
        }
      }
    },
    "%@ could use some of these tiles, but more of them point to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ könnte einige dieser Steine nutzen, aber mehr davon zeigen auf %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ podría usar algunas de estas fichas, pero más de ellas apuntan a %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pourrait utiliser certaines de ces tuiles, mais la plupart pointent vers %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bisa memakai sebagian ubin ini, tapi lebih banyak yang mengarah ke %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ có thể dùng vài quân này, nhưng nhiều quân hơn hướng về %2$@."
          }
        }
      }
    },
    "%@ deals a new hand whenever you want one, coached on every throw.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gibt dir jederzeit eine neue Hand, mit Coaching bei jedem Abwurf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te reparte una mano nueva cuando quieras, con coach en cada descarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous donne une nouvelle main quand vous voulez, avec coaching à chaque défausse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ membagikan tangan baru kapan pun kamu mau, dengan pelatih di setiap buangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chia ván mới bất cứ khi nào bạn muốn, có huấn luyện ở mỗi lần bỏ quân."
          }
        }
      }
    },
    "%@ first, followed by material you have not seen yet.": {
      "comment": "A count of due mistakes",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst %@, danach Stoff, den du noch nicht kennst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero %@, luego material que aún no has visto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord %@, puis du contenu que vous n'avez pas encore vu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dulu, lalu materi yang belum pernah kamu lihat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên là %@, tiếp theo là nội dung bạn chưa xem."
          }
        }
      }
    },
    "%@ first, then extra work in %@.": {
