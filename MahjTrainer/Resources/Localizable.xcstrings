    "Who pays what, when a call is too late, and what happens after a wrong mah jongg, in the Table Room. Free for everyone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer was zahlt, wann ein Ruf zu spät ist und was nach einem falschen Mah Jongg passiert, im Tischraum. Für alle kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quién paga qué, cuándo es tarde para cantar y qué pasa tras un mah jongg erróneo, en la sala de la Mesa. Gratis para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui paie quoi, quand un appel est trop tard et ce qui se passe après un faux mah jongg, dans la salle de la Table. Gratuit pour tous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa membayar apa, kapan panggilan terlambat, dan apa yang terjadi setelah mah jongg yang salah, di Ruang Meja. Gratis untuk semua."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai trả bao nhiêu, khi nào hô là quá muộn, và chuyện gì xảy ra sau một lần hô mah jongg sai, trong phòng Bàn Chơi. Miễn phí cho mọi người."
          }
        }
      }
    },
