    "Take the same five-question challenge as every other member, share your score, and keep a forgiving five-day weekly rhythm.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach dieselbe Fünf-Fragen-Challenge wie alle Mitglieder, teil dein Ergebnis und halte einen lockeren Rhythmus von fünf Tagen pro Woche ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz el mismo reto de cinco preguntas que los demás miembros, comparte tu puntuación y mantén un ritmo flexible de cinco días a la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevez le même défi de cinq questions que tous les membres, partagez votre score et gardez un rythme souple de cinq jours par semaine."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti tantangan lima soal yang sama dengan anggota lain, bagikan skormu, dan jaga ritme santai lima hari seminggu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng làm thử thách năm câu như các thành viên khác, chia sẻ điểm số và duy trì lịch luyện tập linh hoạt năm ngày mỗi tuần."
          }
        }
      }
    },
