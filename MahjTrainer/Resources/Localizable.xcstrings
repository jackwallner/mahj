    "One payment. No subscription, nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen. Kein Abo, nichts verlängert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago. Sin suscripción ni renovaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul paiement. Sans abonnement, rien ne se renouvelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali bayar. Bukan langganan, tidak ada perpanjangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả một lần. Không phải gói đăng ký, không gia hạn."
          }
        }
      }
    },
    "One-time purchase. Not a subscription, nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalkauf. Kein Abo, nichts verlängert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. No es una suscripción y no se renueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Pas d'abonnement, rien ne se renouvelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian satu kali. Bukan langganan, tidak ada perpanjangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Không phải gói đăng ký, không gia hạn."
          }
        }
      }
    },
    "Only 3s, 6s and 9s. It is a small, focused family, so if you hold several of those three numbers, look here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur 3er, 6er und 9er. Eine kleine, klare Familie: Hast du mehrere dieser drei Zahlen, schau hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo treses, seises y nueves. Es una familia pequeña y concreta: si tienes varias fichas de esos números, mira aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement des 3, 6 et 9. Une petite famille précise : si vous avez plusieurs de ces trois nombres, regardez ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya angka 3, 6, dan 9. Kelompok kecil ini khusus memakai angka-angka itu, jadi lihat bagian ini jika rakmu punya beberapa di antaranya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng các số 3, 6 và 9. Đây là nhóm nhỏ, chuyên biệt, nên hãy xem nhóm này nếu bạn có nhiều quân mang các số đó."
          }
        }
      }
    },
    "Only even numbers (2, 4, 6, 8). Every odd tile in your hand is dead weight for this section.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur gerade Zahlen (2, 4, 6, 8). Jeder ungerade Stein ist für diesen Bereich Ballast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo números pares (2, 4, 6, 8). Cada ficha impar en tu mano es peso muerto para esta sección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement des nombres pairs (2, 4, 6, 8). Chaque tuile impaire est un poids mort pour cette section."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya angka genap (2, 4, 6, 8). Setiap ubin ganjil di tanganmu jadi beban untuk bagian ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ số chẵn (2, 4, 6, 8). Mọi quân lẻ trên tay đều là gánh nặng với nhóm này."
          }
        }
      }
    },
    "Only odd numbers (1, 3, 5, 7, 9). The mirror image of 2468, with one more number to build from.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ungerade Zahlen (1, 3, 5, 7, 9). Das Spiegelbild von 2468, mit einer zusätzlichen Zahl für deine Hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo números impares (1, 3, 5, 7, 9). El reflejo de 2468, con un número más para construir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement des nombres impairs (1, 3, 5, 7, 9). Le reflet de 2468, avec un nombre de plus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya angka ganjil (1, 3, 5, 7, 9). Kebalikan dari 2468, dengan satu angka tambahan untuk dirangkai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng số lẻ (1, 3, 5, 7, 9). Đây là nhóm đối lập với 2468, có thêm một số để ghép bài."
          }
        }
      }
    },
    "Only one player has tiles out: %@. Which discard is safest?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Spieler hat Steine ausgelegt: %@. Welcher Abwurf ist am sichersten?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un jugador tiene fichas expuestas: %@. ¿Qué descarte es el más seguro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul joueur a des tuiles exposées : %@. Quelle défausse est la plus sûre ?"
