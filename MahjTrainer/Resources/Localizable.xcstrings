          "stringUnit": {
            "state": "translated",
            "value": "Rak dan operan baru yang tak pernah habis"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tay bài mới và lượt chuyền không giới hạn"
          }
        }
      }
    },
    "Freshly dealt racks, every time. Read the section or count what is still live for as long as you like, with a full explanation after every answer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal ein frisch ausgeteiltes Rack. Lies die Sektion oder zähle, was noch im Spiel ist, so lange du willst. Nach jeder Antwort bekommst du eine ausführliche Erklärung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atriles nuevos en cada reparto. Lee la sección o cuenta lo que sigue en juego durante todo el tiempo que quieras, con una explicación completa tras cada respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des chevalets fraîchement distribués à chaque fois. Identifiez la section ou comptez ce qui reste en jeu aussi longtemps que vous le souhaitez, avec une explication complète après chaque réponse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap kali, kamu mendapat rak baru. Tentukan bagiannya atau hitung ubin yang masih tersedia selama kamu mau, dengan penjelasan lengkap setelah setiap jawaban."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lượt đều có tay bài mới. Bạn có thể luyện phân tích nhóm bài hoặc đếm số quân còn lại bao lâu tùy thích, với lời giải đầy đủ sau mỗi câu trả lời."
          }
        }
      }
    },
    "Freshly dealt racks, unlimited reps": {
      "extractionState": "manual",
      "localizations": {
