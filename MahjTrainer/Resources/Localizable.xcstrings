    "Like Numbers is built from one number in several suits, and this rack has only %lld number tiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei „Gleiche Zahlen“ kommt dieselbe Zahl in mehreren Farben vor, aber dieses Rack hat nur %lld Zahlensteine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Números iguales se usa un mismo número en varios palos, y este atril solo tiene %lld fichas numeradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la section Nombres identiques, un même nombre apparaît dans plusieurs familles, mais ce chevalet n'a que %lld tuiles numérotées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagian Angka Sama menggunakan satu angka di beberapa jenis ubin, dan rak ini hanya punya %lld ubin angka."
          }
