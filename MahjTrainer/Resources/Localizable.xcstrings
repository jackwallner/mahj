    "Choose your usual game night and get a five-minute session built from your mistakes and weakest room when it matters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl deinen Spieleabend und bekomm genau dann eine 5-Minuten-Runde aus deinen Fehlern und deinem schwächsten Raum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu noche de juego habitual y recibe una sesión de cinco minutos con tus errores y tu sala más floja cuando importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre soirée habituelle et recevez au bon moment une session de cinq minutes tirée de vos erreurs et de votre salle la plus faible."
          }
