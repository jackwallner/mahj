    "this section is built mostly from winds and dragons, so a rack full of number tiles is not it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "diese Sektion besteht meist aus Winden und Drachen, also passt ein Rack voller Zahlensteine nicht"
