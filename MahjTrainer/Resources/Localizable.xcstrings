    "Send Feedback is a text box and one button now. No mail app, no account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback senden besteht jetzt aus einem Textfeld und einer Schaltfläche. Du brauchst weder eine Mail-App noch ein Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora, Enviar comentarios tiene un cuadro de texto y un solo botón. Sin app de correo ni cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi d'un commentaire se fait désormais via un champ de texte et un bouton. Plus besoin de l'app Mail ni d'un compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim Masukan kini cukup berupa kotak teks dan satu tombol. Tak perlu aplikasi email atau akun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi góp ý giờ chỉ là một ô văn bản và một nút. Không cần ứng dụng thư, không cần tài khoản."
          }
        }
      }
    },
    "Sends one notification on the 1st of each month": {
