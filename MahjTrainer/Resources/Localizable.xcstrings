          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero %1$@, luego práctica extra en %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord %1$@, puis du travail en plus dans %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dulu, lalu latihan tambahan di %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên là %1$@, sau đó luyện thêm ở %2$@."
          }
        }
