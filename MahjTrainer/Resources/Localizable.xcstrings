          }
        }
      }
    },
    "Set your usual game night. The reminder opens a fresh session built from your mistakes, weakest room, and material you have not seen yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg deinen Spieleabend fest. Die Erinnerung öffnet eine neue Runde aus deinen Fehlern, deinem schwächsten Raum und neuem Stoff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu noche de juego habitual. El recordatorio abre una sesión nueva con tus errores, tu sala más floja y material que aún no has visto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre soirée de jeu habituelle. Le rappel ouvre une nouvelle séance conçue à partir de vos erreurs, de la salle où vous avez le plus de difficultés et des contenus que vous n'avez pas encore vus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur malam main rutinmu. Pengingat akan membuka sesi baru dari kesalahanmu, ruang terlemahmu, dan materi yang belum pernah kamu lihat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn buổi chơi thường lệ của bạn. Lời nhắc sẽ mở một phiên mới từ lỗi sai, phòng yếu nhất và nội dung bạn chưa xem."
          }
        }
      }
    },
