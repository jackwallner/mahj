        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf hat geklappt, aber %@ ist noch nicht freigeschaltet. Warte kurz und tippe dann auf Wiederherstellen. Dir wird nichts doppelt berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se completó, pero %@ aún no se ha desbloqueado. Espera un momento y toca Restaurar. No se te cobrará dos veces."
