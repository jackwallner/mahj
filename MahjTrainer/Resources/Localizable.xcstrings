          }
        }
      }
    },
    "Right. The %@ is outside the %@ shape you are building, and tiles that don't fit your shape are the ones to spend first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtig. %1$@ liegt außerhalb der %2$@-Form, die du baust, und Steine, die nicht zur Form passen, gibst du zuerst aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correcto. El %1$@ queda fuera de la forma de %2$@ que estás armando, y las fichas que no encajan son las que debes soltar primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste. Le %1$@ est hors de la forme %2$@ que vous construisez, et ce sont les tuiles hors forme qu'on lâche en premier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Benar. %1$@ di luar bentuk %2$@ yang kamu bangun, dan ubin yang tidak cocok dengan bentukmu dibuang lebih dulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng. %1$@ nằm ngoài hình %2$@ bạn đang xây, và quân không hợp hình là quân nên bỏ trước."
          }
        }
      }
    },
