    },
    "Commit to a section and play it out": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf eine Sektion fest und spiel sie aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una sección y juégala hasta el final"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une section et la jouer jusqu'au bout"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu bagian dan mainkan sampai selesai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một nhóm và chơi đến cùng"
          }
        }
      }
    },
    "Commit to a section, then draw and discard for twelve turns while a coach grades every throw. One hand a day is free, and members can deal as many as they like.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg dich auf eine Sektion fest, dann zieh und wirf zwölf Züge lang ab, während ein Coach jeden Abwurf bewertet. Eine Hand am Tag ist gratis, Mitglieder spielen so viele sie wollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una sección y roba y descarta durante doce turnos mientras un coach evalúa cada descarte. Una mano al día es gratis, y los miembros pueden repartir todas las que quieran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une section, puis piochez et défaussez pendant douze tours pendant qu'un coach note chaque défausse. Une main par jour est gratuite, les membres en jouent autant qu'ils veulent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih satu bagian, lalu ambil dan buang selama dua belas giliran sementara pelatih menilai setiap buangan. Satu tangan sehari gratis, dan anggota bisa bermain sebanyak yang mereka mau."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một nhóm, rồi rút và bỏ quân trong mười hai lượt khi huấn luyện viên chấm từng lần bỏ. Mỗi ngày một ván miễn phí, thành viên chơi bao nhiêu tùy thích."
          }
        }
      }
    },
