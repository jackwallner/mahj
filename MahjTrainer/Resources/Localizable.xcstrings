    "Miss a question and you can now open a note on the answer you chose, not just a reminder of the one you did not.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegst du daneben, öffnest du jetzt eine Notiz zu deiner gewählten Antwort, nicht nur einen Hinweis auf die richtige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si fallas una pregunta, ahora puedes abrir una nota sobre la respuesta que elegiste, no solo un recordatorio de la correcta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous ratez une question, vous pouvez ouvrir une note sur la réponse choisie, pas seulement un rappel de la bonne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika salah menjawab, kini kamu bisa membuka catatan tentang jawaban pilihanmu, bukan hanya pengingat jawaban yang benar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi trả lời sai, giờ bạn có thể mở ghi chú về đáp án mình đã chọn, chứ không chỉ lời nhắc về đáp án đúng."
          }
        }
      }
    },
