          }
        }
      }
    },
    "%lld of them are already sitting in a group of two or more, which is the half that counts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld davon gehören schon zu einer Gruppe aus mindestens zwei Steinen, und genau diese Hälfte zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ya están en un grupo de dos o más, y esa es la mitad que realmente importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sont déjà dans un groupe de deux ou plus, et c'est la moitié qui compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld di antaranya sudah ada di kelompok dua atau lebih, dan itu bagian yang penting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld quân đã nằm trong nhóm có từ hai quân trở lên, và đó mới là phần cần tính đến."
          }
        }
      }
    },
    "%lld of your %lld throws were the cheapest one available, and that is the number to chase: the shape you are building toward is the whole game, and everything outside it is what you spend.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %1$lld deiner %2$lld Abwürfe hast du jeweils die günstigste verfügbare Option gewählt. Genau diese Zahl solltest du anpeilen: Entscheidend ist die Form, auf die du hinarbeitest. Alles außerhalb davon musst du dafür opfern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de tus %2$lld descartes fueron las opciones menos costosas disponibles, y esa es la cifra que debes buscar: la mano que estás formando lo es todo, y las fichas que quedan fuera son las que sacrificas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de vos %2$lld défausses étaient les moins coûteuses possibles, et c'est ce nombre qu'il faut viser : l'essentiel du jeu, c'est la forme que vous construisez, et tout ce qui n'y contribue pas peut être sacrifié."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dari %2$lld buanganmu adalah pilihan yang paling sedikit merugikan, dan itulah angka yang perlu dikejar: bentuk yang sedang kamu susun adalah inti permainan, sedangkan ubin di luar bentuk itu yang kamu korbankan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong %1$lld/%2$lld lần bỏ quân, bạn đã chọn quân ít ảnh hưởng nhất để bỏ. Hãy hướng tới chỉ số đó: cả ván xoay quanh thế bài bạn đang xây, còn những quân ngoài thế bài ấy là quân có thể bỏ."
          }
        }
      }
    },
    "%lld played": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gespielt"
          }
