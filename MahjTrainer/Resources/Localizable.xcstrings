    },
    "%@ unlocks the extra sets here and in every other room, the Master Tables, coached practice hands as often as you want, Game Night Prep, and Endless Practice. Everything you already have stays free.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schaltet die Extra-Sets hier und in jedem anderen Raum frei, dazu die Meistertische, gecoachte Übungshände so oft du willst, die Spieleabend-Vorbereitung und Endloses Üben. Alles, was du schon hast, bleibt kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desbloquea los sets extra de esta y de todas las salas, las Mesas Maestras, manos de práctica con coach siempre que quieras, Preparar la noche de juego y Práctica sin fin. Todo lo que ya tienes sigue gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ débloque les séries en plus ici et dans toutes les autres salles, les Tables de Maître, les mains coachées à volonté, Préparer la soirée et l'Entraînement infini. Tout ce que vous avez déjà reste gratuit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ membuka set tambahan di sini dan di semua ruang lain, Meja Master, tangan latihan berpelatih sesukamu, Persiapan Malam Main, dan Latihan Tanpa Batas. Semua yang sudah kamu punya tetap gratis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mở các bộ bài tập thêm ở đây và mọi phòng khác, Bàn Cao Thủ, ván luyện có huấn luyện không giới hạn, Chuẩn bị đêm chơi và Luyện tập vô tận. Mọi thứ bạn đang có vẫn miễn phí."
          }
        }
      }
    },
