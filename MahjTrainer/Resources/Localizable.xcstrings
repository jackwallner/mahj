        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los quints necesitan cinco iguales, lo que exige comodines, y este atril no tiene ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quints demandent cinq identiques, donc des jokers, et ce chevalet n'en a aucun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Quint membutuhkan lima ubin sejenis, jadi perlu joker. Rak ini tidak punya joker."
