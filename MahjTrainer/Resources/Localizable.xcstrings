            "state": "translated",
            "value": "Giá này có %lld quân số và chỉ một quân gió hoặc rồng, nên khó tạo bộ Gió & Rồng."
          }
        }
      }
    },
    "This rack has no numbered tiles at all, and %@ is built from numbers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Rack hat gar keine Zahlensteine, und %@ besteht aus Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atril no tiene ninguna ficha con número, y %@ se forma con números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce chevalet n'a aucune tuile numérotée, et %@ se construit avec des nombres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rak ini sama sekali tidak punya ubin angka, sedangkan %@ dibangun dari angka."
          }
        },
        "vi": {
