    "singles and pairs means no pungs or kongs at all, and no jokers anywhere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Singles & Paare bedeutet: keine Pungs, keine Kongs und überhaupt keine Joker"
