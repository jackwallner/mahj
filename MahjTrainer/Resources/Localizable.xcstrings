            "state": "translated",
            "value": "La défausse la moins chère ici était le %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan termurah di sini adalah %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quân rẻ nhất để bỏ ở đây là %@."
          }
        }
      }
    },
    "The coach agrees": {
