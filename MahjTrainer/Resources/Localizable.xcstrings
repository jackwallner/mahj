            "state": "translated",
            "value": "Diesmal nicht. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez no. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas cette fois. %@"
          }
        },
        "id": {
