          }
        }
      }
    },
    "This rack holds %@, and a finished 13579 hand never uses an even number.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Rack hat %@, und eine fertige 13579-Hand nutzt nie eine gerade Zahl."
