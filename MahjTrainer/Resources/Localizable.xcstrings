    "Quints need five of a kind, which takes jokers, and this rack has just one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quints brauchen fünf Gleiche, also Joker, und dieses Rack hat nur einen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los quints necesitan cinco iguales, lo que exige comodines, y este atril solo tiene uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quints demandent cinq identiques, donc des jokers, et ce chevalet n'en a qu'un."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Quint butuh lima yang sama, yang perlu joker, dan rak ini hanya punya satu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quint cần năm quân giống nhau, tức là cần joker, mà giá này chỉ có một."
