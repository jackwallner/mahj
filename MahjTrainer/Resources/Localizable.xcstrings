    "like numbers means the same number across different suits, so a rack spread across several numbers is not it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gleiche Zahlen heißt dieselbe Zahl in verschiedenen Farben, also passt ein Rack mit vielen verschiedenen Zahlen nicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "números iguales es el mismo número en distintos palos, así que un atril repartido entre varios números no lo es"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "nombres identiques veut dire le même nombre dans plusieurs familles : un chevalet étalé sur plusieurs nombres n'en est pas une"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "angka sama berarti angka yang sama di berbagai jenis, jadi rak dengan banyak angka berbeda bukan itu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "số giống nhau là cùng một số ở nhiều chất, nên giá trải ra nhiều số khác nhau thì không phải"
          }
        }
      }
    },
