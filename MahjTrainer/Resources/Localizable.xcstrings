          }
        }
      }
    },
    "Keep it and nothing changes. Not for you? Cancel in Settings > Apple Account > Subscriptions and you won't be charged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte es, dann ändert sich nichts. Nichts für dich? Kündige unter Einstellungen > Apple Account > Abonnements, dann zahlst du nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si te la quedas, no cambia nada. ¿No es para ti? Cancela en Ajustes > Cuenta de Apple > Suscripciones y no se te cobrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez-le et rien ne change. Ce n'est pas pour vous ? Résiliez dans Réglages > Compte Apple > Abonnements et vous ne serez pas facturé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan dan tidak ada yang berubah. Tidak cocok? Batalkan di Pengaturan > Akun Apple > Langganan dan kamu tidak akan ditagih."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục thì không có gì thay đổi. Không hợp với bạn? Hủy trong Cài đặt > Tài khoản Apple > Gói đăng ký và bạn sẽ không bị tính phí."
          }
        }
      }
    },
