    },
    "This rack has %lld numbered tiles and no winds or dragons, so it has little to build a Winds & Dragons hand from.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Rack hat %lld Zahlensteine und keine Winde oder Drachen, bietet also kaum Material für eine Hand mit Winden und Drachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atril tiene %lld fichas numeradas y ningún viento ni dragón, así que ofrece pocas opciones para formar una mano de Vientos y Dragones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce chevalet a %lld tuiles numérotées et aucun vent ni dragon : peu de matière pour une main Vents et Dragons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rak ini punya %lld ubin angka dan tidak punya ubin angin atau naga, jadi bahannya untuk menyusun tangan Angin & Naga sangat terbatas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá này có %lld quân số và không có gió hay rồng, nên khó tạo bộ Gió & Rồng."
          }
        }
      }
    },
    "This rack has %lld numbered tiles and only %lld winds or dragons, so it has little to build a Winds & Dragons hand from.": {
