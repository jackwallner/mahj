    "No pungs or kongs, just single tiles and pairs. No jokers are allowed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Pungs oder Kongs, nur Einzelsteine und Paare. Joker sind nicht erlaubt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin pungs ni kongs, solo fichas sueltas y parejas. No se permiten comodines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni pung ni kong, seulement des tuiles isolées et des paires. Aucun joker autorisé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa pung atau kong, hanya ubin tunggal dan pasangan. Joker tidak boleh dipakai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có pung hay kong, chỉ có quân lẻ và đôi. Không được dùng joker."
          }
        }
      }
    },
