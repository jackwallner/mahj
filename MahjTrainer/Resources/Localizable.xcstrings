    "Pick the day and a five-minute prep built from your own misses lands before you play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den Tag. Vor dem Spiel bekommst du eine 5-Minuten-Vorbereitung, die auf deinen Fehlern basiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el día y, antes de jugar, tendrás una preparación de cinco minutos con tus propios fallos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le jour, et une préparation de cinq minutes basée sur vos erreurs vous attend avant de jouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih harinya, dan sesi persiapan lima menit berdasarkan kesalahanmu akan tersedia sebelum kamu bermain."
          }
        },
        "vi": {
