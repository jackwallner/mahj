    "%@ unlocks the extra sets here and in every other room, the Master Tables, coached practice hands as often as you want, Game Night Prep, and Endless Practice. Everything you already have stays free.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schaltet die Extra-Sets hier und in jedem anderen Raum frei, dazu die Meistertische, angeleitete Übungshände, so oft du willst, die Spieleabend-Vorbereitung und Endloses Üben. Alles, was du schon hast, bleibt kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ desbloquea series extra de ejercicios en esta sala y en todas las demás, las Mesas maestras, manos de práctica guiadas siempre que quieras, Preparar la noche de juego y Práctica sin fin. Todo lo que ya tienes sigue gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ débloque les séries en plus ici et dans toutes les autres salles, les Tables de Maître, les mains d'entraînement guidées à volonté, Préparer la soirée et l'Entraînement infini. Tout ce que vous avez déjà reste gratuit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ membuka set tambahan di sini dan di semua ruang lain, Meja Master, sesi latihan dengan arahan pelatih sesering yang kamu mau, Persiapan Malam Main, dan Latihan Tanpa Batas. Semua yang sudah kamu punya tetap gratis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mở các bộ bài tập thêm ở đây và mọi phòng khác, Bàn Cao Thủ, ván luyện có hướng dẫn không giới hạn, Chuẩn bị buổi chơi và Luyện tập vô tận. Mọi thứ bạn đang có vẫn miễn phí."
          }
        }
      }
    },
