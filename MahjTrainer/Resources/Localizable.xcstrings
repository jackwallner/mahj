    "Quints need five of a kind, which takes jokers, and this rack has just one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Quints braucht man fünf gleiche Steine und Joker. Dieses Rack hat nur einen Joker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los quints necesitan cinco iguales, lo que exige comodines, y este atril solo tiene un comodín."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quints demandent cinq identiques, donc des jokers, et ce chevalet n'en a qu'un."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Quint membutuhkan lima ubin sejenis, jadi perlu joker. Rak ini hanya punya satu joker."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quint cần năm quân giống nhau nên phải dùng joker, mà bài này chỉ có một joker."
          }
        }
      }
    },
    "Quints need five of a kind, which takes jokers, and this rack has none.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Quints braucht man fünf gleiche Steine und Joker. Dieses Rack hat keine Joker."
