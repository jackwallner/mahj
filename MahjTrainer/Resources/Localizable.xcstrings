      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Gerät"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como el dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme l'appareil"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti Perangkat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo thiết bị"
          }
        }
      }
    },
    "Matching and opposite dragons, NEWS, zeros, and which numbers can slide, in Know the Sections. Free for everyone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passende und gegenüberliegende Drachen, NEWS, Nullen und welche Zahlen wandern dürfen, in „Die Sektionen kennen“. Für alle kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragones a juego y opuestos, NEWS, ceros y qué números pueden moverse, en Conoce las secciones. Gratis para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragons assortis et opposés, NEWS, zéros et nombres qui peuvent glisser, dans Connaître les sections. Gratuit pour tous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naga pasangan dan lawan, NEWS, nol, dan angka mana yang bisa bergeser, di Kenali Bagian. Gratis untuk semua."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rồng cùng chất và khác chất, NEWS, số 0 và số nào có thể dịch chuyển, trong Hiểu các nhóm. Miễn phí cho mọi người."
          }
        }
      }
    },
    "Members can set their game night from Home, and a prep reminder brings you back before you play.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitglieder legen ihren Spieleabend auf Home fest, und eine Erinnerung holt dich vor dem Spiel zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros pueden fijar su noche de juego desde Inicio, y un recordatorio te trae de vuelta antes de jugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres choisissent leur soirée de jeu depuis l'accueil, et un rappel vous fait revenir avant de jouer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggota bisa mengatur malam main dari Beranda, dan pengingat persiapan mengajakmu kembali sebelum bermain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thành viên có thể đặt đêm chơi từ Trang chủ, và lời nhắc chuẩn bị sẽ gọi bạn quay lại trước khi chơi."
          }
        }
      }
    },
