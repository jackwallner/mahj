    "like numbers means the same number across different suits, so a rack spread across several numbers is not it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Gleiche Zahlen“ bedeutet: dieselbe Zahl in verschiedenen Farben. Ein Rack mit vielen verschiedenen Zahlen passt also nicht dazu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "en la sección de Números iguales se repite el mismo número en distintos palos, así que un atril con varios números no encaja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la section Nombres identiques désigne un même nombre dans plusieurs familles : un chevalet réparti sur plusieurs nombres n'y correspond donc pas"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "angka sama berarti angka yang sama di berbagai jenis, jadi rak dengan banyak angka berbeda bukan termasuk pola ini"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "số giống nhau là cùng một số ở nhiều chất, nên nếu giá bài có nhiều số khác nhau thì không phải kiểu bài này"
          }
        }
      }
    },
