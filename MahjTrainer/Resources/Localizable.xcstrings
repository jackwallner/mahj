    "Coached practice hands as often as you want, Game Night Prep, endless modes, and %lld more drills": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecoachte Übungshände so oft du willst, Spieleabend-Vorbereitung, endlose Modi und %lld weitere Übungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manos de práctica con coach siempre que quieras, Preparar la noche de juego, modos sin fin y %lld ejercicios más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains coachées à volonté, Préparer la soirée, modes infinis et %lld exercices de plus"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangan latihan berpelatih sesukamu, Persiapan Malam Main, mode tanpa batas, dan %lld latihan lagi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ván luyện có huấn luyện không giới hạn, Chuẩn bị đêm chơi, chế độ vô tận và thêm %lld bài tập"
          }
        }
      }
    },
    "Come back now and then so it stays sharp.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau ab und zu vorbei, damit es sicher bleibt."
          }
        },
        "es": {
