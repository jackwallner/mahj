      }
    },
    "Everything you have stays free. %@ adds a smarter practice rhythm that never runs out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was du hast, bleibt kostenlos. %@ sorgt für einen gezielteren Übungsrhythmus und unbegrenzt neue Aufgaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que tienes sigue gratis. %@ añade una rutina de práctica más inteligente e ilimitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez reste gratuit. %@ ajoute un rythme d'entraînement plus malin, sans fin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua yang kamu punya tetap gratis. %@ menambahkan latihan terarah yang tak pernah habis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ bạn đang có vẫn miễn phí. %@ mang đến nhịp luyện tập hiệu quả hơn với nội dung mới không giới hạn."
          }
        }
      }
    },
