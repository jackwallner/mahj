    "%@ The %@ fits none of it: %@. Of these four it is the safest throw, because every other choice feeds what they are showing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ passt zu nichts davon: %3$@. Von diesen vier ist es der sicherste Abwurf, weil jede andere Wahl füttert, was sie zeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ El %2$@ no encaja en nada de eso: %3$@. De estas cuatro es el descarte más seguro, porque cualquier otra opción alimenta lo que muestran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Le %2$@ ne colle à rien de tout ça : %3$@. Des quatre, c'est la défausse la plus sûre, car chaque autre choix nourrit ce qu'ils montrent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ tidak cocok dengan semua itu: %3$@. Dari keempatnya, ini buangan paling aman, karena pilihan lain malah mengisi yang mereka tunjukkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ không hợp với gì trong đó: %3$@. Trong bốn quân, đây là quân bỏ an toàn nhất, vì mọi lựa chọn khác đều tiếp sức cho thứ họ đang lộ ra."
          }
        }
      }
    },
    "%@ Which three tiles make the strongest pass?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Welche drei Steine sind der stärkste Pass?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ¿Qué tres fichas forman el mejor pase?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Quelles trois tuiles font la meilleure passe ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tiga ubin mana yang jadi operan terkuat?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ba quân nào là lượt chuyền mạnh nhất?"
          }
        }
      }
    },
    "%@ across %lld answered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bei %2$lld beantworteten"
