    "You can see %lld in exposures and %lld in the discards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst %1$lld in den Auslagen und %2$lld bei den Abwürfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves %1$lld en exposiciones y %2$lld en los descartes."
