    "You just broke a group. You were holding %lld of the %@, and rebuilding that costs you tiles somebody else may already be collecting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade eine Gruppe zerbrochen. Du hattest %1$lld × %2$@, und der Neuaufbau kostet Steine, die vielleicht schon jemand anderes sammelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de romper un grupo. Tenías %1$lld del %2$@, y rehacerlo te cuesta fichas que quizá otro ya está juntando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de casser un groupe. Vous aviez %1$lld exemplaires du %2$@, et le reconstruire coûte des tuiles qu'un autre collectionne peut-être déjà."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu baru saja memecah kelompok. Kamu punya %1$lld ubin %2$@, dan membangunnya lagi butuh ubin yang mungkin sedang dikumpulkan orang lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa phá một nhóm. Bạn có %1$lld quân %2$@, và xây lại sẽ tốn những quân có thể người khác đang gom."
          }
        }
      }
