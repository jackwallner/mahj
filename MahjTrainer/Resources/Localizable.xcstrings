    "You just broke a group. You were holding %lld of the %@, and rebuilding that costs you tiles somebody else may already be collecting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade eine Gruppe aufgelöst. Du hattest %1$lld × %2$@, und der Neuaufbau kostet Steine, die vielleicht schon jemand anderes sammelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de romper un grupo. Tenías %1$lld fichas del %2$@, y rehacerlo te cuesta fichas que quizá otro ya esté reuniendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de casser un groupe. Vous aviez %1$lld exemplaires du %2$@, et le reconstituer vous coûte des tuiles qu'un autre joueur cherche peut-être déjà à réunir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu baru saja memecah kelompok. Kamu punya %1$lld ubin %2$@, dan untuk menyusunnya kembali kamu perlu ubin yang mungkin sedang dikumpulkan pemain lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa phá một nhóm. Bạn có %1$lld quân %2$@, và việc xây lại sẽ tốn những quân mà người khác có thể đang gom."
          }
        }
      }
    },
