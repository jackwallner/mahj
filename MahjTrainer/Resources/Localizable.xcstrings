            "state": "translated",
            "value": "Weiter so. Sicher heißt, fast alles hier sitzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue así. Dominado significa que casi todo aquí se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez. Maîtrisé veut dire que presque tout ici est acquis."
          }
        },
