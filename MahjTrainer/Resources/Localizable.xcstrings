    "quints need five of a kind, which is impossible without jokers, so this is a joker question before it is a number question": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quints brauchen fünf Gleiche, was ohne Joker unmöglich ist, also ist es zuerst eine Joker-Frage und dann eine Zahlenfrage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "los quints necesitan cinco iguales, algo imposible sin comodines, así que es cuestión de comodines antes que de números"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les quints demandent cinq identiques, impossible sans jokers : c'est une question de jokers avant d'être une question de nombres"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "quint butuh lima yang sama, mustahil tanpa joker, jadi ini soal joker sebelum soal angka"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "quint cần năm quân giống nhau, không thể có nếu thiếu joker, nên đây là chuyện joker trước khi là chuyện số"
          }
        }
      }
    },
