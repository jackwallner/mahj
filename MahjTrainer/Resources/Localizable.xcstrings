          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dari %2$lld dijawab"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trên %2$lld câu đã trả lời"
          }
        }
      }
    },
    "%@ adds coached practice hands as often as you want, with fresh racks that never run out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bringt gecoachte Übungshände so oft du willst, mit neuen Racks, die nie ausgehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ añade manos de práctica con coach siempre que quieras, con atriles nuevos que nunca se acaban."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajoute des mains coachées à volonté, avec des chevalets toujours nouveaux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menambah tangan latihan berpelatih sesukamu, dengan rak baru yang tak pernah habis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ thêm ván luyện có huấn luyện không giới hạn, với giá mới không bao giờ cạn."
          }
        }
      }
    },
    "%@ adds more of it": {
      "extractionState": "manual",
      "localizations": {
