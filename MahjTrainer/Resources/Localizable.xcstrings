        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat a bien été effectué, mais %@ n'est pas encore débloqué. Patientez un instant, puis touchez Restaurer. Vous ne serez pas facturé deux fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu berhasil, tapi %@ belum terbuka. Tunggu sebentar, lalu ketuk Pulihkan. Kamu tidak akan ditagih dua kali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã thành công nhưng %@ chưa được mở khóa. Chờ một chút rồi nhấn Khôi phục. Bạn sẽ không bị tính phí hai lần."
          }
        }
      }
    },
    "Your seat at the table.": {
      "extractionState": "manual",
      "localizations": {
