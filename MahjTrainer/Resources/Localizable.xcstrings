        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en voyez %1$lld dans les expositions et %2$lld dans les défausses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu melihat %1$lld ubin ini dalam kelompok terbuka dan %2$lld di tumpukan buangan."
