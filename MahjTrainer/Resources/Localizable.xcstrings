    "Help us improve": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf uns, besser zu werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdanos a mejorar"
          }
        },
