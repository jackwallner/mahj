          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn. Góp ý đã đến thẳng nhà phát triển."
          }
        }
      }
    },
    "That didn't go through. Try again, or copy your message and email it to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
