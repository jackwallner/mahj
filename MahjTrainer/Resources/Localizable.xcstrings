    "Met the tiles, still slow on the card": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steine kenne ich, die Karte noch nicht so"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conozco las fichas, me cuesta la tarjeta"
          }
        },
        "fr": {
