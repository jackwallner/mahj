    "Your streak, completed drills, and practice history will be cleared. Purchases are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Serie, erledigte Übungen und dein Verlauf werden gelöscht. Käufe bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán tu racha, los ejercicios completados y tu historial de práctica. Las compras no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre série, vos exercices terminés et votre historique seront effacés. Vos achats ne sont pas concernés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hari latihan beruntunmu, latihan yang sudah diselesaikan, dan riwayat latihanmu akan dihapus. Pembelian tidak terpengaruh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi ngày, bài đã hoàn thành và lịch sử luyện tập sẽ bị xóa. Giao dịch mua không bị ảnh hưởng."
          }
        }
      }
    },
    "Your trial won't renew. What held you back?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase verlängert sich nicht. Was hat dich abgehalten?"
