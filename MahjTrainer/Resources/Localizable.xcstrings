    "Eight jokers are in the set. %lld held, %lld exposed and %lld discarded leaves %lld unseen. The exposed ones are not gone: hold the matching real tile and you can swap one out on your turn.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Set sind acht Joker. %1$lld sind auf der Hand, %2$lld liegen offen aus und %3$lld wurden abgeworfen. %4$lld sind noch nicht sichtbar. Die ausgelegten Joker sind nicht aus dem Spiel: Mit dem passenden echten Stein kannst du in deinem Zug einen austauschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego tiene ocho comodines. Con %1$lld en mano, %2$lld expuestos y %3$lld descartados, quedan %4$lld sin ver. Los expuestos no se han perdido: con la ficha real que corresponde puedes cambiar uno en tu turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu compte huit jokers. %1$lld en main, %2$lld exposés et %3$lld défaussés laissent %4$lld non vus. Les exposés ne sont pas perdus : avec la vraie tuile correspondante, vous pouvez en échanger un à votre tour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada delapan joker dalam satu set. %1$lld dipegang, %2$lld terbuka, dan %3$lld dibuang, jadi masih ada %4$lld yang belum terlihat. Joker yang terbuka belum hilang: pegang ubin asli yang cocok dan kamu bisa menukarnya pada giliranmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ bài có tám joker. %1$lld trên tay, %2$lld đã lộ và %3$lld đã bỏ, còn %4$lld chưa thấy. Joker đã lộ chưa mất hẳn: nếu có quân thật tương ứng, bạn có thể đổi lấy một joker vào lượt mình."
          }
        }
      }
    },
    "Endless Practice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endloses Üben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica sin fin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînement infini"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Tanpa Batas"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện tập vô tận"
          }
        }
      }
    },
    "Endless Practice deals a fresh rack every time": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endloses Üben gibt jedes Mal ein neues Rack"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica sin fin reparte un atril nuevo cada vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Entraînement infini distribue un nouveau chevalet à chaque fois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Tanpa Batas memberimu rak baru setiap kali"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lượt Luyện tập vô tận đều có một tay bài mới"
          }
        }
      }
    },
    "Endless Practice now deals Charleston passes and defensive discards as well as racks and tile counts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endloses Üben bietet jetzt neben Racks auch Charleston-Pässe, defensive Abwürfe und Aufgaben zum Steinezählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica sin fin ahora reparte pases del Charleston y descartes defensivos, además de atriles y conteo de fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Entraînement infini propose désormais des passes de Charleston et des défausses défensives, en plus des chevalets et du comptage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Tanpa Batas kini juga mencakup operan Charleston dan strategi membuang ubin dengan aman, selain membaca rak dan menghitung ubin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện tập vô tận giờ có thêm bài luyện chuyền Charleston và quyết định bỏ quân phòng thủ, bên cạnh phân tích tay bài và đếm quân."
          }
        }
      }
    },
    "Endless Practice, never repeats": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endloses Üben, ohne Wiederholung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica sin fin, siempre diferente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînement infini, sans répétition"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Tanpa Batas, tak pernah berulang"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện tập vô tận, không lặp lại"
          }
        }
      }
    },
    "Endless Practice: fresh racks, passes and defensive calls, forever": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endloses Üben: neue Racks, Pässe und Abwehrentscheidungen, ohne Ende"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica sin fin: atriles, pases y decisiones defensivas siempre disponibles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînement infini : chevalets, passes et choix défensifs, sans fin"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Tanpa Batas: rak, operan, dan keputusan bertahan baru, tanpa henti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện tập vô tận: tay bài mới, lượt chuyền và quyết định phòng thủ không giới hạn"
          }
        }
      }
    },
    "Every beginner room is free, forever": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Einsteigerraum ist für immer kostenlos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las salas para principiantes, gratis para siempre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les salles pour débutants sont gratuites, à vie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ruang pemula gratis, selamanya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi phòng cho người mới đều miễn phí, mãi mãi"
          }
        }
      }
    },
    "Every call you make here is one you'll make faster at the table.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Entscheidung, die du hier triffst, triffst du am Tisch schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada decisión que tomas aquí la tomarás más rápido en la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décisions que vous prenez ici vous viendront plus vite à table."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap keputusan yang kamu latih di sini akan makin cepat kamu ambil di meja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi quyết định bạn đưa ra ở đây sẽ giúp bạn xử lý nhanh hơn khi chơi thực tế."
          }
        }
      }
    },
    "Every hand here is dealt fresh the moment you see it, so you can practice for as long as you like without repeating a question.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Hand hier wird neu gegeben, sobald du sie siehst. So kannst du beliebig lange üben, ohne dass sich eine Frage wiederholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mano se reparte nueva en el momento en que la ves, así que puedes practicar cuanto quieras sin repetir preguntas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque main est distribuée au moment où vous la voyez : vous pouvez vous entraîner aussi longtemps que vous voulez sans jamais revoir une question."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap sesi latihan di sini dimulai dengan rak baru begitu kamu membukanya, jadi kamu bisa berlatih selama yang kamu mau tanpa mengulang soal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi khi mở ra, bạn sẽ được chia một ván mới, nên có thể luyện bao lâu tùy thích mà không gặp lại câu hỏi cũ."
          }
        }
      }
    },
    "Every number here is a 3, 6 or 9. The 6 rules out a pure odds hand and the 3 or 9 rules out a pure evens hand, so 369 is the read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zahl hier ist eine 3, 6 oder 9. Die 6 schließt eine reine Hand mit ungeraden Zahlen aus, und die 3 oder 9 eine reine Hand mit geraden Zahlen. Also ist es 369."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números aquí son 3, 6 o 9. El 6 descarta una mano solo de impares y el 3 o el 9 una solo de pares, así que la lectura es 369."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les nombres ici sont des 3, 6 ou 9. Le 6 exclut une main composée uniquement de nombres impairs, et le 3 ou le 9 exclut une main composée uniquement de nombres pairs : c'est donc 369."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka di sini 3, 6, atau 9. Angka 6 menyingkirkan tangan ganjil murni dan 3 atau 9 menyingkirkan tangan genap murni, jadi bacaannya 369."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số ở đây là 3, 6 hoặc 9. Số 6 loại bộ toàn lẻ, còn 3 hoặc 9 loại bộ toàn chẵn, nên đây là 369."
          }
        }
      }
    },
    "Every number here is odd (%@). That points straight at 13579, the mirror image of the evens section.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zahl hier ist ungerade (%@). Das zeigt direkt auf 13579, das Spiegelbild der geraden Sektion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números aquí son impares (%@). Eso apunta directamente a 13579, el reflejo de la sección de pares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les nombres ici sont impairs (%@). Cela indique clairement la section 13579, le pendant de la section des nombres pairs."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka di sini ganjil (%@). Itu langsung mengarah ke 13579, cermin dari bagian genap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi số ở đây đều lẻ (%@). Đây là dấu hiệu rõ ràng của nhóm 13579, đối xứng với nhóm toàn số chẵn."
          }
        }
      }
    },
    "Every number on this rack is even (%@), with no honors at all. That is 2468 territory, and every odd tile you pick up is dead weight for it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zahl auf diesem Rack ist gerade (%@), ganz ohne Ehrensteine. Das ist typisch für 2468, und jeder ungerade Stein ist dafür Ballast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los números de este atril son pares (%@) y no hay honores. Eso apunta a la mano 2468; cualquier ficha impar que robes te sobrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les nombres de ce chevalet sont pairs (%@), sans aucun honneur. C'est le terrain de 2468, et chaque tuile impaire ramassée est un poids mort."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua angka di rak ini genap (%@), tanpa ubin kehormatan. Itu wilayah 2468, dan setiap ubin ganjil yang kamu ambil jadi beban."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi quân số trên tay bài này đều chẵn (%@), không có quân chữ nào. Đây là dạng bài 2468, nên quân lẻ nào bạn rút cũng không có ích."
          }
        }
      }
    },
    "Every pass you pick here is one you'll make faster at the table.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Pass-Auswahl, die du hier übst, triffst du am Tisch schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pase que eliges aquí lo harás más rápido en la mesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous choisirez plus vite vos passes à table après vous être entraîné ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan memilih operan di sini akan membuatmu lebih cepat saat bermain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lượt chuyền bạn chọn ở đây sẽ giúp bạn quyết định nhanh hơn khi chơi thực tế."
          }
        }
      }
    },
    "Every rack below is an original teaching example for the shape of the section. For the actual hands and their values, use the current NMJL card.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Rack hier ist ein eigens erstelltes Lehrbeispiel für das Muster der Sektion. Die tatsächlichen Hände und ihre Werte findest du auf der aktuellen NMJL-Karte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada atril de abajo es un ejemplo original de la forma de la sección. Para las manos reales y sus valores, usa la tarjeta NMJL actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chevalet ci-dessous est un exemple pédagogique original de la structure de la section. Pour les mains officielles et leurs valeurs, consultez la carte NMJL actuelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap rak di bawah adalah contoh orisinal untuk mengajarkan pola pada bagian ini. Untuk tangan dan nilainya yang sebenarnya, lihat kartu NMJL terbaru."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tay bài bên dưới là ví dụ hướng dẫn được biên soạn riêng để minh họa cấu trúc của nhóm. Để xem các tay bài thực tế và điểm số, hãy tham khảo thẻ NMJL hiện hành."
          }
        }
      }
    },
    "Every rack you read here is one you'll read faster at the table.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit jedem Rack, das du hier analysierst, kannst du Racks am Tisch schneller einschätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás interpretar más rápido en la mesa cada mano que analices aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous lirez plus vite les chevalets à table après vous être entraîné ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap rak yang kamu pelajari di sini akan membantumu membaca rak lebih cepat saat bermain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi tay bài bạn phân tích ở đây sẽ giúp bạn đọc bài nhanh hơn khi chơi thực tế."
          }
        }
      }
    },
    "Everything in %@, starting today.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in %@, ab heute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo de %@, desde hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout %@, dès aujourd'hui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua di %@, mulai hari ini."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
