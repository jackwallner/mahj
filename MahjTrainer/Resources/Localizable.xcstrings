    "Ninety seconds, as many correct reads as you can manage, and a personal best to chase.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neunzig Sekunden, so viele richtige Antworten wie möglich und ein persönlicher Rekord, den es zu knacken gilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noventa segundos, tantos aciertos como puedas y un récord personal que batir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre-vingt-dix secondes, un maximum de bonnes réponses et un record à battre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembilan puluh detik untuk membaca rak sebanyak mungkin dengan benar dan mengejar rekor pribadimu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chín mươi giây, càng nhiều câu đúng càng tốt, và một kỷ lục cá nhân để phá."
          }
        }
      }
    },
    "No choice questions are due. Review missed three-tile passes and flip cards in their room drills.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Auswahlfragen fällig. Wiederhole falsch gelöste Pässe mit drei Steinen und Lernkarten in den jeweiligen Raumübungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay preguntas de opción múltiple pendientes. Repasa los pases de tres fichas que fallaste y las tarjetas que respondiste mal en los ejercicios de cada sala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune question à choix à revoir. Revoyez les passes de trois tuiles et les cartes ratées dans les exercices des salles correspondantes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada soal pilihan ganda yang perlu ditinjau. Tinjau lagi operan tiga ubin dan kartu belajar yang salah di ruang latihan masing-masing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có câu trắc nghiệm nào cần ôn. Hãy xem lại các lượt chuyền ba quân và thẻ ghi nhớ bạn đã làm sai trong bài tập của từng phòng."
          }
        }
      }
    },
