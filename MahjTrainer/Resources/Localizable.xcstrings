    "Get Started": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Los geht's"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu"
          }
        }
      }
    },
    "Get Started builds this same five-minute mix any time from Home: exactly what you need next, misses first. Let's run your first one now.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Los geht's“ stellt dir diesen 5-Minuten-Mix jederzeit auf der Startseite zusammen: genau das, was du als Nächstes brauchst, mit falsch beantworteten Fragen zuerst. Lass uns jetzt deine erste Runde starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Empezar en Inicio para generar esta misma mezcla de cinco minutos cuando quieras: justo lo que necesitas, con tus fallos primero. Vamos con la primera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton Commencer crée à tout moment, depuis l'accueil, ce même programme de cinq minutes : exactement ce qu'il vous faut ensuite, en commençant par vos erreurs. Lançons le premier maintenant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari Beranda, ketuk Mulai kapan saja untuk membuat sesi latihan lima menit yang sesuai kebutuhanmu, dimulai dengan soal yang pernah kamu jawab salah. Ayo coba sesi pertamamu sekarang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ Trang chủ, bạn có thể nhấn Bắt đầu để tạo phiên luyện 5 phút này bất cứ lúc nào, tập trung vào nội dung bạn cần tiếp theo và ưu tiên các câu trả lời sai. Hãy thử phiên đầu tiên ngay."
          }
        }
      }
    },
    "Get each question right twice running to lock it in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte jede Frage zweimal hintereinander richtig, damit sie sitzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acierta cada pregunta dos veces seguidas para afianzarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réussissez chaque question deux fois de suite pour la maîtriser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawab setiap soal dengan benar dua kali berturut-turut agar kamu menguasainya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời đúng mỗi câu hai lần liên tiếp để nắm chắc."
          }
        }
      }
    },
    "Get ready for game night": {
      "extractionState": "manual",
      "localizations": {
