    "Right. %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtig. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correcto. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste. %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Benar. %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng. %@"
          }
        }
      }
    },
    "Right. The %@ is outside the %@ shape you are building, and tiles that don't fit your shape are the ones to spend first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtig. %1$@ liegt außerhalb der %2$@-Form, die du aufbaust. Steine, die nicht zu deiner Form passen, wirfst du zuerst ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correcto. El %1$@ queda fuera del patrón %2$@ que estás formando, y conviene descartar primero las fichas que no encajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Juste. Le %1$@ ne correspond pas à la forme %2$@ que vous construisez ; défaussez d'abord les tuiles qui n'y correspondent pas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Benar. %1$@ di luar bentuk %2$@ yang kamu bangun, dan ubin yang tidak cocok dengan bentukmu dibuang lebih dulu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng. %1$@ nằm ngoài dạng bài %2$@ bạn đang theo; những quân không hợp với bài là quân nên bỏ trước."
          }
        }
      }
    },
