    "Search any term or read any section from the book icon on Home. Free, and built for looking something up mid-game.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über das Buchsymbol auf der Startseite kannst du jeden Begriff suchen und jeden Abschnitt nachlesen. Kostenlos und ideal zum Nachschlagen mitten im Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca cualquier término o lee cualquier sección desde el icono del libro en Inicio. Gratis y pensado para consultar en plena partida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez un terme ou consultez une section depuis l'icône du livre sur l'accueil. C'est gratuit et pensé pour retrouver une information en pleine partie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari istilah atau baca bagian mana pun lewat ikon buku di Beranda. Gratis dan dirancang untuk mencari informasi saat permainan berlangsung."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở biểu tượng sách trên Trang chủ để tra cứu thuật ngữ hoặc đọc bất kỳ mục nào. Miễn phí, tiện tra cứu ngay giữa ván."
          }
        }
