    "singles and pairs means no pungs or kongs at all, and no jokers anywhere": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Singles & Paare heißt gar keine Pungs oder Kongs und nirgends Joker"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sueltas y parejas significa ningún pung ni kong, y ningún comodín"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "simples et paires veut dire aucun pung, aucun kong et aucun joker"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tunggal dan pasangan berarti sama sekali tanpa pung atau kong, dan tanpa joker"
