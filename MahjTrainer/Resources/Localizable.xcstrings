    "You have %lld on your rack and can see %lld exposed on other racks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$lld auf deinem Rack und siehst %2$lld offen auf den Racks der anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$lld en tu atril y ves %2$lld expuestas en otros atriles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en avez %1$lld sur votre chevalet et en voyez %2$lld dans les expositions des autres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu punya %1$lld ubin ini di rak dan bisa melihat %2$lld ubin yang sama terbuka di rak lain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có %1$lld quân trên giá và thấy %2$lld quân lộ trên giá của người khác."
          }
        }
      }
    },
    "You have %lld on your rack and can see none showing on the table.": {
      "extractionState": "manual",
