    "Good throw. It fits %@, but you were holding only %lld of it, so it was the cheapest thing on your rack.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guter Abwurf. Er passt zu %1$@, aber du hattest nur %2$lld davon, also war er das Billigste auf deinem Rack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen descarte. Encaja en %1$@, pero solo tenías %2$lld, así que era lo más barato de tu atril."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonne défausse. Elle colle à %1$@, mais vous n'en aviez que %2$lld : c'était le moins cher de votre chevalet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan bagus. Cocok dengan %1$@, tapi kamu hanya punya %2$lld, jadi itu yang paling murah di rakmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ tốt. Nó hợp với %1$@, nhưng bạn chỉ có %2$lld quân, nên đó là thứ rẻ nhất trên giá."
          }
        }
      }
    },
    "Good throw. It fits %@, but you were holding only one of it, so it was the cheapest thing on your rack.": {
      "extractionState": "manual",
      "localizations": {
