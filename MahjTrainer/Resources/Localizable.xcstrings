    "You hold %lld of the %@. Passing one breaks up a pung you have already made, when another tile on this rack costs you nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$lld × %2$@. Einen abzugeben zerbricht einen fertigen Pung, während ein anderer Stein auf dem Rack dich nichts kostet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$lld del %2$@. Pasar uno rompe un pung que ya tienes hecho, cuando otra ficha del atril no te cuesta nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %1$lld exemplaires du %2$@. En passer un casse un pung déjà formé, alors qu'une autre tuile du chevalet ne vous coûte rien."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memegang %1$lld ubin %2$@. Mengoper satu memecah pung yang sudah jadi, padahal ubin lain di rak ini tidak merugikanmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có %1$lld quân %2$@. Chuyền một quân sẽ phá pung bạn đã có, trong khi quân khác trên giá chẳng tốn gì."
          }
        }
      }
    },
    "You hold %lld of the %@. Passing one splits a pair, when another tile on this rack costs you nothing.": {
