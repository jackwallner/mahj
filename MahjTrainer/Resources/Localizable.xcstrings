          }
        }
      }
    },
    "%@ challenge: %@. Today's Mahj Minute is done.": {
      "comment": "The month's name, then a point count",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-Challenge: %2$@. Die heutige Mahj-Minute ist erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reto de %1$@: %2$@. Ya terminaste el Mahj Minute de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défi du mois : %1$@, %2$@. Le Mahj Minute du jour est terminé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantangan %1$@: %2$@. Mahj Minute hari ini selesai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử thách %1$@: %2$@. Đã xong Mahj Minute hôm nay."
          }
        }
      }
    },
    "%@ could use some of these tiles, but more of them point to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ könnte einige dieser Steine gebrauchen, aber die meisten sprechen für %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ podría usar algunas de estas fichas, pero la mayoría apunta a %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pourrait utiliser certaines de ces tuiles, mais la plupart pointent vers %2$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bisa memakai sebagian ubin ini, tapi lebih banyak yang mengarah ke %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ có thể dùng một vài quân này, nhưng phần lớn lại hợp với %2$@ hơn."
          }
        }
      }
    },
    "%@ deals a new hand whenever you want one, coached on every throw.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gibt dir jederzeit eine neue Hand und begleitet dich bei jedem Abwurf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te reparte una mano nueva cuando quieras y te guía en cada descarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous distribue une nouvelle main à chaque demande, avec les conseils d'un coach à chaque défausse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ memberimu sesi latihan baru kapan pun kamu mau, dengan arahan pelatih pada setiap ubin yang kamu buang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chia ván mới bất cứ khi nào bạn muốn, với huấn luyện viên hướng dẫn mỗi lần bỏ quân."
          }
        }
      }
    },
    "%@ first, followed by material you have not seen yet.": {
      "comment": "A count of due mistakes",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst %@, danach kommen Inhalte, die du noch nicht kennst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero %@, luego material que aún no has visto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'abord %@, puis du contenu que vous n'avez pas encore vu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dulu, lalu materi yang belum pernah kamu lihat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên là %@, tiếp theo là nội dung bạn chưa xem."
          }
        }
      }
    },
    "%@ first, then extra work in %@.": {
      "comment": "A count of due mistakes, then a room name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
