          }
        }
      }
    },
    "This rack has %lld numbered tiles and only one wind or dragon, so it has little to build a Winds & Dragons hand from.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Rack hat %lld Zahlensteine und nur einen Wind oder Drachen, also wenig für eine Winde-&-Drachen-Hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este atril tiene %lld fichas con número y solo un viento o dragón, así que hay poco para una mano de Vientos y Dragones."
