    "Built around the current year's digits, with soaps standing in for zeros. Spot it when you're holding 2s and soaps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgebaut aus den Ziffern des aktuellen Jahres, Soaps stehen für Nullen. Erkennbar, wenn du 2er und Soaps hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se basa en los dígitos del año actual, con soaps como ceros. Se reconoce cuando tienes doses y soaps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construite autour des chiffres de l'année, avec des soaps pour les zéros. On la repère quand on a des 2 et des soaps."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibangun dari angka tahun ini, dengan soap sebagai nol. Kenali saat kamu memegang angka 2 dan soap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xây quanh các chữ số của năm hiện tại, với soap thay cho số 0. Nhận ra khi bạn có nhiều số 2 và soap."
          }
        }
      }
    },
    "Built around your week": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
