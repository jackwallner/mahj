        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica sin fin reparte un atril nuevo cada vez"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Entraînement infini distribue un nouveau chevalet à chaque fois"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Tanpa Batas membagikan rak baru setiap kali"
