    "A fresh mix lands tomorrow. Keep going in any room below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morgen gibt es einen neuen Mix. Mach in einem Raum unten weiter."
          }
        },
        "es": {
