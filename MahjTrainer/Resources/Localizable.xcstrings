    "%@ is where most of this rack already points. Play it out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Steine auf deinem Rack passen schon zu %@. Spiel die Hand aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor parte de este atril ya apunta a %@. Juégala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des tuiles de ce chevalet correspondent déjà à %@. Jouez cette main."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian besar rak ini sudah mengarah ke %@. Mainkan sampai selesai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần lớn quân trên tay bài này đều phù hợp với %@. Hãy tiếp tục theo hướng đó."
          }
        }
      }
    },
