    "Your purchase went through, but %@ hasn't unlocked yet. Give it a moment, then tap Restore.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kauf hat geklappt, aber %@ ist noch nicht freigeschaltet. Warte kurz und tippe dann auf Wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se realizó, pero %@ aún no se ha desbloqueado. Espera un momento y toca Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est passé, mais %@ n'est pas encore débloqué. Patientez un instant, puis touchez Restaurer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu berhasil, tapi %@ belum terbuka. Tunggu sebentar, lalu ketuk Pulihkan."
          }
        },
        "vi": {
