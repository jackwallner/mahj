    "Starts %@. A Mahj Minute every day: five new questions, the same for every player.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet am %@. Jeden Tag eine Mahj Minute: fünf neue Fragen, für alle gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza el %@. Un Mahj Minute cada día: cinco preguntas nuevas, las mismas para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence le %@. Un Mahj Minute chaque jour : cinq nouvelles questions, les mêmes pour tous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai %@. Mahj Minute setiap hari: lima soal baru, sama untuk semua pemain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu từ %@. Mỗi ngày một Mahj Minute: năm câu mới, giống nhau cho mọi người."
          }
        }
      }
    },
    "Still checking what this Apple Account owns. Try again in a moment, or tap Restore.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir prüfen noch, was zu diesem Apple Account gehört. Versuch es gleich noch mal oder tippe auf Wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún estamos comprobando las compras de esta cuenta de Apple. Inténtalo en un momento o toca Restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification des achats de ce compte Apple en cours. Réessayez dans un instant ou touchez Restaurer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih memeriksa pembelian Akun Apple ini. Coba lagi sebentar, atau ketuk Pulihkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra giao dịch của Tài khoản Apple này. Thử lại sau giây lát hoặc chạm Khôi phục."
          }
        }
      }
    },
    "Still learning what the tiles even are": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lerne gerade die Steine kennen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún estoy conociendo las fichas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je découvre à peine les tuiles"
          }
        },
