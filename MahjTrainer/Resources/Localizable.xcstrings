    },
    "%@ The %@ fits none of it: %@. Of these four it is the safest throw, because every other choice feeds what they are showing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ passt zu nichts davon: %3$@. Von diesen vier ist es der sicherste Abwurf, denn jede andere Wahl spielt den anderen in die Hände."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ La ficha %2$@ no encaja en nada de eso: %3$@. De estas cuatro es el descarte más seguro, porque cualquier otra opción ayudaría a completar las manos que están formando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Le %2$@ ne convient à aucune de ces mains : %3$@. Parmi ces quatre choix, c'est la défausse la plus sûre, car les autres pourraient compléter les combinaisons qu'ils exposent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ tidak cocok dengan satu pun: %3$@. Dari keempatnya, ini yang paling aman dibuang karena pilihan lain bisa membantu lawan melengkapi pola yang mereka tunjukkan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ không khớp với bất kỳ nhóm nào trong %3$@. Trong bốn quân, đây là quân an toàn nhất để đánh ra, vì những lựa chọn khác đều có thể giúp đối thủ hoàn thành bộ bài họ đang theo."
          }
        }
      }
    },
    "%@ Which three tiles make the strongest pass?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Welche drei Steine gibst du am besten weiter?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ¿Qué tres fichas forman el mejor pase?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Quelles trois tuiles font la meilleure passe ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tiga ubin mana yang paling tepat untuk dioper?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ba quân nào tạo thành lượt chuyền tốt nhất?"
          }
        }
      }
    },
    "%@ across %lld answered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bei %2$lld beantworteten Fragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en %2$lld respuestas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$lld réponses"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dari %2$lld soal yang dijawab"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trên %2$lld câu đã trả lời"
          }
        }
      }
    },
    "%@ adds coached practice hands as often as you want, with fresh racks that never run out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bietet dir unbegrenzt viele angeleitete Übungshände mit immer neuen Racks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te ofrece manos de práctica guiadas sin límite, cada una con un atril nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajoute des mains d'entraînement guidées à volonté, avec un nouveau chevalet à chaque fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ menyediakan sesi latihan dengan arahan pelatih sesering yang kamu mau, selalu dengan rak baru."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bổ sung các ván luyện có hướng dẫn không giới hạn, với tay bài mới liên tục."
          }
        }
      }
    },
    "%@ adds more of it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bietet mehr davon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te da más"
