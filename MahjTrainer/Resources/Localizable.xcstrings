    "None of them have paired up yet, and pairs are what turn a collection into a hand.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher hat sich noch kein Paar gebildet, und erst Paare machen aus einer Sammlung eine Hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna ha formado pareja todavía, y las parejas son lo que convierte una colección en una mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune n'a encore formé de paire, et ce sont les paires qui transforment une collection en main."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada ubin yang berpasangan, padahal pasangan menjadi dasar untuk membentuk satu tangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có quân nào ghép thành đôi, mà chính các đôi mới biến những quân rời rạc thành một bài hoàn chỉnh."
          }
        }
      }
    },
