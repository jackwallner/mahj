          "stringUnit": {
            "state": "translated",
            "value": "Masih belajar mengenal ubin"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang làm quen với quân bài"
          }
        }
      }
    },
    "Streaks make it stick": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien sorgen fürs Dranbleiben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rachas lo afianzan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries ancrent les acquis"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan rutin membuatmu tetap ingat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi ngày giúp bạn nhớ lâu"
          }
        }
      }
    },
    "Support": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistance"
          }
        },
