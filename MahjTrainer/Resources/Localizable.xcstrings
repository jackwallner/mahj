            "state": "translated",
            "value": "Bel entraînement !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan yang bagus!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện tập tốt lắm!"
          }
        }
      }
    },
    "Good throw. It fits %@, but you were holding only %lld of it, so it was the cheapest thing on your rack.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guter Abwurf. Er passt zu %1$@, aber du hattest nur %2$lld davon, also war er der entbehrlichste Stein auf deinem Rack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen descarte. Encaja en %1$@, pero solo tenías %2$lld, así que era la ficha que menos te costaba descartar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonne défausse. Elle convient à %1$@, mais vous n'en aviez que %2$lld : c'était donc la tuile que vous pouviez défausser au moindre coût."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan bagus. Cocok dengan %1$@, tapi kamu hanya memegang %2$lld ubin itu, jadi membuangnya paling sedikit merugikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ quân khéo. Quân này hợp với %1$@, nhưng bạn chỉ có %2$lld quân cùng loại, nên đây là quân ít ảnh hưởng nhất để bỏ."
          }
        }
      }
    },
    "Good throw. It fits %@, but you were holding only one of it, so it was the cheapest thing on your rack.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guter Abwurf. Er passt zu %@, aber du hattest nur einen davon, also war er der entbehrlichste Stein auf deinem Rack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buen descarte. Encaja en %@, pero solo tenías una, así que era la ficha que menos te costaba descartar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonne défausse. Elle convient à %@, mais vous n'en aviez qu'une : c'était donc la tuile que vous pouviez défausser au moindre coût."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buangan bagus. Cocok dengan %@, tapi kamu hanya punya satu, jadi membuangnya paling sedikit merugikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ quân khéo. Quân này hợp với %@, nhưng bạn chỉ có một quân cùng loại, nên đây là quân ít ảnh hưởng nhất để bỏ."
          }
        }
      }
    },
