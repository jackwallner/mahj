    "%lld of them are already sitting in a group of two or more, which is the half that counts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld davon stecken schon in einer Gruppe ab zwei, und das ist die Hälfte, die zählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ya están en un grupo de dos o más, que es la mitad que cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sont déjà dans un groupe de deux ou plus, et c'est la moitié qui compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld di antaranya sudah ada di kelompok dua atau lebih, dan itu bagian yang penting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld quân đã nằm trong nhóm từ hai quân trở lên, và đó là nửa quan trọng."
          }
        }
      }
    },
    "%lld of your %lld throws were the cheapest one available, and that is the number to chase: the shape you are building toward is the whole game, and everything outside it is what you spend.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld deiner %2$lld Abwürfe waren der günstigste mögliche, und das ist die Zahl, die zählt: Die Form, die du baust, ist das ganze Spiel, und alles außerhalb davon gibst du aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de tus %2$lld descartes fueron los más baratos posibles, y ese es el número a perseguir: la forma que estás armando lo es todo, y lo que queda fuera es lo que gastas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de vos %2$lld défausses étaient les moins chères possibles, et c'est ce chiffre qui compte : la forme que vous visez est tout le jeu, et tout ce qui est hors d'elle, vous le dépensez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld dari %2$lld buanganmu adalah yang termurah, dan itu angka yang perlu dikejar: bentuk yang kamu bangun adalah inti permainan, dan semua di luarnya yang kamu buang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld lần bỏ quân của bạn là lựa chọn rẻ nhất, và đó là con số cần theo đuổi: hình bạn đang xây là cả ván chơi, còn mọi thứ ngoài nó là thứ để bỏ."
          }
        }
      }
    },
