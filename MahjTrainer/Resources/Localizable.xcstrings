    "%@ one-time. Not a subscription, nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ einmalig. Kein Abo, nichts verlängert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en un solo pago. No es una suscripción, nada se renueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en une fois. Pas d'abonnement, rien ne se renouvelle."
