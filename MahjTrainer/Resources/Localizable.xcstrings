      }
    },
    "Endless Practice now deals Charleston passes and defensive discards as well as racks and tile counts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endloses Üben gibt jetzt neben Racks und Steinzählen auch Charleston-Pässe und defensive Abwürfe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Práctica sin fin ahora reparte pases del Charleston y descartes defensivos, además de atriles y conteo de fichas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Entraînement infini propose désormais des passes de Charleston et des défausses défensives, en plus des chevalets et du comptage."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan Tanpa Batas kini membagikan operan Charleston dan buangan bertahan, selain rak dan hitungan ubin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện tập vô tận giờ có thêm lượt chuyền Charleston và bỏ quân phòng thủ, bên cạnh đọc giá và đếm quân."
          }
        }
      }
    },
    "Endless Practice, never repeats": {
