          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra se realizó, pero %@ aún no se ha desbloqueado. Espera un momento y toca Restaurar. No se te cobrará dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat est passé, mais %@ n'est pas encore débloqué. Patientez un instant, puis touchez Restaurer. Vous ne serez pas facturé deux fois."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelianmu berhasil, tapi %@ belum terbuka. Tunggu sebentar, lalu ketuk Pulihkan. Kamu tidak akan ditagih dua kali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
