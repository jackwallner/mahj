        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pase entrega %@, pero el mejor pase lo conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette passe cède %@, que la meilleure passe conserve."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operan ini melepas %@, yang disimpan oleh operan terkuat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lượt này chuyền %@ đi, dù lượt chuyền tốt nhất sẽ giữ lại quân đó."
          }
        }
      }
    },
    "This pass sends %@, which the strongest pass holds back.": {
