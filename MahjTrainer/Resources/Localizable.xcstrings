            "state": "translated",
            "value": "Je connais les tuiles, pas encore la carte"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenal ubin, masih lambat baca kartu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biết quân bài, đọc thẻ còn chậm"
          }
        }
      }
    },
    "Minute complete": {
      "extractionState": "manual",
      "localizations": {
        "de": {
