    "You can see %lld in exposures and %lld in the discards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst %1$lld in Auslagen und %2$lld bei den Abwürfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves %1$lld en exposiciones y %2$lld en los descartes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en voyez %1$lld dans les expositions et %2$lld dans les défausses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu melihat %1$lld di ekspos dan %2$lld di buangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thấy %1$lld ở quân lộ và %2$lld ở quân bỏ."
          }
        }
      }
    },
    "You can see %lld in exposures and none in the discards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst %lld in Auslagen und keinen bei den Abwürfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ves %lld en exposiciones y ninguno en los descartes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous en voyez %lld dans les expositions et aucun dans les défausses."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu melihat %lld di ekspos dan tidak ada di buangan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn thấy %lld ở quân lộ và không thấy quân nào ở quân bỏ."
