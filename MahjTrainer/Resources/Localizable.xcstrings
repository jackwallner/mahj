    "One payment. No subscription, nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal zahlen. Kein Abo, nichts verlängert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago. Sin suscripción, nada se renueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
