    "One-time purchase. Not a subscription, nothing renews.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalkauf. Kein Abo, nichts verlängert sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
