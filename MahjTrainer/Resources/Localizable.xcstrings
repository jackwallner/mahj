    "New hand-written questions across the tiles, the card, the Charleston, the table, and the Master Tables.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue handgeschriebene Fragen zu Steinen, Karte, Charleston, Tisch und den Meistertischen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevas preguntas escritas a mano sobre las fichas, la tarjeta, el Charleston, la mesa y las Mesas Maestras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nouvelles questions écrites à la main sur les tuiles, la carte, le Charleston, la table et les Tables de Maître."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Soal baru buatan tangan tentang ubin, kartu, Charleston, meja, dan Meja Master."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu hỏi mới viết tay về quân bài, thẻ, Charleston, bàn chơi và Bàn Cao Thủ."
          }
        }
      }
    },
