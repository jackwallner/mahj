    "You hold %lld of the %@. Passing one breaks up a pung you have already made, when another tile on this rack costs you nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$lld × %2$@. Gibst du einen davon ab, löst du einen fertigen Pung auf, obwohl du stattdessen einen anderen Stein abgeben könntest, ohne etwas zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$lld fichas del %2$@. Pasar una ficha rompería el pung que ya has formado, aunque podrías pasar otra del atril sin perder nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %1$lld exemplaires du %2$@. En passer un casse un pung déjà formé, alors qu'une autre tuile du chevalet ne vous coûte rien."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memegang %1$lld ubin %2$@. Mengoper satu memecah pung yang sudah jadi, padahal ubin lain di rak ini tidak merugikanmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có %1$lld quân %2$@. Chuyền một quân sẽ phá pung bạn đã có, trong khi chuyền một quân khác trên giá sẽ không làm bạn mất gì."
          }
        }
      }
    },
    "You hold %lld of the %@. Passing one splits a pair, when another tile on this rack costs you nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$lld × %2$@. Gibst du einen davon ab, löst du ein Paar auf, obwohl du stattdessen einen anderen Stein abgeben könntest, ohne etwas zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$lld fichas del %2$@. Pasar una ficha rompería la pareja, aunque podrías pasar otra del atril sin perder nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %1$lld exemplaires du %2$@. En passer un casse une paire, alors qu'une autre tuile du chevalet ne vous coûte rien."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memegang %1$lld ubin %2$@. Mengoper satu memecah pasangan, padahal ubin lain di rak ini tidak merugikanmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có %1$lld quân %2$@. Chuyền một quân sẽ phá đôi bạn đang có, trong khi chuyền một quân khác trên giá sẽ không làm bạn mất gì."
          }
        }
      }
    },
    "You hold %lld of the %@. Passing one turns a kong back into a pung, when another tile on this rack costs you nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$lld × %2$@. Gibst du einen davon ab, wird aus einem Kong wieder ein Pung, obwohl du stattdessen einen anderen Stein abgeben könntest, ohne etwas zu verlieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %1$lld fichas del %2$@. Pasar una ficha reduciría el kong a un pung, aunque podrías pasar otra del atril sin perder nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %1$lld exemplaires du %2$@. En passer un ramène un kong à un pung, alors qu'une autre tuile du chevalet ne vous coûte rien."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu memegang %1$lld ubin %2$@. Mengoper satu mengubah kong kembali jadi pung, padahal ubin lain di rak ini tidak merugikanmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có %1$lld quân %2$@. Chuyền một quân sẽ biến kong thành pung, trong khi chuyền một quân khác trên giá sẽ không làm bạn mất gì."
          }
        }
      }
    },
