{
  "sourceLanguage": "en",
  "strings": {
    "NSUserTrackingUsageDescription": {
      "comment": "App Tracking Transparency prompt",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So kann Meta uns sagen, welche Facebook- oder Instagram-Anzeige dich zu Mahj Trainer gebracht hat, damit wir nicht mehr für Anzeigen zahlen, die nichts bringen. Dein Training und dein Fortschritt werden nie geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lets Meta tell us which Facebook or Instagram ad brought you to Mahj Trainer, so we stop paying for ads that don't work. Your practice and progress are never shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así Meta puede decirnos qué anuncio de Facebook o Instagram te trajo a Mahj Trainer, para dejar de pagar por anuncios que no funcionan. Tu práctica y tu progreso nunca se comparten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela permet à Meta de nous indiquer quelle publicité Facebook ou Instagram vous a fait découvrir Mahj Trainer, pour arrêter de payer des publicités qui ne marchent pas. Votre entraînement et vos progrès ne sont jamais partagés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini memungkinkan Meta memberi tahu kami iklan Facebook atau Instagram mana yang membawa kamu ke Mahj Trainer, agar kami berhenti membayar iklan yang tidak berhasil. Latihan dan kemajuanmu tidak pernah dibagikan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này giúp Meta cho chúng tôi biết quảng cáo Facebook hoặc Instagram nào đã đưa bạn đến Mahj Trainer, để chúng tôi ngừng trả tiền cho quảng cáo không hiệu quả. Quá trình luyện tập và tiến bộ của bạn không bao giờ được chia sẻ."
          }
        }
      }
    }
  },
  "version": "1.0"
}
